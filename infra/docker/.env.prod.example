# Production Environment Configuration
# Copy this file to .env.prod and configure with production values
#
# IMPORTANT: Generate strong, unique random values for all secrets!
# Use: openssl rand -hex 32 for 64-character secrets

# ============================================================================
# Core Application
# ============================================================================
NODE_ENV=production
PORT=3000
SERVERLESS=0

# Default organization ID (used by admin controllers as fallback)
DEFAULT_ORGANIZATION_ID=01911000-0000-7000-8000-000000000001

# Default storefront store slug (multi-store: 'us' or 'uk')
DEFAULT_STORE_SLUG=us

# Logging level (error | warn | info | debug)
LOG_LEVEL=info

# ============================================================================
# Required Secrets — app will fail to boot in production if missing
# ============================================================================
# Generate with: openssl rand -hex 32
CUSTOMER_JWT_SECRET=generate_64_char_hex_secret_here
ORGANIZATION_JWT_SECRET=generate_64_char_hex_secret_here
ADMIN_JWT_SECRET=generate_64_char_hex_secret_here
B2B_JWT_SECRET=generate_64_char_hex_secret_here
SESSION_SECRET=generate_64_char_hex_secret_here

# JWT token expiry
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Payment webhook signature verification
PAYMENT_WEBHOOK_SECRET=generate_secure_webhook_secret

# SCIM API bearer token (for SSO/identity provisioning)
SCIM_BEARER_TOKEN=generate_secure_scim_token

# Integration encryption key (for storing third-party API keys encrypted in DB)
INTEGRATION_ENCRYPTION_KEY=generate_32_byte_encryption_key

# ============================================================================
# Database (PostgreSQL 18)
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=commercefull_prod
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=commercefull_prod

# Alternative: single connection URL
# DATABASE_URL=postgresql://commercefull_prod:password@postgres:5432/commercefull_prod

# ============================================================================
# Redis (required for session storage in production)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0
# Optional: alternative single URL
# REDIS_URL=redis://:password@redis:6379/0
REDIS_SESSION_PREFIX=sess:

# ============================================================================
# CORS and Cookies
# ============================================================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
COOKIE_SECRET=generate_64_char_hex_secret_here
COOKIE_DOMAIN=yourdomain.com

# ============================================================================
# Edge / Network Security
# ============================================================================
# Reverse-proxy hops in front of the app (1 = nginx/Caddy/Traefik). Never "true".
TRUST_PROXY=1
# Optional: have your proxy inject this header value; direct hits are rejected
# ORIGIN_VERIFY_SECRET=generate_64_char_hex_secret_here
# ORIGIN_VERIFY_HEADER=x-origin-verify
# RATE_LIMIT_GLOBAL_PER_MINUTE=600
# RATE_LIMIT_AUTH_PER_15_MINUTES=20
# Set POSTGRES_SSL=true when using a managed/remote database
# POSTGRES_SSL=true

# ============================================================================
# File Storage
# ============================================================================
# Storage backend: local | s3 | gcs | azure
STORAGE_TYPE=local
# For local storage:
STORAGE_LOCAL_DIR=uploads
STORAGE_LOCAL_URL=https://yourdomain.com/uploads

# Optional: AWS S3 for file storage
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ============================================================================
# Optional: GraphQL Configuration
# ============================================================================
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_MAX_COMPLEXITY=1000
# GRAPHQL_PERSISTED_QUERIES=false
# GRAPHQL_PERSISTED_QUERIES_FILE=./persisted-queries.json

# ============================================================================
# Optional: Feature Flags
# ============================================================================
# MODULE_INDEPENDENT_ENABLED=true
# MODULE_MARKETPLACE_ENABLED=false

# ============================================================================
# Optional: Search Backend
# ============================================================================
# SEARCH_BACKEND=postgres
# SEARCH_STRATEGY=trigram

# ============================================================================
# Optional: SSO / OAuth Providers
# ============================================================================
# GOOGLE_CLIENT_ID=your_google_client_id
# GITHUB_CLIENT_ID=your_github_client_id
# MICROSOFT_CLIENT_ID=your_microsoft_client_id
# APPLE_CLIENT_ID=your_apple_client_id
# FACEBOOK_APP_ID=your_facebook_app_id
# TWITTER_CLIENT_ID=your_twitter_client_id
# LINKEDIN_CLIENT_ID=your_linkedin_client_id

# ============================================================================
# Optional: Monitoring
# ============================================================================
# SENTRY_DSN=your_sentry_dsn_for_error_tracking

# ============================================================================
# Optional: Background Jobs
# ============================================================================
# OUTBOX_DISABLED=0
# CRON_DISABLED=0
