# Nginx Configuration for {{ app_name }}
# Node.js {{ nodejs_version }} + PostgreSQL {{ postgres_version }} Stack
# Managed by Ansible - Do not edit manually

worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    # Basic Settings
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time uct="$upstream_connect_time" '
                    'uht="$upstream_header_time" urt="$upstream_response_time"';
    access_log /var/log/nginx/access.log main;

    # Performance
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    # SECURITY: Slowloris / oversized-header protection
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;
    large_client_header_buffers 4 16k;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml application/xml+rss text/javascript application/x-font-ttf
               font/opentype image/svg+xml;

    # SECURITY: Security headers. NOTE: nginx only inherits add_header from the
    # parent level when the current level defines none, so headers are declared
    # per server/location below. CSP, X-Frame-Options, nosniff, Referrer-Policy
    # for proxied responses come from the app (helmet) — not duplicated here.

    # WebSocket connection upgrade mapping
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Rate Limiting
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate={{ nginx_rate_limit }};
    # SECURITY: strict budget for credential endpoints (brute force / credential stuffing)
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate={{ nginx_auth_rate_limit }};
    # SECURITY: global per-IP budget for everything else
    limit_req_zone $binary_remote_addr zone=global_limit:20m rate={{ nginx_global_rate_limit }};
    limit_conn_zone $binary_remote_addr zone=conn_limit:10m;
    limit_req_status 429;
    limit_conn_status 429;

    # Upstream for Node.js application
    upstream nodejs_app {
        server 127.0.0.1:{{ app_port }};
        keepalive 64;
    }

    # SECURITY: Reject requests for unknown Host headers (host header injection,
    # direct-IP scanning, DNS rebinding)
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        return 444;
    }

    # HTTP → HTTPS Redirect
    server {
        listen 80;
        listen [::]:80;
        server_name {{ domain_name }} www.{{ domain_name }};

        # Allow ACME challenges for Let's Encrypt
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Redirect all other traffic to HTTPS
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS Server Block
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name {{ domain_name }} www.{{ domain_name }};

        # SSL Configuration
        ssl_certificate {{ ssl_cert_path }};
        ssl_certificate_key {{ ssl_key_path }};
        ssl_session_timeout 1d;
        ssl_session_cache shared:SSL:50m;
        ssl_session_tickets off;

        # Modern SSL Configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;

        # OCSP stapling
        ssl_stapling on;
        ssl_stapling_verify on;

        # SECURITY: HSTS enabled to prevent SSL stripping attacks (single source of truth;
        # the app's copy is hidden to avoid duplicate/conflicting headers)
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Powered-By;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        # SECURITY: reject unknown Host headers on TLS as well (this block is the 443 default)
        if ($host !~* ^(www\.)?{{ domain_name | regex_escape }}$) {
            return 444;
        }

        # Client body size (for file uploads)
        client_max_body_size {{ nginx_client_max_body_size }};

        # SECURITY: credential endpoints — strict rate limit
        location ~ ^/(signin|signup|admin/login|customer/identity/(login|register|token|refresh|forgot-password|reset-password)|business/auth/(login|register|token|refresh|validate|forgot-password|reset-password))$ {
            limit_req zone=auth_limit burst={{ nginx_auth_rate_limit_burst }} nodelay;
            limit_conn conn_limit 10;

            proxy_pass http://nodejs_app;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Test-Database "";
        }

        # Admin panel with rate limiting
        location /admin/ {
            limit_req zone=api_limit burst={{ nginx_rate_limit_burst }} nodelay;
            limit_conn conn_limit 10;

            proxy_pass http://nodejs_app;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # SECURITY: clients must never select the database (see libs/db/testDbContext.ts)
            proxy_set_header X-Test-Database "";
            proxy_cache_bypass $http_upgrade;

            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Main application
        location / {
            limit_req zone=global_limit burst={{ nginx_global_rate_limit_burst }} nodelay;
            limit_conn conn_limit 50;

            proxy_pass http://nodejs_app;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # SECURITY: clients must never select the database (see libs/db/testDbContext.ts)
            proxy_set_header X-Test-Database "";
            proxy_cache_bypass $http_upgrade;

            # Timeouts
            proxy_connect_timeout 60s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
        }

        # Static files with caching
        location /public/ {
            alias {{ current_link }}/public/;
            expires 30d;
            access_log off;
            # NOTE: add_header in a location block overrides parent headers,
            # so we must re-declare security headers here
            add_header Cache-Control "public, immutable";
            add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header X-Content-Type-Options "nosniff" always;
            # SECURITY: user uploads are served from here — never allow them to run scripts
            add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; sandbox" always;
            gzip_static on;
        }

        # Health check endpoint (no logging)
        location /health {
            access_log off;
            proxy_pass http://nodejs_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Test-Database "";
        }

        # Error pages
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root {{ current_link }}/public/;
            internal;
        }

        # Internal documentation is not public in production
        location ^~ /docs {
            return 404;
        }

        # Deny access to hidden files (but keep ACME challenges working)
        location ~ /\.(?!well-known/) {
            deny all;
            access_log off;
            log_not_found off;
        }
    }
}
