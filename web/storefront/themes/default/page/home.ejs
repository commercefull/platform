<%- include("../partials/header") %>

<main class="min-h-screen">
  <!-- Hero Carousel -->
  <section class="hero-gradient text-white relative overflow-hidden" data-hero-carousel>
    <!-- Slide 1 -->
    <div class="hero-slide transition-opacity duration-700" data-hero-slide>
      <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6 animate-fade-in">
            <div>
              <p class="text-gold-500 text-sm font-medium uppercase tracking-widest mb-4">Autumn / Winter 2026</p>
              <h1 class="text-4xl lg:text-6xl font-bold leading-tight" style="font-family: 'Playfair Display', serif;">
                Timeless Fashion<br>
                <span class="text-gold-500">For Every Occasion</span>
              </h1>
              <p class="text-lg text-gray-300 mt-6 max-w-lg">
                Discover premium brands and curated collections. From tailored essentials to statement pieces, find your perfect style.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/products" class="btn-accent inline-flex items-center justify-center">
                Shop Collection
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
              <a href="/brands" class="btn-secondary inline-flex items-center justify-center">
                Explore Brands
              </a>
            </div>
          </div>
          <div class="hidden lg:block">
            <div class="aspect-[4/5] bg-gray-800 rounded-lg overflow-hidden">
              <div class="w-full h-full flex items-center justify-center text-gray-600">
                <svg class="w-32 h-32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="hero-slide transition-opacity duration-700 opacity-0 absolute inset-0" data-hero-slide>
      <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div>
              <p class="text-gold-500 text-sm font-medium uppercase tracking-widest mb-4">New Season</p>
              <h1 class="text-4xl lg:text-6xl font-bold leading-tight" style="font-family: 'Playfair Display', serif;">
                Premium Denim<br>
                <span class="text-gold-500">Crafted to Last</span>
              </h1>
              <p class="text-lg text-gray-300 mt-6 max-w-lg">
                Selvedge and raw denim from specialist brands. Built to wear in, not out.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/products/category/jeans" class="btn-accent inline-flex items-center justify-center">Shop Denim</a>
              <a href="/brands" class="btn-secondary inline-flex items-center justify-center">View Brands</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="hero-slide transition-opacity duration-700 opacity-0 absolute inset-0" data-hero-slide>
      <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-6">
            <div>
              <p class="text-gold-500 text-sm font-medium uppercase tracking-widest mb-4">Limited Time</p>
              <h1 class="text-4xl lg:text-6xl font-bold leading-tight" style="font-family: 'Playfair Display', serif;">
                Mid-Season Sale<br>
                <span class="text-gold-500">Up to 50% Off</span>
              </h1>
              <p class="text-lg text-gray-300 mt-6 max-w-lg">
                Selected styles across men's, women's, and accessories. Limited stock available.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/search?q=sale" class="btn-accent inline-flex items-center justify-center">Shop Sale</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Carousel Controls -->
    <button type="button" data-action="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/20 hover:bg-white/30 rounded-full flex items-center justify-center transition-colors" aria-label="Previous slide">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
    </button>
    <button type="button" data-action="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/20 hover:bg-white/30 rounded-full flex items-center justify-center transition-colors" aria-label="Next slide">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </button>

    <!-- Dots -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2">
      <button type="button" data-action="hero-dot" data-hero-dot="0" class="w-2 h-2 rounded-full bg-ink-900 transition-colors" aria-label="Go to slide 1"></button>
      <button type="button" data-action="hero-dot" data-hero-dot="1" class="w-2 h-2 rounded-full bg-gray-300 transition-colors" aria-label="Go to slide 2"></button>
      <button type="button" data-action="hero-dot" data-hero-dot="2" class="w-2 h-2 rounded-full bg-gray-300 transition-colors" aria-label="Go to slide 3"></button>
    </div>
  </section>

  <!-- Trust Indicators -->
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="flex items-center gap-3">
          <svg class="w-8 h-8 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-ink-900">Secure Payment</p>
            <p class="text-xs text-gray-500">256-bit SSL encryption</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-8 h-8 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-ink-900">Free Returns</p>
            <p class="text-xs text-gray-500">Within 30 days</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-8 h-8 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-ink-900">Premium Brands</p>
            <p class="text-xs text-gray-500">Curated selection</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-8 h-8 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-ink-900">Fast Delivery</p>
            <p class="text-xs text-gray-500">Next day available</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Tiles -->
  <section class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-ink-900 mb-2" style="font-family: 'Playfair Display', serif;">Shop by Category</h2>
      <p class="text-gray-500">Find exactly what you're looking for</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      <a href="/products/category/mens-shirts" class="group relative aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 to-transparent z-10"></div>
        <div class="w-full h-full flex items-center justify-center text-gray-400 group-hover:scale-105 transition-transform duration-500">
          <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
        <div class="absolute bottom-4 left-4 z-20">
          <h3 class="text-white text-lg font-semibold" style="font-family: 'Playfair Display', serif;">Men</h3>
          <p class="text-gray-200 text-xs">Shop now →</p>
        </div>
      </a>
      <a href="/products/category/womens-dresses" class="group relative aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 to-transparent z-10"></div>
        <div class="w-full h-full flex items-center justify-center text-gray-400 group-hover:scale-105 transition-transform duration-500">
          <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
        <div class="absolute bottom-4 left-4 z-20">
          <h3 class="text-white text-lg font-semibold" style="font-family: 'Playfair Display', serif;">Women</h3>
          <p class="text-gray-200 text-xs">Shop now →</p>
        </div>
      </a>
      <a href="/products/category/bags" class="group relative aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 to-transparent z-10"></div>
        <div class="w-full h-full flex items-center justify-center text-gray-400 group-hover:scale-105 transition-transform duration-500">
          <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
        <div class="absolute bottom-4 left-4 z-20">
          <h3 class="text-white text-lg font-semibold" style="font-family: 'Playfair Display', serif;">Accessories</h3>
          <p class="text-gray-200 text-xs">Shop now →</p>
        </div>
      </a>
      <a href="/products/category/sneakers" class="group relative aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 to-transparent z-10"></div>
        <div class="w-full h-full flex items-center justify-center text-gray-400 group-hover:scale-105 transition-transform duration-500">
          <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
        <div class="absolute bottom-4 left-4 z-20">
          <h3 class="text-white text-lg font-semibold" style="font-family: 'Playfair Display', serif;">Footwear</h3>
          <p class="text-gray-200 text-xs">Shop now →</p>
        </div>
      </a>
      <a href="/brands" class="group relative aspect-[3/4] bg-gold-500 rounded-lg overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-t from-gold-600/80 to-transparent z-10"></div>
        <div class="absolute bottom-4 left-4 z-20">
          <h3 class="text-white text-lg font-semibold" style="font-family: 'Playfair Display', serif;">All Brands</h3>
          <p class="text-gray-100 text-xs">Discover →</p>
        </div>
      </a>
    </div>
  </section>

  <!-- New Arrivals Carousel -->
  <section class="bg-gray-100 py-16" data-product-carousel>
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h2 class="text-3xl font-bold text-ink-900" style="font-family: 'Playfair Display', serif;">New Arrivals</h2>
          <p class="text-gray-500 mt-1">Fresh styles just landed</p>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" data-action="carousel-prev" class="p-2 border border-gray-300 rounded-none bg-white text-ink-900 hover:bg-gray-50 transition-colors" aria-label="Previous products">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </button>
          <button type="button" data-action="carousel-next" class="p-2 border border-gray-300 rounded-none bg-white text-ink-900 hover:bg-gray-50 transition-colors" aria-label="Next products">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </button>
          <a href="/products" class="ml-4 text-ink-700 hover:text-gold-600 font-medium text-sm">View All →</a>
        </div>
      </div>
      <div class="flex gap-6 overflow-x-auto scroll-smooth pb-2" data-carousel-track>
        <% if (products && products.length > 0) { %>
          <% products.slice(0, 8).forEach(function(product) { %>
            <div class="flex-shrink-0 w-64">
              <%- include("../partials/product-card", { product: product }) %>
            </div>
          <% }); %>
        <% } else { %>
          <div class="w-full text-center py-12 text-gray-400">Products will appear here once seeded.</div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Brands Strip -->
  <section class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-ink-900 mb-2" style="font-family: 'Playfair Display', serif;">Our Brands</h2>
      <p class="text-gray-500">Premium fashion from the world's finest brands</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-6">
      <% const brandNames = ['Northwind', 'Coastline', 'Atlas', 'Verona', 'Meridian', 'Foxglove', 'Stride', 'Lumina']; %>
      <% brandNames.forEach(function(name) { %>
      <a href="/brands" class="flex items-center justify-center h-20 bg-gray-50 border border-gray-200 rounded-lg hover:border-gold-500 hover:bg-white transition-all">
        <span class="text-lg font-semibold text-gray-400 hover:text-gold-600 transition-colors" style="font-family: 'Playfair Display', serif;"><%= name %></span>
      </a>
      <% }); %>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-ink-900 text-white">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h2 class="text-4xl font-bold mb-4" style="font-family: 'Playfair Display', serif;">Join the CommerceFull Family</h2>
      <p class="text-gray-400 max-w-2xl mx-auto mb-8">Sign up today and enjoy exclusive member benefits, early access to new collections, and special offers.</p>
      <a href="/signup" class="btn-accent inline-block">Create Account</a>
    </div>
  </section>
</main>

<%- include("../partials/footer") %>
