<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <div class="mx-auto h-16 w-16 bg-blue-600 rounded-full flex items-center justify-center mb-6">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= t('shared:common.frequentlyAskedQuestions') %></h1>
      <p class="text-lg text-gray-600"><%= t('storefront:faqDesc') %></p>
    </div>

    <!-- Search Bar -->
    <div class="mb-8">
      <div class="max-w-md mx-auto">
        <div class="relative">
          <svg class="absolute left-3 top-3 h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            placeholder="<%= t('storefront:searchFaqs') %>"
            class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            id="faqSearch"
          >
        </div>
      </div>
    </div>

    <!-- FAQ Categories -->
    <div class="flex flex-wrap justify-center gap-4 mb-8" id="faqCategories">
      <button class="px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-medium hover:bg-blue-700 transition-colors" data-category="all">
        <%= t('storefront:allQuestions') %>
      </button>
      <button class="px-4 py-2 bg-gray-200 text-gray-700 rounded-full text-sm font-medium hover:bg-gray-300 transition-colors" data-category="orders">
        <%= t('storefront:ordersPayment') %>
      </button>
      <button class="px-4 py-2 bg-gray-200 text-gray-700 rounded-full text-sm font-medium hover:bg-gray-300 transition-colors" data-category="shipping">
        <%= t('storefront:shippingDelivery') %>
      </button>
      <button class="px-4 py-2 bg-gray-200 text-gray-700 rounded-full text-sm font-medium hover:bg-gray-300 transition-colors" data-category="returns">
        <%= t('storefront:returnsExchanges') %>
      </button>
      <button class="px-4 py-2 bg-gray-200 text-gray-700 rounded-full text-sm font-medium hover:bg-gray-300 transition-colors" data-category="products">
        <%= t('storefront:productsCare') %>
      </button>
      <button class="px-4 py-2 bg-gray-200 text-gray-700 rounded-full text-sm font-medium hover:bg-gray-300 transition-colors" data-category="account">
        <%= t('storefront:accountSupport') %>
      </button>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4" id="faqContent">

      <!-- Orders & Payment -->
      <div class="faq-item" data-category="orders">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqPaymentMethodsQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqPaymentMethodsA') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="orders">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqProcessingTimeQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqProcessingTimeA') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="orders">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqModifyCancelQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqModifyCancelA') %></p>
          </div>
        </div>
      </div>

      <!-- Shipping & Delivery -->
      <div class="faq-item" data-category="shipping">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqShippingOptionsQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed mb-4"><%= t('storefront:faqShippingOptionsA') %></p>
            <ul class="list-disc list-inside text-gray-700 space-y-2">
              <li><strong><%= t('storefront:faqStandardShipping') %></strong> <%= t('storefront:faqStandardShippingCost') %></li>
              <li><strong><%= t('storefront:faqExpressShipping') %></strong> <%= t('storefront:faqExpressShippingCost') %></li>
              <li><strong><%= t('storefront:faqOvernightShipping') %></strong> <%= t('storefront:faqOvernightShippingCost') %></li>
              <li><strong><%= t('storefront:faqInternationalShipping') %></strong> <%= t('storefront:faqInternationalShippingCost') %></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="shipping">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqInternationalQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqInternationalA') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="shipping">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqTrackOrderQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqTrackOrderA') %></p>
            <ul class="list-disc list-inside text-gray-700 space-y-2 mt-2">
              <li><%= t('storefront:faqTrackOrderA1') %></li>
              <li><%= t('storefront:faqTrackOrderA2') %></li>
              <li><%= t('storefront:faqTrackOrderA3') %></li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Returns & Exchanges -->
      <div class="faq-item" data-category="returns">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqReturnPolicyQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqReturnPolicyA') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="returns">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqInitiateReturnQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqInitiateReturnA') %></p>
            <ol class="list-decimal list-inside text-gray-700 space-y-2 mt-2">
              <li><%= t('storefront:faqInitiateReturnA1') %></li>
              <li><%= t('storefront:faqInitiateReturnA2') %></li>
              <li><%= t('storefront:faqInitiateReturnA3') %></li>
              <li><%= t('storefront:faqInitiateReturnA4') %></li>
              <li><%= t('storefront:faqInitiateReturnA5') %></li>
            </ol>
          </div>
        </div>
      </div>

      <!-- Products & Care -->
      <div class="faq-item" data-category="products">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqWarrantyQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqWarrantyA') %></p>
            <ul class="list-disc list-inside text-gray-700 space-y-2 mt-2">
              <li><strong><%= t('storefront:faqWarrantyElectronics') %></strong> <%= t('storefront:faqWarrantyElectronicsPeriod') %></li>
              <li><strong><%= t('storefront:faqWarrantyClothing') %></strong> <%= t('storefront:faqWarrantyClothingPeriod') %></li>
              <li><strong><%= t('storefront:faqWarrantyHomeGoods') %></strong> <%= t('storefront:faqWarrantyHomeGoodsPeriod') %></li>
              <li><strong><%= t('storefront:faqWarrantySports') %></strong> <%= t('storefront:faqWarrantySportsPeriod') %></li>
            </ul>
            <p class="text-gray-700 leading-relaxed mt-4"><%= t('storefront:faqWarrantyNote') %></p>
          </div>
        </div>
      </div>

      <!-- Account & Support -->
      <div class="faq-item" data-category="account">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqCreateAccountQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqCreateAccountA') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="account">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqResetPasswordQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqResetPasswordA') %></p>
          </div>
        </div>
      </div>

      <div class="faq-item" data-category="account">
        <div class="bg-white shadow-lg rounded-xl overflow-hidden">
          <button class="faq-toggle w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 transition-colors">
            <h3 class="text-lg font-semibold text-gray-900"><%= t('storefront:faqContactSupportQ') %></h3>
            <svg class="w-5 h-5 text-gray-500 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content hidden px-6 pb-4">
            <p class="text-gray-700 leading-relaxed"><%= t('storefront:faqContactSupportA') %></p>
            <ul class="list-disc list-inside text-gray-700 space-y-2 mt-2">
              <li><strong><%= t('shared:common.email2') %></strong> <%= t('storefront:faqContactEmailValue') %></li>
              <li><strong><%= t('shared:common.phone2') %></strong> <%= t('storefront:faqContactPhoneValue') %></li>
              <li><strong><%= t('storefront:faqContactLiveChat') %></strong> <%= t('storefront:faqContactLiveChatValue') %></li>
              <li><strong><%= t('storefront:faqContactForm') %></strong> <%= t('storefront:faqContactFormValue') %></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Support Section -->
    <div class="mt-12 text-center">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl p-8 text-white">
        <h2 class="text-2xl font-bold mb-4"><%= t('storefront:stillNeedHelp') %></h2>
        <p class="text-blue-100 mb-6"><%= t('storefront:stillNeedHelpDesc') %></p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact-form"
            class="inline-flex items-center px-6 py-3 border border-white text-white rounded-lg hover:bg-white hover:text-blue-600 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <%= t('storefront:contactSupport') %>
          </a>
          <a
            href="/contact-us"
            class="inline-flex items-center px-6 py-3 bg-white text-blue-600 rounded-lg hover:bg-blue-50 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <%= t('storefront:callUs') %>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="/javascripts/storefront/faq.js"></script>

<%- include("../partials/footer") %>
