<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <div class="mx-auto h-16 w-16 bg-green-600 rounded-full flex items-center justify-center mb-6">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= t('storefront:returnsExchangesTitle') %></h1>
      <p class="text-lg text-gray-600"><%= t('storefront:returnsExchangesIntro') %></p>
    </div>

    <!-- Policy Overview -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-8">
      <div class="bg-gradient-to-r from-green-600 to-teal-600 px-6 py-4">
        <h2 class="text-xl font-semibold text-white flex items-center">
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <%= t('storefront:ourReturnPolicy') %>
        </h2>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="mx-auto h-12 w-12 bg-green-100 rounded-full flex items-center justify-center mb-4">
              <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= t('storefront:thirtyDayReturns') %></h3>
            <p class="text-gray-600"><%= t('storefront:thirtyDayReturnsDesc') %></p>
          </div>

          <div class="text-center">
            <div class="mx-auto h-12 w-12 bg-blue-100 rounded-full flex items-center justify-center mb-4">
              <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= t('storefront:freeReturnShipping') %></h3>
            <p class="text-gray-600"><%= t('storefront:freeReturnShippingDesc') %></p>
          </div>

          <div class="text-center">
            <div class="mx-auto h-12 w-12 bg-purple-100 rounded-full flex items-center justify-center mb-4">
              <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= t('storefront:easyExchanges') %></h3>
            <p class="text-gray-600"><%= t('storefront:easyExchangesDesc') %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Eligibility Section -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('storefront:returnEligibility') %></h2>
      </div>
      <div class="p-6">
        <div class="space-y-4">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-gray-900"><%= t('storefront:itemsWithin30Days') %></h3>
              <p class="text-sm text-gray-600"><%= t('storefront:itemsWithin30DaysDesc') %></p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-gray-900"><%= t('storefront:itemsUnusedOriginal') %></h3>
              <p class="text-sm text-gray-600"><%= t('storefront:itemsUnusedOriginalDesc') %></p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-gray-900"><%= t('storefront:originalReceiptRequired') %></h3>
              <p class="text-sm text-gray-600"><%= t('storefront:originalReceiptDesc') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Non-Returnable Items -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('storefront:nonReturnableItems') %></h2>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-4"><%= t('storefront:nonReturnableDesc') %></p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('storefront:personalizedItems') %>
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('storefront:intimateApparel') %>
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('storefront:clearanceItems') %>
            </li>
          </ul>
          <ul class="space-y-2 text-gray-600">
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('storefront:openedBeauty') %>
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('storefront:foodPerishable') %>
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
              <%= t('storefront:itemsDamagedMisuse') %>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- How to Return -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('storefront:howToInitiateReturn') %></h2>
      </div>
      <div class="p-6">
        <div class="space-y-6">
          <div class="flex items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">1</span>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900"><%= t('storefront:contactOurTeam') %></h3>
              <p class="text-gray-600"><%= t('storefront:contactOurTeamDesc') %></p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">2</span>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900"><%= t('storefront:receiveReturnAuth') %></h3>
              <p class="text-gray-600"><%= t('storefront:receiveReturnAuthDesc') %></p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">3</span>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900"><%= t('storefront:packYourItems') %></h3>
              <p class="text-gray-600"><%= t('storefront:packYourItemsDesc') %></p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex-shrink-0 w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
              <span class="text-white text-sm font-semibold">4</span>
            </div>
            <div class="ml-4">
              <h3 class="text-lg font-medium text-gray-900"><%= t('storefront:shipYourPackage') %></h3>
              <p class="text-gray-600"><%= t('storefront:shipYourPackageDesc') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Refunds & Processing -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('storefront:refundsProcessing') %></h2>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-3"><%= t('storefront:processingTimes') %></h3>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-gray-600"><%= t('storefront:returnReceipt') %></span>
                <span class="font-medium">3-5 business days</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600"><%= t('storefront:inspection') %></span>
                <span class="font-medium">1-2 business days</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600"><%= t('storefront:refundProcessing') %></span>
                <span class="font-medium">3-5 business days</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600"><%= t('storefront:bankDeposit') %></span>
                <span class="font-medium">2-7 business days</span>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-lg font-medium text-gray-900 mb-3"><%= t('storefront:refundMethods') %></h3>
            <div class="space-y-3">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-600"><%= t('storefront:originalPaymentMethod') %></span>
              </div>
              <div class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-600"><%= t('storefront:storeCredit') %></span>
              </div>
              <div class="flex items-center">
                <svg class="h-5 w-5 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-600"><%= t('storefront:exchangeDifferentItem') %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Exchanges Section -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden mb-8">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('storefront:exchanges') %></h2>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-4"><%= t('storefront:exchangesDesc') %></p>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
          <div class="flex">
            <svg class="h-5 w-5 text-blue-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h3 class="text-sm font-medium text-blue-900"><%= t('storefront:exchangeShipping') %></h3>
              <p class="text-sm text-blue-800"><%= t('storefront:exchangeShippingDesc') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Section -->
    <div class="text-center">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl p-8 text-white">
        <h2 class="text-2xl font-bold mb-4"><%= t('storefront:needHelpReturn') %></h2>
        <p class="text-blue-100 mb-6"><%= t('storefront:needHelpReturnDesc') %></p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact-form"
            class="inline-flex items-center px-6 py-3 border border-white text-white rounded-lg hover:bg-white hover:text-blue-600 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <%= t('storefront:startReturnProcess') %>
          </a>
          <a
            href="tel:+1234567890"
            class="inline-flex items-center px-6 py-3 bg-white text-blue-600 rounded-lg hover:bg-blue-50 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <%= t('storefront:callCustomerService') %>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
