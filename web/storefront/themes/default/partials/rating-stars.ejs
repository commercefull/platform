<%
  /**
   * Rating Stars Partial — Displays star rating
   *
   * Usage:
   *   <%- include("../partials/rating-stars", { rating: 4.5, count: 128 }) %>
   *
   * Props:
   *   rating: number — 0 to 5
   *   count?: number — number of reviews
   *   size?: string — 'sm' | 'md' | 'lg' (default: 'sm')
   */
%>
<%
  const sizeClass = (typeof size !== 'undefined' && size === 'lg') ? 'w-6 h-6' : (typeof size !== 'undefined' && size === 'md') ? 'w-5 h-5' : 'w-4 h-4';
  const fullStars = Math.floor(rating);
  const hasHalf = rating % 1 >= 0.25 && rating % 1 < 0.75;
  const halfStar = hasHalf ? 1 : 0;
  const emptyStars = 5 - fullStars - halfStar;
%>
<div class="flex items-center gap-1">
  <div class="flex items-center">
    <% for (let i = 0; i < fullStars; i++) { %>
    <svg class="<%= sizeClass %> text-gold-500" fill="currentColor" viewBox="0 0 20 20">
      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
    </svg>
    <% } %>
    <% if (halfStar) { %>
    <svg class="<%= sizeClass %> text-gold-500" fill="currentColor" viewBox="0 0 20 20">
      <path clip-rule="evenodd" fill-rule="evenodd" d="M10 2a1 1 0 011 1v12a1 1 0 01-1 1H3a1 1 0 01-.8-1.6L9 3.4V3a1 1 0 011-1z"></path>
    </svg>
    <% } %>
    <% for (let i = 0; i < emptyStars; i++) { %>
    <svg class="<%= sizeClass %> text-gray-300" fill="currentColor" viewBox="0 0 20 20">
      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
    </svg>
    <% } %>
  </div>
  <% if (typeof count !== 'undefined' && count !== null) { %>
  <span class="text-xs text-gray-500">(<%= count %>)</span>
  <% } %>
</div>
