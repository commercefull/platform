<%
  /**
   * Product Card Partial — Reusable product card for grids
   *
   * Usage:
   *   include("../partials/product-card", { product: p })
   *
   * Props:
   *   product: ProductListItemResponse
   */
%>
<%
  // formatPrice / formatCents are provided by storefrontRespond (libs/money).
  // Prices arrive as integer cents — format at the view boundary.
  const cur = (typeof currency !== 'undefined' ? currency : 'USD') || 'USD';
  const loc = (typeof locale !== 'undefined' ? locale : 'en-US') || 'en-US';
  const isOnSale = product.isOnSale || (product.salePriceCents !== null && product.salePriceCents !== undefined && product.basePriceCents > product.salePriceCents);
  const displayPriceCents = product.effectivePriceCents ?? product.salePriceCents ?? product.basePriceCents ?? 0;
  const compareAtCents = isOnSale ? product.basePriceCents : null;
%>
<div class="product-card group">
  <a href="/products/<%= product.slug %>/<%= product.productId %>" class="block">
    <!-- Image -->
    <div class="aspect-[3/4] bg-gray-100 overflow-hidden relative">
      <% if (product.primaryImageUrl) { %>
      <img src="<%= product.primaryImageUrl %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" width="400" height="533">
      <% } else { %>
      <div class="w-full h-full flex items-center justify-center text-gray-300">
        <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <% } %>
      <!-- Badges -->
      <div class="absolute top-3 left-3 flex flex-col gap-1">
        <% if (isOnSale) { %>
        <span class="bg-red-600 text-white text-xs font-semibold px-2 py-1 rounded">SALE</span>
        <% } %>
        <% if (product.isFeatured) { %>
        <span class="bg-ink-900 text-white text-xs font-semibold px-2 py-1 rounded">FEATURED</span>
        <% } %>
      </div>
      <!-- Wishlist button -->
      <button type="button" class="absolute top-3 right-3 w-8 h-8 bg-white/90 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white" data-action="wishlist-add" data-product-id="<%= product.productId %>" aria-label="Add to wishlist">
        <svg class="w-4 h-4 text-ink-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
        </svg>
      </button>
      <!-- Quick view button -->
      <button type="button" class="absolute bottom-3 left-3 right-3 py-2 bg-white/95 text-ink-900 text-xs font-medium rounded opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white" data-action="quick-view" data-product-id="<%= product.productId %>" aria-label="Quick view">
        Quick View
      </button>
    </div>
    <!-- Info -->
    <div class="p-4">
      <h3 class="font-medium text-ink-900 group-hover:text-gold-600 transition-colors line-clamp-1 text-sm"><%= product.name %></h3>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-base font-semibold <%= isOnSale ? 'text-red-600' : 'text-ink-900' %>"><%= formatCents(displayPriceCents, cur, loc) %></span>
        <% if (compareAtCents) { %>
        <span class="text-sm text-gray-400 line-through"><%= formatCents(compareAtCents, cur, loc) %></span>
        <% } %>
      </div>
    </div>
  </a>
</div>
