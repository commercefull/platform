<!DOCTYPE html>
<html lang="<%= (typeof locale !== 'undefined' ? locale : 'en-US') || 'en-US' %>">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <% if (pageName) { %>
    <title><%= pageName %> | CommerceFull</title>
    <%} else {%>
    <title>CommerceFull — Premium Multi-Brand Fashion</title>
    <% } %>

    <!-- SEO Meta -->
    <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Discover premium multi-brand fashion at CommerceFull. Shop curated collections from top designers with free shipping and easy returns.' %>">
    <meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' && metaKeywords ? metaKeywords : 'fashion, premium clothing, designer brands, menswear, womenswear, accessories, footwear' %>">
    <meta name="robots" content="<%= typeof metaRobots !== 'undefined' && metaRobots ? metaRobots : 'index, follow' %>">
    <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : '' %>">

    <!-- Open Graph -->
    <meta property="og:site_name" content="CommerceFull">
    <meta property="og:title" content="<%= pageName || 'CommerceFull — Premium Multi-Brand Fashion' %>">
    <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Discover premium multi-brand fashion at CommerceFull.' %>">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
    <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : '' %>">
    <% if (typeof ogImage !== 'undefined' && ogImage) { %>
    <meta property="og:image" content="<%= ogImage %>">
    <% } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="<%= typeof twitterCard !== 'undefined' && twitterCard ? twitterCard : 'summary_large_image' %>">
    <meta name="twitter:title" content="<%= pageName || 'CommerceFull — Premium Multi-Brand Fashion' %>">
    <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Discover premium multi-brand fashion at CommerceFull.' %>">

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/stylesheets/storefront/compiled.css">

    <!-- Fonts: Inter (body) + Playfair Display (headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>

  <body class="bg-gray-50">
    <!-- Announcement Bar -->
    <%- include("../partials/announcement-bar") %>

    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          <!-- Left: Logo + Nav -->
          <div class="flex items-center space-x-10">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-2">
              <% if (typeof themeCustomLogoUrl !== 'undefined' && themeCustomLogoUrl) { %>
              <img src="<%= themeCustomLogoUrl %>" alt="CommerceFull" class="h-8 w-auto">
              <% } else { %>
              <span class="text-2xl font-bold text-ink-900" style="font-family: 'Playfair Display', serif;">CommerceFull</span>
              <% } %>
            </a>

            <!-- Mega Navigation -->
            <div class="hidden lg:flex items-center space-x-8">
              <!-- Shop Dropdown -->
              <div class="relative group">
                <button type="button" class="flex items-center space-x-1 text-ink-700 hover:text-gold-600 transition-colors font-medium text-sm uppercase tracking-wide">
                  <span>Shop</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>

                <!-- Mega Menu -->
                <div class="absolute left-0 top-full mt-0 w-screen max-w-4xl bg-white border border-gray-200 shadow-xl z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                  <div class="p-8">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                      <!-- Men -->
                      <div>
                        <h3 class="text-xs font-semibold text-ink-900 uppercase tracking-wider mb-4">Men</h3>
                        <ul class="space-y-2">
                          <li><a href="/products/category/mens-shirts" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Shirts</a></li>
                          <li><a href="/products/category/mens-tshirts" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">T-Shirts</a></li>
                          <li><a href="/products/category/mens-jeans" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Jeans</a></li>
                          <li><a href="/products/category/mens-trousers" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Trousers</a></li>
                          <li><a href="/products/category/mens-jackets" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Jackets</a></li>
                          <li><a href="/products/category/mens-knitwear" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Knitwear</a></li>
                        </ul>
                      </div>
                      <!-- Women -->
                      <div>
                        <h3 class="text-xs font-semibold text-ink-900 uppercase tracking-wider mb-4">Women</h3>
                        <ul class="space-y-2">
                          <li><a href="/products/category/womens-dresses" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Dresses</a></li>
                          <li><a href="/products/category/womens-tops" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Tops</a></li>
                          <li><a href="/products/category/womens-jeans" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Jeans</a></li>
                          <li><a href="/products/category/womens-skirts" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Skirts</a></li>
                          <li><a href="/products/category/womens-jackets" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Jackets</a></li>
                          <li><a href="/products/category/womens-knitwear" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Knitwear</a></li>
                        </ul>
                      </div>
                      <!-- Accessories -->
                      <div>
                        <h3 class="text-xs font-semibold text-ink-900 uppercase tracking-wider mb-4">Accessories</h3>
                        <ul class="space-y-2">
                          <li><a href="/products/category/bags" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Bags</a></li>
                          <li><a href="/products/category/belts" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Belts</a></li>
                          <li><a href="/products/category/wallets" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Wallets</a></li>
                          <li><a href="/products/category/scarves" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Scarves</a></li>
                          <li><a href="/products/category/hats" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Hats</a></li>
                          <li><a href="/products/category/sunglasses" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Sunglasses</a></li>
                        </ul>
                      </div>
                      <!-- Footwear -->
                      <div>
                        <h3 class="text-xs font-semibold text-ink-900 uppercase tracking-wider mb-4">Footwear</h3>
                        <ul class="space-y-2">
                          <li><a href="/products/category/sneakers" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Sneakers</a></li>
                          <li><a href="/products/category/boots" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Boots</a></li>
                          <li><a href="/products/category/sandals" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Sandals</a></li>
                          <li><a href="/products/category/heels" class="text-sm text-gray-600 hover:text-gold-600 transition-colors">Heels</a></li>
                        </ul>
                      </div>
                    </div>

                    <!-- Featured -->
                    <div class="border-t border-gray-200 mt-6 pt-6 flex items-center justify-between">
                      <div>
                        <h3 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Featured Brands</h3>
                        <p class="text-gray-500 text-sm mt-1">Discover our curated collection of premium brands</p>
                      </div>
                      <a href="/brands" class="btn-primary text-sm">View All Brands</a>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Brands -->
              <a href="/brands" class="text-ink-700 hover:text-gold-600 transition-colors font-medium text-sm uppercase tracking-wide">Brands</a>

              <!-- All Products -->
              <a href="/products" class="text-ink-700 hover:text-gold-600 transition-colors font-medium text-sm uppercase tracking-wide">All Products</a>

              <!-- Sale -->
              <a href="/search?q=sale" class="text-red-600 hover:text-red-700 transition-colors font-medium text-sm uppercase tracking-wide">Sale</a>
            </div>
          </div>

          <!-- Right: Search + Account + Cart -->
          <div class="flex items-center space-x-5">
            <!-- Search -->
            <div class="hidden md:block">
              <form action="/search" method="GET" class="relative">
                <input type="search" name="q" placeholder="Search products..." class="w-48 lg:w-64 pl-10 pr-4 py-2 border border-gray-300 rounded-none focus:ring-1 focus:ring-ink-900 focus:border-ink-900 text-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                  <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
              </form>
            </div>

            <!-- Store / Currency switcher -->
            <% if (typeof storeSlug !== 'undefined' && storeSlug) { %>
            <div class="hidden md:flex items-center gap-2 text-xs text-gray-500">
              <span class="uppercase"><%= storeSlug %></span>
              <span class="text-gray-300">·</span>
              <select data-action="switch-currency" class="bg-transparent border-0 text-xs text-gray-500 cursor-pointer hover:text-ink-900 focus:outline-none focus:ring-0" aria-label="Switch currency">
                <% const currentCurrency = (typeof currency !== 'undefined' ? currency : 'USD') || 'USD'; %>
                <% const availableCurrencies = (typeof storeCurrencies !== 'undefined' && storeCurrencies) ? storeCurrencies : ['USD', 'GBP', 'EUR']; %>
                <% availableCurrencies.forEach(function(cur) { %>
                <option value="<%= cur %>" <%= cur === currentCurrency ? 'selected' : '' %>><%= cur %></option>
                <% }); %>
              </select>
            </div>
            <% } %>

            <!-- Wishlist -->
            <a href="/wishlist" class="text-ink-600 hover:text-gold-600 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </a>

            <!-- Cart -->
            <a href="/basket" class="relative text-ink-600 hover:text-gold-600 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.1 5H19M7 13v8a2 2 0 002 2h10a2 2 0 002-2v-3"></path>
              </svg>
              <% if ((session && session.cart && session.cart.totalQty) || (typeof cartCount !== 'undefined' && cartCount > 0)) { %>
              <span class="absolute -top-2 -right-2 bg-gold-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center font-medium">
                <%= (session && session.cart && session.cart.totalQty) ? session.cart.totalQty : cartCount %>
              </span>
              <% } %>
            </a>

            <!-- User Menu -->
            <% if (user) { %>
            <div class="relative group">
              <button type="button" class="flex items-center text-ink-600 hover:text-gold-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </button>
              <div class="absolute right-0 top-full mt-0 w-48 bg-white border border-gray-200 shadow-lg py-2 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gold-600">My Account</a>
                <a href="/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gold-600">My Orders</a>
                <a href="/wishlist" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gold-600">Wishlist</a>
                <a href="/addresses" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gold-600">Addresses</a>
                <div class="border-t border-gray-100 my-1"></div>
                <form action="/signout" method="POST">
                  <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gold-600">Sign Out</button>
                </form>
              </div>
            </div>
            <% } else { %>
            <div class="flex items-center space-x-3">
              <a href="/signin" class="text-ink-600 hover:text-gold-600 transition-colors text-sm font-medium">Sign In</a>
              <a href="/signup" class="btn-primary text-sm py-2 px-4">Sign Up</a>
            </div>
            <% } %>

            <!-- Mobile menu button -->
            <button type="button" class="lg:hidden p-2 text-ink-600" id="mobile-menu-toggle" data-action="open-mobile-menu" aria-label="Open menu">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" data-mobile-menu class="lg:hidden hidden pb-4 border-t border-gray-200 pt-4">
          <form action="/search" method="GET" class="mb-4">
            <div class="relative">
              <input type="search" name="q" placeholder="Search products..." class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-none text-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
            </div>
          </form>
          <div class="space-y-1">
            <a href="/products" class="block py-2 text-ink-700 font-medium text-sm uppercase tracking-wide">All Products</a>
            <a href="/brands" class="block py-2 text-ink-700 font-medium text-sm uppercase tracking-wide">Brands</a>
            <a href="/products/category/mens-shirts" class="block py-2 pl-4 text-sm text-gray-600">Men's Shirts</a>
            <a href="/products/category/womens-dresses" class="block py-2 pl-4 text-sm text-gray-600">Women's Dresses</a>
            <a href="/products/category/bags" class="block py-2 pl-4 text-sm text-gray-600">Bags</a>
            <a href="/products/category/sneakers" class="block py-2 pl-4 text-sm text-gray-600">Sneakers</a>
            <a href="/search?q=sale" class="block py-2 text-red-600 font-medium text-sm uppercase tracking-wide">Sale</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash Messages -->
    <% if (successMsg || errorMsg) { %>
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <% if (successMsg) { %>
      <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded text-sm mb-2">
        <%= successMsg %>
      </div>
      <% } %>
      <% if (errorMsg) { %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded text-sm mb-2">
        <%= errorMsg %>
      </div>
      <% } %>
    </div>
    <% } %>
