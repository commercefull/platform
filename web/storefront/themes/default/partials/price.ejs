<%
  /**
   * Price Partial — Reusable price display component
   *
   * Usage:
   *   include("../partials/price", { price: 49.99, compareAtPrice: 69.99 })
   *
   * Reads currency, locale, and priceDisplayMode from res.locals (set by
   * storeResolutionMiddleware).
   *
   * Props:
   *   price: number — current price
   *   compareAtPrice?: number — original price (for sale items, shown with strikethrough)
   *   showTaxSuffix?: boolean — whether to show "(incl. VAT)" suffix (default: true)
   */
%>
<%
  const cur = (typeof currency !== 'undefined' ? currency : 'USD') || 'USD';
  const loc = (typeof locale !== 'undefined' ? locale : 'en-US') || 'en-US';
  const displayMode = (typeof priceDisplayMode !== 'undefined' ? priceDisplayMode : 'exclusive_tax') || 'exclusive_tax';
  const showSuffix = typeof showTaxSuffix !== 'undefined' ? showTaxSuffix : true;
  const formatPrice = (amt, cur, loc) => new Intl.NumberFormat(loc, { style: 'currency', currency: cur.toUpperCase() }).format(amt);
  const isOnSale = typeof compareAtPrice !== 'undefined' && compareAtPrice !== null && compareAtPrice > price;
%>
<div class="flex items-baseline gap-2">
  <% if (isOnSale) { %>
    <span class="text-lg font-semibold text-red-600"><%= formatPrice(price, cur, loc) %></span>
    <span class="text-sm text-gray-400 line-through"><%= formatPrice(compareAtPrice, cur, loc) %></span>
  <% } else { %>
    <span class="text-lg font-semibold text-gray-900"><%= formatPrice(price, cur, loc) %></span>
  <% } %>
  <% if (showSuffix && displayMode === 'inclusive_tax') { %>
    <span class="text-xs text-gray-500">(incl. VAT)</span>
  <% } %>
</div>
