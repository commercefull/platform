<%
  /**
   * Announcement Bar Partial — Top promo bar
   *
   * Usage:
   *   include("../partials/announcement-bar")
   *
   * Reads from res.locals (set by storeResolutionMiddleware).
   * Shows store-specific announcement based on region.
   */
%>
<%
  const regionCode = (typeof region !== 'undefined' ? region : 'US') || 'US';
  const announcement = regionCode === 'GB'
    ? 'Free UK shipping on orders over £50 — DPD Next Day available'
    : 'Free US shipping on orders over $75 — Free returns within 30 days';
%>
<div class="bg-ink-900 text-white text-center py-2 px-4 text-sm">
  <p><%= announcement %></p>
</div>
