<%
  /**
   * JSON-LD Structured Data partial — renders schema.org structured data.
   *
   * Usage:
   *   include("../partials/json-ld", { schemas: [productSchema, breadcrumbSchema] })
   *   include("../partials/json-ld", { schema: productSchema })
   *
   * Expects:
   *   schema: object — single schema.org JSON object
   *   schemas: object[] — array of schema.org JSON objects (alternative)
   */
%>
<%
  const allSchemas = schemas || (schema ? [schema] : []);
  allSchemas.forEach(function(s) {
%>
<script type="application/ld+json"><%- JSON.stringify(s) %></script>
<% }) %>
