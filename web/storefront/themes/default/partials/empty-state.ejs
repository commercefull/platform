<%
  /**
   * Empty State Partial — Reusable "no results" / "empty" state
   *
   * Usage:
   *   include("../partials/empty-state", { title: 'No products found', message: 'Try adjusting your filters', icon: 'shopping' })
   *
   * Props:
   *   title: string — heading text
   *   message?: string — description text
   *   icon?: string — 'shopping' | 'search' | 'cart' | 'heart' (default: 'shopping')
   *   actionUrl?: string — optional CTA link
   *   actionLabel?: string — optional CTA text
   */
%>
<%
  const iconType = icon || 'shopping';
  const iconPath = {
    shopping: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
    search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    cart: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
    heart: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  }[iconType] || 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z';
%>
<div class="text-center py-20">
  <svg class="w-20 h-20 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="<%= iconPath %>"></path>
  </svg>
  <h3 class="mt-6 text-xl font-medium text-ink-900"><%= title %></h3>
  <% if (message) { %>
  <p class="mt-2 text-gray-500 max-w-md mx-auto"><%= message %></p>
  <% } %>
  <% if (actionUrl && actionLabel) { %>
  <a href="<%= actionUrl %>" class="inline-block mt-6 btn-primary"><%= actionLabel %></a>
  <% } %>
</div>
