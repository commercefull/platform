<%- include("../partials/header") %>

<%
  const formatPrice = (amt) => {
    try { return new Intl.NumberFormat(locale || 'en-US', { style: 'currency', currency: (currency || 'USD').toUpperCase() }).format(parseFloat(amt || 0)); }
    catch { return (currency || 'USD') + ' ' + parseFloat(amt || 0).toFixed(2); }
  };
  const cur = currency || 'USD';
  const loc = locale || 'en-US';
  const isTaxInclusive = (typeof storeContext !== 'undefined' && storeContext?.priceDisplayMode === 'inclusive_tax');
%>

<main class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-8xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <%- include("../partials/breadcrumb", { items: [
        { label: 'Home', url: '/' },
        { label: 'Shopping Cart' }
      ] }) %>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-ink-900" style="font-family: 'Playfair Display', serif;">Shopping Cart</h1>
      <p class="mt-2 text-sm text-gray-500">Review your items before checkout</p>
    </div>

    <% if (basket && basket.items && basket.items.length > 0) { %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Cart Items -->
      <div class="lg:col-span-2 space-y-4">
        <% basket.items.forEach(function(item) { %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden" data-basket-item="<%= item.basketItemId %>">
          <div class="p-6">
            <div class="flex items-start gap-6">
              <!-- Product Image -->
              <div class="w-24 h-32 bg-gray-100 rounded overflow-hidden flex-shrink-0">
                <img
                  src="<%= item.image || 'data:image/svg+xml;base64,' %>"
                  alt="<%= item.name %>"
                  class="w-full h-full object-cover"
                >
              </div>

              <!-- Product Details -->
              <div class="flex-1 min-w-0">
                <h3 class="text-base font-medium text-ink-900 mb-1">
                  <a href="/products/<%= item.categorySlug || 'general' %>/<%= item.productId %>" class="hover:text-gold-600 transition-colors">
                    <%= item.name %>
                  </a>
                </h3>
                <p class="text-xs text-gray-500 mb-3">SKU: <%= item.sku || item.productId %></p>

                <!-- Quantity Controls -->
                <div class="flex items-center gap-4">
                  <div class="flex items-center border border-gray-300 rounded-none">
                    <button
                      type="button"
                      data-action="basket-qty-decrease"
                      data-basket-item-id="<%= item.basketItemId %>"
                      data-quantity="<%= item.quantity %>"
                      class="p-2 text-gray-600 hover:text-ink-900 hover:bg-gray-50 transition-colors <%= item.quantity <= 1 ? 'opacity-50 cursor-not-allowed' : '' %>"
                      <%= item.quantity <= 1 ? 'disabled' : '' %>
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
                    </button>
                    <span class="px-4 py-2 text-ink-900 font-medium text-sm" data-qty="<%= item.basketItemId %>"><%= item.quantity %></span>
                    <button
                      type="button"
                      data-action="basket-qty-increase"
                      data-basket-item-id="<%= item.basketItemId %>"
                      data-quantity="<%= item.quantity %>"
                      class="p-2 text-gray-600 hover:text-ink-900 hover:bg-gray-50 transition-colors"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    </button>
                  </div>
                  <button
                    type="button"
                    data-action="basket-remove"
                    data-basket-item-id="<%= item.basketItemId %>"
                    data-item-name="<%= item.name %>"
                    class="text-sm text-gray-400 hover:text-red-600 transition-colors"
                  >
                    Remove
                  </button>
                </div>
              </div>

              <!-- Pricing -->
              <div class="text-right flex-shrink-0">
                <p class="text-lg font-semibold text-ink-900" data-item-total="<%= item.basketItemId %>"><%= formatPrice(parseFloat(item.price) * item.quantity) %></p>
                <p class="text-xs text-gray-500 mt-1"><%= formatPrice(item.price) %> each</p>
              </div>
            </div>
          </div>
        </div>
        <% }) %>

        <!-- Continue Shopping -->
        <div class="pt-4">
          <a href="/products" class="inline-flex items-center text-sm text-gold-600 hover:text-gold-500 font-medium">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Continue Shopping
          </a>
        </div>
      </div>

      <!-- Order Summary Sidebar -->
      <div class="space-y-4">
        <div class="bg-white border border-gray-200 rounded-lg sticky top-24">
          <div class="p-6">
            <h2 class="text-lg font-semibold text-ink-900 mb-4" style="font-family: 'Playfair Display', serif;">Order Summary</h2>

            <div class="space-y-3 mb-4">
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Subtotal (<%= basket.items.length %> items)</span>
                <span class="text-ink-900 font-medium" data-cart-subtotal><%= formatPrice(basket.totals ? basket.totals.subtotal : 0) %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Shipping</span>
                <span class="text-ink-900 font-medium" data-cart-shipping><%= formatPrice(basket.totals ? basket.totals.shipping : 0) %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">Tax <%= isTaxInclusive ? '(included)' : '' %></span>
                <span class="text-ink-900 font-medium" data-cart-tax><%= formatPrice(basket.totals ? basket.totals.tax : 0) %></span>
              </div>
            </div>

            <!-- Coupon Code -->
            <div class="border-t border-gray-200 pt-4 mb-4">
              <label class="block text-sm font-medium text-ink-900 mb-2">Promo Code</label>
              <div class="flex gap-2">
                <input type="text" id="coupon-code" placeholder="Enter code" class="flex-1 px-3 py-2 border border-gray-300 rounded-none text-sm focus:ring-1 focus:ring-ink-900">
                <button type="button" data-action="basket-apply-coupon" data-basket-id="<%= basket.basketId %>" class="btn-secondary text-sm py-2 px-4">Apply</button>
              </div>
              <div id="coupon-message" class="hidden mt-2 text-sm"></div>
            </div>

            <!-- Total -->
            <div class="border-t border-gray-200 pt-4">
              <div class="flex justify-between items-baseline">
                <span class="text-lg font-semibold text-ink-900">Total</span>
                <span class="text-2xl font-bold text-ink-900" data-cart-total><%= formatPrice(basket.totals ? basket.totals.total : 0) %></span>
              </div>
              <p class="text-xs text-gray-500 mt-1"><%= isTaxInclusive ? 'Includes VAT' : 'Excludes sales tax' %></p>
            </div>

            <!-- Checkout Button -->
            <a href="/checkout" class="btn-primary w-full mt-6 text-center block">
              Proceed to Checkout
              <svg class="w-5 h-5 inline ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>
        </div>

        <!-- Trust Badge -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
          <div class="flex items-center gap-3">
            <svg class="w-8 h-8 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            <div>
              <p class="text-sm font-medium text-ink-900">Secure Checkout</p>
              <p class="text-xs text-gray-500">256-bit SSL encrypted</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% } else { %>
    <!-- Empty Cart -->
    <%- include("../partials/empty-state", {
      title: 'Your cart is empty',
      message: 'Looks like you haven\'t added anything to your cart yet. Browse our collection and find something you love.',
      icon: 'cart',
      actionUrl: '/products',
      actionLabel: 'Start Shopping'
    }) %>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>
