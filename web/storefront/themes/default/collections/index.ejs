<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50">
  <!-- Hero -->
  <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4"><%= t('storefront:collections') %></h1>
        <p class="text-xl text-blue-100 max-w-3xl mx-auto"><%= t('storefront:collectionsHeroDesc') %></p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <% if (collections && collections.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% collections.forEach(function(collection) { %>
      <a href="/collections/<%= collection.slug %>"
         class="group bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden border border-gray-200 hover:border-blue-300">
        <div class="aspect-w-16 aspect-h-9 bg-gradient-to-br from-blue-50 to-purple-50 flex items-center justify-center overflow-hidden">
          <% if (collection.imageUrl) { %>
          <img src="<%= collection.imageUrl %>" alt="<%= collection.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy">
          <% } else { %>
          <svg class="w-16 h-16 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <% } %>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
              <%= collection.name %>
            </h3>
            <% if (collection.isFeatured) { %>
            <span class="bg-gold-100 text-gold-700 text-xs font-semibold px-2 py-0.5 rounded"><%= t('storefront:featured') %></span>
            <% } %>
          </div>
          <% if (collection.description) { %>
          <p class="text-gray-600 text-sm line-clamp-2"><%= collection.description %></p>
          <% } %>
          <div class="mt-4 flex items-center text-blue-600 group-hover:text-blue-700 font-medium">
            <span><%= t('storefront:viewCollection') %></span>
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-24">
      <svg class="w-16 h-16 text-gray-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
      <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= t('storefront:noCollections') %></h2>
      <p class="text-gray-500 mb-8"><%= t('storefront:noCollectionsDesc') %></p>
      <a href="/products" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium">
        <%= t('storefront:browseAllProducts') %>
      </a>
    </div>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>
