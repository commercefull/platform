<%- include("../partials/header") %>

<%
  // Helper: format price with store currency/locale
  const formatPrice = (amt) => {
    try { return new Intl.NumberFormat(locale || 'en-US', { style: 'currency', currency: (currency || 'USD').toUpperCase() }).format(amt); }
    catch { return (currency || 'USD') + ' ' + (amt || 0).toFixed(2); }
  };

  // Helper: build a filter URL preserving existing params
  const buildFilterUrl = (key, value) => {
    const params = new URLSearchParams(filters || {});
    if (value === null || value === '') { params.delete(key); }
    else { params.set(key, value); }
    const qs = params.toString();
    return qs ? `?${qs}` : '';
  };

  // Helper: check if a filter is active
  const isFilterActive = (key, value) => {
    return filters && filters[key] === value;
  };

  // Active filter chips
  const activeFilters = [];
  if (filters) {
    if (filters.brand) activeFilters.push({ key: 'brand', label: 'Brand', value: filters.brand });
    if (filters.size) activeFilters.push({ key: 'size', label: 'Size', value: filters.size });
    if (filters.colour) activeFilters.push({ key: 'colour', label: 'Colour', value: filters.colour });
    if (filters.priceMin) activeFilters.push({ key: 'priceMin', label: 'Min Price', value: formatPrice(parseFloat(filters.priceMin)) });
    if (filters.priceMax) activeFilters.push({ key: 'priceMax', label: 'Max Price', value: formatPrice(parseFloat(filters.priceMax)) });
    if (filters.onSale === 'true') activeFilters.push({ key: 'onSale', label: 'On Sale', value: 'Yes' });
    if (filters.inStock === 'true') activeFilters.push({ key: 'inStock', label: 'In Stock', value: 'Yes' });
  }

  // Available filter options (from controller or defaults)
  const brands = availableBrands || [];
  const sizes = ['xs', 's', 'm', 'l', 'xl', 'xxl'];
  const colours = [
    { value: 'black', label: 'Black', hex: '#000000' },
    { value: 'white', label: 'White', hex: '#ffffff' },
    { value: 'navy', label: 'Navy', hex: '#1a2a4a' },
    { value: 'grey', label: 'Grey', hex: '#808080' },
    { value: 'charcoal', label: 'Charcoal', hex: '#36454f' },
    { value: 'cream', label: 'Cream', hex: '#f5f5dc' },
    { value: 'brown', label: 'Brown', hex: '#8b4513' },
    { value: 'olive', label: 'Olive', hex: '#556b2f' },
    { value: 'burgundy', label: 'Burgundy', hex: '#800020' },
    { value: 'sand', label: 'Sand', hex: '#c2b280' },
    { value: 'forest-green', label: 'Forest Green', hex: '#228b22' },
  ];
  const sortBy = (filters && filters.sort) || 'newest';
%>

<main class="min-h-screen bg-gray-50">
  <!-- Breadcrumb -->
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <%- include("../partials/breadcrumb", { items: [
        { label: 'Home', url: '/' },
        { label: 'Products', url: '/products' },
        ...(categoryName ? [{ label: categoryName }] : [])
      ] }) %>
    </div>
  </section>

  <!-- Page Header -->
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="text-3xl font-bold text-ink-900" style="font-family: 'Playfair Display', serif;"><%= pageName %></h1>
          <p class="text-gray-500 mt-1">
            <% if (totalProducts !== undefined && totalProducts !== null) { %>
              <%= totalProducts %> <%= totalProducts === 1 ? 'product' : 'products' %>
            <% } else if (products && products.length > 0) { %>
              <%= products.length %> <%= products.length === 1 ? 'product' : 'products' %>
            <% } else { %>
              No products found
            <% } %>
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Active Filter Chips -->
    <% if (activeFilters.length > 0) { %>
    <div class="flex flex-wrap items-center gap-2 mb-6">
      <span class="text-sm text-gray-500">Active filters:</span>
      <% activeFilters.forEach(function(f) { %>
      <a href="<%= buildFilterUrl(f.key, null) %>" class="inline-flex items-center gap-1 bg-ink-900 text-white text-xs px-3 py-1 rounded-full hover:bg-ink-800 transition-colors">
        <%= f.label %>: <%= f.value %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </a>
      <% }) %>
      <a href="/products" class="text-xs text-gold-600 hover:text-gold-500 font-medium ml-2">Clear all</a>
    </div>
    <% } %>

    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Filters Sidebar -->
      <aside class="lg:w-64 flex-shrink-0">
        <!-- Mobile filter toggle -->
        <button id="filter-toggle" data-action="toggle-filters" data-target="filter-sidebar" class="lg:hidden w-full bg-white border border-gray-300 rounded-none py-3 px-4 flex items-center justify-between mb-4">
          <span class="font-medium text-ink-900">Filters</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>

        <div id="filter-sidebar" class="bg-white border border-gray-200 rounded-lg p-6 sticky top-24 hidden lg:block">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Filters</h3>
            <a href="/products" class="text-xs text-gold-600 hover:text-gold-500 font-medium">Clear all</a>
          </div>

          <!-- Brand Filter -->
          <% if (brands && brands.length > 0) { %>
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h4 class="font-medium text-ink-900 mb-3 text-sm uppercase tracking-wide">Brand</h4>
            <div class="space-y-2 max-h-48 overflow-y-auto">
              <% brands.forEach(function(brand) { %>
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" name="brand" value="<%= brand.slug %>" class="mr-2 accent-ink-900" <%= isFilterActive('brand', brand.slug) ? 'checked' : '' %> data-action="filter-navigate" data-url-checked="/products<%= buildFilterUrl('brand', brand.slug) %>" data-url-unchecked="/products<%= buildFilterUrl('brand', null) %>">
                <span class="text-sm text-gray-700"><%= brand.name %></span>
              </label>
              <% }) %>
            </div>
          </div>
          <% } %>

          <!-- Category Filter -->
          <% if (categories && categories.length > 0) { %>
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h4 class="font-medium text-ink-900 mb-3 text-sm uppercase tracking-wide">Category</h4>
            <div class="space-y-2">
              <a href="/products" class="block text-sm <%= !categorySlug ? 'text-gold-600 font-medium' : 'text-gray-600 hover:text-ink-900' %> transition-colors">All Products</a>
              <% categories.forEach(function(category) { %>
              <a href="/products/category/<%= category.slug %>" class="block text-sm <%= categorySlug === category.slug ? 'text-gold-600 font-medium' : 'text-gray-600 hover:text-ink-900' %> transition-colors"><%= category.name %></a>
              <% }) %>
            </div>
          </div>
          <% } %>

          <!-- Size Filter -->
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h4 class="font-medium text-ink-900 mb-3 text-sm uppercase tracking-wide">Size</h4>
            <div class="flex flex-wrap gap-2">
              <% sizes.forEach(function(size) { %>
              <a href="/products<%= buildFilterUrl('size', isFilterActive('size', size) ? null : size) %>" class="px-3 py-1.5 text-sm border rounded-none transition-colors <%= isFilterActive('size', size) ? 'bg-ink-900 text-white border-ink-900' : 'border-gray-300 text-gray-700 hover:border-ink-900' %>"><%= size.toUpperCase() %></a>
              <% }) %>
            </div>
          </div>

          <!-- Colour Filter -->
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h4 class="font-medium text-ink-900 mb-3 text-sm uppercase tracking-wide">Colour</h4>
            <div class="grid grid-cols-6 gap-2">
              <% colours.forEach(function(colour) { %>
              <a href="/products<%= buildFilterUrl('colour', isFilterActive('colour', colour.value) ? null : colour.value) %>" title="<%= colour.label %>" class="w-8 h-8 rounded-full border-2 transition-all <%= isFilterActive('colour', colour.value) ? 'border-gold-500 ring-2 ring-gold-500 ring-offset-1' : 'border-gray-300 hover:border-gray-400' %>" style="background-color: <%= colour.hex %>;"></a>
              <% }) %>
            </div>
          </div>

          <!-- Price Range -->
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h4 class="font-medium text-ink-900 mb-3 text-sm uppercase tracking-wide">Price Range</h4>
            <div class="space-y-3">
              <div class="flex items-center gap-2">
                <input type="number" name="priceMin" placeholder="Min" value="<%= filters && filters.priceMin ? filters.priceMin : '' %>" class="w-full px-2 py-1.5 border border-gray-300 rounded-none text-sm focus:ring-1 focus:ring-ink-900">
                <span class="text-gray-400">—</span>
                <input type="number" name="priceMax" placeholder="Max" value="<%= filters && filters.priceMax ? filters.priceMax : '' %>" class="w-full px-2 py-1.5 border border-gray-300 rounded-none text-sm focus:ring-1 focus:ring-ink-900">
              </div>
              <button data-action="apply-price-filter" data-url="/products<%= buildFilterUrl('priceMin', (filters && filters.priceMin) || null) %>" class="w-full bg-ink-900 text-white py-2 text-sm font-medium rounded-none hover:bg-ink-800 transition-colors">Apply</button>
            </div>
          </div>

          <!-- Availability -->
          <div class="mb-6 pb-6 border-b border-gray-200">
            <h4 class="font-medium text-ink-900 mb-3 text-sm uppercase tracking-wide">Availability</h4>
            <div class="space-y-2">
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" name="inStock" class="mr-2 accent-ink-900" <%= isFilterActive('inStock', 'true') ? 'checked' : '' %> data-action="filter-navigate" data-url-checked="/products<%= buildFilterUrl('inStock', 'true') %>" data-url-unchecked="/products<%= buildFilterUrl('inStock', null) %>">
                <span class="text-sm text-gray-700">In Stock Only</span>
              </label>
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" name="onSale" class="mr-2 accent-ink-900" <%= isFilterActive('onSale', 'true') ? 'checked' : '' %> data-action="filter-navigate" data-url-checked="/products<%= buildFilterUrl('onSale', 'true') %>" data-url-unchecked="/products<%= buildFilterUrl('onSale', null) %>">
                <span class="text-sm text-gray-700">On Sale Only</span>
              </label>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="flex-1">
        <!-- Sort and View Toolbar -->
        <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <!-- Sort -->
            <div class="flex items-center gap-3">
              <span class="text-sm text-gray-500">Sort by:</span>
              <select id="sort-select" data-action="sort-change" class="border border-gray-300 rounded-none px-3 py-2 text-sm focus:ring-1 focus:ring-ink-900">
                <option value="newest" data-url="/products<%= buildFilterUrl('sort', 'newest') %>" <%= sortBy === 'newest' ? 'selected' : '' %>>Newest</option>
                <option value="price-asc" data-url="/products<%= buildFilterUrl('sort', 'price-asc') %>" <%= sortBy === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
                <option value="price-desc" data-url="/products<%= buildFilterUrl('sort', 'price-desc') %>" <%= sortBy === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
                <option value="popular" data-url="/products<%= buildFilterUrl('sort', 'popular') %>" <%= sortBy === 'popular' ? 'selected' : '' %>>Most Popular</option>
                <option value="featured" data-url="/products<%= buildFilterUrl('sort', 'featured') %>" <%= sortBy === 'featured' ? 'selected' : '' %>>Featured</option>
              </select>
            </div>

            <!-- View Mode -->
            <div class="flex items-center gap-2">
              <button id="grid-view-btn" data-action="view-grid" class="p-2 border border-gray-300 rounded-none text-ink-900 hover:bg-gray-50 transition-colors" title="Grid view">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
              </button>
              <button id="list-view-btn" data-action="view-list" class="p-2 border border-gray-300 rounded-none text-gray-400 hover:bg-gray-50 transition-colors" title="List view">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Products Grid -->
        <% if (products && products.length > 0) { %>
        <div id="products-container" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mb-8">
          <% products.forEach(function(product) { %>
          <%- include("../partials/product-card", { product: product }) %>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (typeof pagination !== 'undefined' && pagination) { %>
        <%- include("../partials/pagination", { pagination: pagination, filters: filters }) %>
        <% } %>

        <% } else { %>
        <!-- Empty State -->
        <%- include("../partials/empty-state", {
          title: 'No products found',
          message: 'Try adjusting your filters or browse all products.',
          icon: 'shopping',
          actionUrl: '/products',
          actionLabel: 'View All Products'
        }) %>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
