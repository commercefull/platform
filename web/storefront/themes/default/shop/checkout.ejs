<%- include("../partials/header") %>

<%
  // Store context
  const storeCtx = (typeof storeContext !== 'undefined' ? storeContext : null) || {};
  const cur = (typeof currency !== 'undefined' ? currency : 'USD').toUpperCase();
  const loc = typeof locale !== 'undefined' ? locale : 'en-US';
  const isTaxInclusive = storeCtx.priceDisplayMode === 'inclusive_tax';

  // Format price helper
  const formatPrice = (amt) => {
    try { return new Intl.NumberFormat(loc, { style: 'currency', currency: cur }).format(amt); }
    catch { return cur + ' ' + (amt || 0).toFixed(2); }
  };

  // Cart totals
  const subtotal = basket?.totals?.subtotal || 0;
  const shippingCost = basket?.totals?.shipping || 0;
  const taxAmount = basket?.totals?.tax || 0;
  const total = basket?.totals?.total || subtotal + shippingCost + taxAmount;
  const itemCount = basket?.items?.length || 0;
%>

<main class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-ink-900" style="font-family: 'Playfair Display', serif;">Checkout</h1>
      <p class="mt-2 text-sm text-gray-600">Complete your order securely</p>
    </div>

    <!-- Flash Messages -->
    <% if (successMsg || errorMsg) { %>
    <div class="mb-8 space-y-3 max-w-2xl mx-auto">
      <% if (errorMsg) { %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 flex items-center">
        <svg class="w-5 h-5 text-red-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
        <p class="text-sm text-red-800"><%= errorMsg %></p>
      </div>
      <% } %>
      <% if (successMsg) { %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-center">
        <svg class="w-5 h-5 text-green-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="text-sm text-green-800"><%= successMsg %></p>
      </div>
      <% } %>
    </div>
    <% } %>

    <% if (basket && basket.items && basket.items.length > 0) { %>
    <!-- Step Progress Indicator -->
    <div class="max-w-2xl mx-auto mb-10">
      <div class="flex items-center justify-between" data-checkout-steps>
        <div class="flex items-center gap-2" data-step-indicator="1">
          <div class="w-8 h-8 rounded-full bg-ink-900 text-white flex items-center justify-center text-sm font-medium" data-step-circle="1">1</div>
          <span class="text-sm font-medium text-ink-900 hidden sm:inline" data-step-label="1">Shipping</span>
        </div>
        <div class="flex-1 h-px bg-gray-200 mx-2" data-step-line="1"></div>
        <div class="flex items-center gap-2" data-step-indicator="2">
          <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium" data-step-circle="2">2</div>
          <span class="text-sm text-gray-500 hidden sm:inline" data-step-label="2">Delivery</span>
        </div>
        <div class="flex-1 h-px bg-gray-200 mx-2" data-step-line="2"></div>
        <div class="flex items-center gap-2" data-step-indicator="3">
          <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium" data-step-circle="3">3</div>
          <span class="text-sm text-gray-500 hidden sm:inline" data-step-label="3">Payment</span>
        </div>
        <div class="flex-1 h-px bg-gray-200 mx-2" data-step-line="3"></div>
        <div class="flex items-center gap-2" data-step-indicator="4">
          <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-medium" data-step-circle="4">4</div>
          <span class="text-sm text-gray-500 hidden sm:inline" data-step-label="4">Review</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Checkout Form -->
      <div class="lg:col-span-2">
        <form action="/checkout" method="POST" id="checkout-form" data-checkout-form>

          <!-- STEP 1: Shipping Address -->
          <div data-checkout-step="1" class="bg-white rounded-lg border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h2 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Shipping Address</h2>
            </div>
            <div class="p-6 space-y-5">
              <!-- Guest checkout option -->
              <% if (!customer) { %>
              <div class="bg-gray-50 rounded-lg p-4 mb-2">
                <p class="text-sm text-gray-600">Checking out as guest. <a href="/login?redirect=/checkout" class="text-gold-600 hover:text-gold-500 font-medium">Sign in</a> for faster checkout.</p>
              </div>
              <% } %>

              <!-- Customer info -->
              <% if (customer) { %>
              <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <div>
                  <p class="text-sm font-medium text-ink-900"><%= customer.firstName %> <%= customer.lastName %></p>
                  <p class="text-xs text-gray-500"><%= customer.email %></p>
                </div>
              </div>
              <% } %>

              <!-- Name -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="billingFirstName" class="block text-sm font-medium text-ink-900 mb-1.5">First Name</label>
                  <input type="text" id="billingFirstName" name="billingFirstName" value="<%= customer ? customer.firstName : '' %>" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="First name">
                </div>
                <div>
                  <label for="billingLastName" class="block text-sm font-medium text-ink-900 mb-1.5">Last Name</label>
                  <input type="text" id="billingLastName" name="billingLastName" value="<%= customer ? customer.lastName : '' %>" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Last name">
                </div>
              </div>

              <!-- Email -->
              <div>
                <label for="billingEmail" class="block text-sm font-medium text-ink-900 mb-1.5">Email Address</label>
                <input type="email" id="billingEmail" name="billingEmail" value="<%= customer ? customer.email : '' %>" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="you@example.com">
              </div>

              <!-- Street Address -->
              <div>
                <label for="billingAddress" class="block text-sm font-medium text-ink-900 mb-1.5">Street Address</label>
                <input type="text" id="billingAddress" name="billingAddress" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="123 Main Street">
              </div>

              <!-- City / State / Zip -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label for="billingCity" class="block text-sm font-medium text-ink-900 mb-1.5">City</label>
                  <input type="text" id="billingCity" name="billingCity" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="City">
                </div>
                <div>
                  <label for="billingState" class="block text-sm font-medium text-ink-900 mb-1.5">State/County</label>
                  <input type="text" id="billingState" name="billingState" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="State">
                </div>
                <div>
                  <label for="billingZip" class="block text-sm font-medium text-ink-900 mb-1.5">Postcode</label>
                  <input type="text" id="billingZip" name="billingZip" required class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Postcode">
                </div>
              </div>

              <!-- Same address checkbox -->
              <label class="flex items-center pt-2">
                <input type="checkbox" id="sameAddress" checked class="h-4 w-4 text-ink-900 focus:ring-ink-900 border-gray-300 rounded">
                <span class="ml-3 text-sm text-gray-600">Billing address is the same as shipping address</span>
              </label>

              <!-- Separate shipping address (hidden if same) -->
              <div id="shippingAddress" class="hidden space-y-4 pt-4 border-t border-gray-200">
                <p class="text-sm font-medium text-ink-900">Shipping Address</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label for="shippingFirstName" class="block text-sm font-medium text-ink-900 mb-1.5">First Name</label>
                    <input type="text" id="shippingFirstName" name="shippingFirstName" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="First name">
                  </div>
                  <div>
                    <label for="shippingLastName" class="block text-sm font-medium text-ink-900 mb-1.5">Last Name</label>
                    <input type="text" id="shippingLastName" name="shippingLastName" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Last name">
                  </div>
                </div>
                <div>
                  <label for="shippingAddressInput" class="block text-sm font-medium text-ink-900 mb-1.5">Street Address</label>
                  <input type="text" id="shippingAddressInput" name="shippingAddress" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Street address">
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label for="shippingCity" class="block text-sm font-medium text-ink-900 mb-1.5">City</label>
                    <input type="text" id="shippingCity" name="shippingCity" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="City">
                  </div>
                  <div>
                    <label for="shippingState" class="block text-sm font-medium text-ink-900 mb-1.5">State/County</label>
                    <input type="text" id="shippingState" name="shippingState" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="State">
                  </div>
                  <div>
                    <label for="shippingZip" class="block text-sm font-medium text-ink-900 mb-1.5">Postcode</label>
                    <input type="text" id="shippingZip" name="shippingZip" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Postcode">
                  </div>
                </div>
              </div>

              <!-- Step 1 navigation -->
              <div class="flex justify-end pt-4">
                <button type="button" data-action="checkout-step-next" data-step-next="1" class="px-6 py-3 bg-ink-900 text-white font-medium rounded hover:bg-ink-800 transition-colors">
                  Continue to Delivery
                  <svg class="w-4 h-4 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- STEP 2: Shipping Method -->
          <div data-checkout-step="2" class="hidden bg-white rounded-lg border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h2 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Delivery Method</h2>
            </div>
            <div class="p-6 space-y-3">
              <% (shippingMethods || []).forEach(function(method) { %>
              <label class="flex items-center p-4 border border-gray-200 rounded hover:border-ink-900 cursor-pointer transition-colors">
                <input id="shipping-<%= method.shippingMethodId %>" name="shippingMethodId" type="radio" value="<%= method.shippingMethodId %>" class="h-4 w-4 text-ink-900 focus:ring-ink-900 border-gray-300" <%= shippingMethods.indexOf(method) === 0 ? 'checked' : '' %> required>
                <div class="ml-4 flex-1">
                  <div class="flex items-center justify-between">
                    <div>
                      <span class="text-sm font-medium text-ink-900"><%= method.name %></span>
                      <% if (method.estimatedDays) { %>
                      <span class="text-xs text-gray-500 ml-2">(<%= method.estimatedDays %> days)</span>
                      <% } %>
                    </div>
                    <span class="text-sm font-semibold text-ink-900"><%= formatPrice(parseFloat(method.cost) || 0) %></span>
                  </div>
                </div>
              </label>
              <% }) %>

              <div class="flex justify-between pt-4">
                <button type="button" data-action="checkout-step-prev" data-step-prev="2" class="px-6 py-3 border border-gray-300 text-ink-900 font-medium rounded hover:bg-gray-50 transition-colors">
                  <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                  Back
                </button>
                <button type="button" data-action="checkout-step-next" data-step-next="2" class="px-6 py-3 bg-ink-900 text-white font-medium rounded hover:bg-ink-800 transition-colors">
                  Continue to Payment
                  <svg class="w-4 h-4 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- STEP 3: Payment -->
          <div data-checkout-step="3" class="hidden bg-white rounded-lg border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h2 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Payment Method</h2>
            </div>
            <div class="p-6 space-y-4">
              <!-- Credit Card -->
              <label class="flex items-center p-4 border border-gray-200 rounded hover:border-ink-900 cursor-pointer transition-colors">
                <input id="credit" name="paymentMethod" type="radio" value="credit_card" checked required class="h-4 w-4 text-ink-900 focus:ring-ink-900 border-gray-300">
                <div class="ml-4 flex items-center">
                  <svg class="w-8 h-5 text-gray-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                  <span class="text-sm font-medium text-ink-900">Credit / Debit Card</span>
                </div>
              </label>

              <!-- Card details (shown when credit card selected) -->
              <div id="cardDetails" class="space-y-4 pl-8">
                <div>
                  <label for="cardNumber" class="block text-sm font-medium text-ink-900 mb-1.5">Card Number</label>
                  <input type="text" id="cardNumber" name="cardNumber" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="1234 5678 9012 3456">
                </div>
                <div class="grid grid-cols-3 gap-4">
                  <div class="col-span-1">
                    <label for="cardExpiry" class="block text-sm font-medium text-ink-900 mb-1.5">Expiry</label>
                    <input type="text" id="cardExpiry" name="cardExpiry" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="MM/YY">
                  </div>
                  <div class="col-span-1">
                    <label for="cardCVC" class="block text-sm font-medium text-ink-900 mb-1.5">CVC</label>
                    <input type="text" id="cardCVC" name="cardCVC" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="123">
                  </div>
                  <div class="col-span-1">
                    <label for="cardName" class="block text-sm font-medium text-ink-900 mb-1.5">Name on Card</label>
                    <input type="text" id="cardName" name="cardName" class="w-full px-3 py-2.5 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Name">
                  </div>
                </div>
              </div>

              <!-- PayPal -->
              <label class="flex items-center p-4 border border-gray-200 rounded hover:border-ink-900 cursor-pointer transition-colors">
                <input id="paypal" name="paymentMethod" type="radio" value="paypal" class="h-4 w-4 text-ink-900 focus:ring-ink-900 border-gray-300">
                <div class="ml-4 flex items-center">
                  <svg class="w-8 h-5 text-gray-600 mr-3" fill="currentColor" viewBox="0 0 24 24"><path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.192 1.304 2.702.9 4.657-.032.17-.069.34-.11.503-.6 3.056-2.747 4.802-6.097 4.802H9.16a.73.73 0 0 0-.72.617l-.9 5.683-.207 1.299a.38.38 0 0 0 .376.436h3.395c.292 0 .54-.213.588-.5l.037-.194.497-3.15.038-.218a.585.585 0 0 1 .588-.5h.37c2.39 0 4.263-.97 4.81-3.781.227-1.166.115-2.14-.487-2.852-.227-.265-.508-.485-.835-.666"/></svg>
                  <span class="text-sm font-medium text-ink-900">PayPal</span>
                </div>
              </label>

              <!-- Trust badges -->
              <div class="flex items-center gap-4 pt-4 border-t border-gray-200">
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                  <span class="text-xs text-gray-500">SSL Encrypted</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                  <span class="text-xs text-gray-500">Secure Payment</span>
                </div>
              </div>

              <div class="flex justify-between pt-4">
                <button type="button" data-action="checkout-step-prev" data-step-prev="3" class="px-6 py-3 border border-gray-300 text-ink-900 font-medium rounded hover:bg-gray-50 transition-colors">
                  <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                  Back
                </button>
                <button type="button" data-action="checkout-step-next" data-step-next="3" class="px-6 py-3 bg-ink-900 text-white font-medium rounded hover:bg-ink-800 transition-colors">
                  Review Order
                  <svg class="w-4 h-4 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- STEP 4: Review -->
          <div data-checkout-step="4" class="hidden bg-white rounded-lg border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
              <h2 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Review Your Order</h2>
            </div>
            <div class="p-6 space-y-4">
              <!-- Items -->
              <div class="space-y-3">
                <% basket.items.forEach(function(item) { %>
                <div class="flex gap-4 pb-3 border-b border-gray-100">
                  <div class="w-16 h-16 bg-gray-100 rounded overflow-hidden flex-shrink-0">
                    <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover"><% } %>
                  </div>
                  <div class="flex-1">
                    <p class="text-sm font-medium text-ink-900"><%= item.name %></p>
                    <p class="text-xs text-gray-500">Qty: <%= item.quantity %></p>
                  </div>
                  <p class="text-sm font-semibold text-ink-900"><%= formatPrice((parseFloat(item.price) || 0) * item.quantity) %></p>
                </div>
                <% }) %>
              </div>

              <!-- Place order button -->
              <button type="submit" class="w-full px-6 py-4 bg-ink-900 text-white font-medium rounded hover:bg-ink-800 transition-colors text-base">
                <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Place Order — <%= formatPrice(total) %>
              </button>

              <div class="flex justify-start">
                <button type="button" data-action="checkout-step-prev" data-step-prev="4" class="text-sm text-gray-500 hover:text-ink-900 transition-colors">
                  <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                  Back to Payment
                </button>
              </div>

              <p class="text-xs text-gray-400 text-center">By placing your order, you agree to our <a href="/terms" class="underline hover:text-gray-600">Terms</a> and <a href="/privacy-policy" class="underline hover:text-gray-600">Privacy Policy</a>.</p>
            </div>
          </div>

        </form>
      </div>

      <!-- Order Summary Sidebar -->
      <div class="lg:col-span-1">
        <div class="bg-white rounded-lg border border-gray-200 overflow-hidden lg:sticky lg:top-4">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-ink-900" style="font-family: 'Playfair Display', serif;">Order Summary</h2>
            <p class="text-xs text-gray-500 mt-0.5"><%= itemCount %> item<%= itemCount === 1 ? '' : 's' %></p>
          </div>
          <div class="p-6 space-y-3">
            <!-- Items list -->
            <div class="space-y-2 max-h-48 overflow-y-auto">
              <% basket.items.forEach(function(item) { %>
              <div class="flex gap-3 text-sm">
                <div class="w-12 h-12 bg-gray-100 rounded overflow-hidden flex-shrink-0">
                  <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover"><% } %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-ink-900 truncate"><%= item.name %></p>
                  <p class="text-xs text-gray-500">Qty <%= item.quantity %></p>
                </div>
                <p class="font-medium text-ink-900"><%= formatPrice((parseFloat(item.price) || 0) * item.quantity) %></p>
              </div>
              <% }) %>
            </div>

            <!-- Totals -->
            <div class="pt-3 border-t border-gray-200 space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Subtotal</span>
                <span class="font-medium text-ink-900"><%= formatPrice(subtotal) %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600">Shipping</span>
                <span class="font-medium text-ink-900"><%= shippingCost > 0 ? formatPrice(shippingCost) : 'Free' %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-gray-600"><%= isTaxInclusive ? 'VAT (included)' : 'Estimated Tax' %></span>
                <span class="font-medium text-ink-900"><%= formatPrice(taxAmount) %></span>
              </div>
            </div>

            <!-- Total -->
            <div class="pt-3 border-t border-gray-200 flex justify-between items-baseline">
              <span class="text-base font-semibold text-ink-900">Total</span>
              <span class="text-2xl font-bold text-ink-900" style="font-family: 'Playfair Display', serif;"><%= formatPrice(total) %></span>
            </div>

            <!-- Promo code -->
            <div class="pt-3 border-t border-gray-200">
              <label for="promoCode" class="block text-xs font-medium text-gray-500 mb-1.5">Promo Code</label>
              <div class="flex gap-2">
                <input type="text" id="promoCode" name="promoCode" class="flex-1 px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-ink-900 focus:border-transparent" placeholder="Enter code">
                <button type="button" class="px-3 py-2 border border-ink-900 text-ink-900 text-sm font-medium rounded hover:bg-ink-900 hover:text-white transition-colors">Apply</button>
              </div>
            </div>

            <!-- Trust signals -->
            <div class="pt-3 border-t border-gray-200 space-y-2">
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Secure SSL encrypted checkout
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                30-day free returns
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                Order confirmation email
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% } else { %>
    <!-- Empty cart -->
    <div class="max-w-md mx-auto text-center py-16">
      <svg class="w-24 h-24 mx-auto text-gray-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.1 5H19M7 13v8a2 2 0 002 2h10a2 2 0 002-2v-3"></path></svg>
      <h2 class="text-xl font-semibold text-ink-900 mb-2" style="font-family: 'Playfair Display', serif;">Your cart is empty</h2>
      <p class="text-sm text-gray-500 mb-6">Add some items before checking out.</p>
      <a href="/products" class="inline-block px-6 py-3 bg-ink-900 text-white font-medium rounded hover:bg-ink-800 transition-colors">Browse Products</a>
    </div>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>
