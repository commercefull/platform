<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= t('storefront:mySupportTickets') %></h1>
        <p class="text-gray-600 mt-1"><%= t('storefront:viewManageSupport') %></p>
      </div>
      <a href="/support/tickets/new" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <%= t('storefront:newTicket') %>
      </a>
    </div>

    <!-- Flash Messages -->
    <% if (successMsg) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
        <%= successMsg %>
      </div>
    <% } %>
    <% if (errorMsg) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
        <%= errorMsg %>
      </div>
    <% } %>

    <!-- Status Filter -->
    <div class="flex flex-wrap gap-2 mb-6">
      <a href="/support/tickets" class="px-4 py-2 rounded-lg text-sm font-medium <%= currentStatus === 'all' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %>"><%= t('shared:common.all') %></a>
      <a href="/support/tickets?status=open" class="px-4 py-2 rounded-lg text-sm font-medium <%= currentStatus === 'open' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %>"><%= t('shared:common.open') %></a>
      <a href="/support/tickets?status=in_progress" class="px-4 py-2 rounded-lg text-sm font-medium <%= currentStatus === 'in_progress' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %>"><%= t('storefront:inProgress') %></a>
      <a href="/support/tickets?status=waiting_customer" class="px-4 py-2 rounded-lg text-sm font-medium <%= currentStatus === 'waiting_customer' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %>"><%= t('storefront:waitingOnYou') %></a>
      <a href="/support/tickets?status=resolved" class="px-4 py-2 rounded-lg text-sm font-medium <%= currentStatus === 'resolved' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %>"><%= t('shared:common.resolved') %></a>
      <a href="/support/tickets?status=closed" class="px-4 py-2 rounded-lg text-sm font-medium <%= currentStatus === 'closed' ? 'bg-blue-600 text-white' : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50' %>"><%= t('shared:common.closed') %></a>
    </div>

    <!-- Tickets List -->
    <% if (tickets && tickets.length > 0) { %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.ticket') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.subject') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.status') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.priority') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.dateCreated') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% tickets.forEach(function(ticket) { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= ticket.ticketNumber %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <a href="/support/tickets/<%= ticket.supportTicketId %>" class="hover:text-blue-600"><%= ticket.subject %></a>
                  <% if (ticket.category) { %>
                    <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600"><%= ticket.category %></span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% const statusColors = { open: 'bg-blue-100 text-blue-800', in_progress: 'bg-yellow-100 text-yellow-800', waiting_customer: 'bg-purple-100 text-purple-800', resolved: 'bg-green-100 text-green-800', closed: 'bg-gray-100 text-gray-600' }; %>
                  <% const statusLabels = { open: t('shared:common.open'), in_progress: t('storefront:inProgress'), waiting_customer: t('storefront:waitingOnYou'), resolved: t('shared:common.resolved'), closed: t('shared:common.closed') }; %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= statusColors[ticket.status] || 'bg-gray-100 text-gray-800' %>">
                    <%= statusLabels[ticket.status] || ticket.status %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% const priorityColors = { low: 'bg-gray-100 text-gray-600', medium: 'bg-blue-100 text-blue-700', high: 'bg-orange-100 text-orange-700', urgent: 'bg-red-100 text-red-700' }; %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= priorityColors[ticket.priority] || 'bg-gray-100 text-gray-600' %>">
                    <%= ticket.priority %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= new Date(ticket.createdAt).toLocaleDateString() %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-right">
                  <a href="/support/tickets/<%= ticket.supportTicketId %>" class="text-blue-600 hover:text-blue-800"><%= t('shared:common.viewDetails') %></a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="bg-white shadow rounded-lg p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2"><%= t('storefront:noTicketsYet') %></h3>
        <p class="text-gray-500 mb-6"><%= t('storefront:noTicketsDesc') %></p>
        <a href="/support/tickets/new" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          <%= t('storefront:createFirstTicket') %>
        </a>
      </div>
    <% } %>

    <!-- Back to Support -->
    <div class="mt-8 text-center">
      <a href="/support" class="text-blue-600 hover:text-blue-800">&larr; <%= t('storefront:backToSupportCenter') %></a>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
