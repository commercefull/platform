<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= t('storefront:myDataRequests') %></h1>
        <p class="text-gray-600 mt-1"><%= t('storefront:manageGdpr') %></p>
      </div>
      <a href="/gdpr/requests/new" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <%= t('shared:common.newRequest') %>
      </a>
    </div>

    <!-- Flash Messages -->
    <% if (successMsg) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
        <%= successMsg %>
      </div>
    <% } %>
    <% if (errorMsg) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
        <%= errorMsg %>
      </div>
    <% } %>

    <!-- Info Banner -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
      <div class="flex items-start">
        <svg class="w-5 h-5 text-blue-600 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <div class="text-sm text-blue-700">
          <p class="font-medium mb-1"><%= t('storefront:yourPrivacyRights') %></p>
          <p><%= t('storefront:privacyRightsDesc') %></p>
        </div>
      </div>
    </div>

    <!-- Requests List -->
    <% if (requests && requests.length > 0) { %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.requestType') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.status') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.deadline') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('shared:common.dateCreated') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% const typeLabels = { access: t('storefront:gdprTypeAccess'), export: t('shared:common.export'), deletion: t('storefront:gdprTypeDeletion'), rectification: t('shared:common.rectification'), objection: t('storefront:gdprTypeObjection'), restriction: t('storefront:gdprTypeRestriction') }; %>
            <% const statusColors = { pending: 'bg-yellow-100 text-yellow-800', processing: 'bg-blue-100 text-blue-800', completed: 'bg-green-100 text-green-800', rejected: 'bg-red-100 text-red-800', cancelled: 'bg-gray-100 text-gray-600', failed: 'bg-red-100 text-red-800' }; %>
            <% requests.forEach(function(req) { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm">
                  <div class="font-medium text-gray-900"><%= typeLabels[req.requestType] || req.requestType %></div>
                  <% if (req.reason) { %>
                    <div class="text-gray-500 text-xs mt-1 truncate max-w-xs"><%= req.reason %></div>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= statusColors[req.status] || 'bg-gray-100 text-gray-800' %>">
                    <%= req.status %>
                  </span>
                  <% if (req.isOverdue) { %>
                    <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-700"><%= t('storefront:overdue') %></span>
                  <% } %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= new Date(req.deadlineAt).toLocaleDateString() %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= new Date(req.createdAt).toLocaleDateString() %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-right">
                  <a href="/gdpr/requests/<%= req.gdprDataRequestId %>" class="text-blue-600 hover:text-blue-800"><%= t('shared:common.viewDetails') %></a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="bg-white shadow rounded-lg p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-900 mb-2"><%= t('storefront:noDataRequests') %></h3>
        <p class="text-gray-500 mb-6"><%= t('storefront:noDataRequestsDesc') %></p>
        <a href="/gdpr/requests/new" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
          <%= t('storefront:submitRequest') %>
        </a>
      </div>
    <% } %>

    <!-- Back -->
    <div class="mt-8 text-center">
      <a href="/profile" class="text-blue-600 hover:text-blue-800">&larr; <%= t('storefront:backToProfile') %></a>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
