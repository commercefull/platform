<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <!-- Header Section -->
    <div class="text-center mb-12">
      <div class="mx-auto h-16 w-16 bg-blue-600 rounded-full flex items-center justify-center mb-6">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= t('storefront:contactUsTitle') %></h1>
      <p class="text-lg text-gray-600"><%= t('storefront:contactFormDesc') %></p>
    </div>

    <!-- Flash Messages -->
    <% if (successMsg) { %>
    <div class="mb-8">
      <div class="bg-green-50 border border-green-200 rounded-lg p-4">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-green-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-sm text-green-800"><%= successMsg %></p>
        </div>
      </div>
    </div>
    <% } %>

    <% if (errorMsg && errorMsg.length > 0) { %>
    <div class="mb-8">
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div class="text-sm text-red-800">
            <% errorMsg.forEach((message) => { %>
            <p><%= message %></p>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Contact Form -->
    <div class="bg-white shadow-lg rounded-xl overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4">
        <h2 class="text-xl font-semibold text-white flex items-center">
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <%= t('storefront:sendUsMessage') %>
        </h2>
      </div>

      <form action="/contact-form" method="POST" class="p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Name Field -->
          <div class="md:col-span-2">
            <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
              <%= t('storefront:fullName') %> <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
              name="name"
              id="name"
              placeholder="<%= t('storefront:enterFullName') %>"
              required
            />
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
              <%= t('storefront:emailAddress') %> <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
              name="email"
              id="email"
              placeholder="<%= t('storefront:emailPlaceholder') %>"
              required
            />
          </div>

          <!-- Phone Field -->
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              <%= t('storefront:phoneNumber') %>
            </label>
            <input
              type="tel"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
              name="phone"
              id="phone"
              placeholder="+1 (555) 123-4567"
            />
          </div>
        </div>

        <!-- Subject Field -->
        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
            <%= t('shared:common.subject') %> <span class="text-red-500">*</span>
          </label>
          <select
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
            name="subject"
            id="subject"
            required
          >
            <option value=""><%= t('storefront:selectSubject') %></option>
            <option value="general"><%= t('storefront:generalInquiry') %></option>
            <option value="order"><%= t('storefront:orderSupportOption') %></option>
            <option value="technical"><%= t('storefront:technicalSupportOption') %></option>
            <option value="billing"><%= t('storefront:billingQuestion') %></option>
            <option value="returns"><%= t('storefront:returnsExchanges') %></option>
            <option value="feedback"><%= t('storefront:feedback') %></option>
            <option value="other"><%= t('shared:common.other') %></option>
          </select>
        </div>

        <!-- Message Field -->
        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
            <%= t('shared:common.message') %> <span class="text-red-500">*</span>
          </label>
          <textarea
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors resize-vertical"
            name="message"
            id="message"
            rows="6"
            placeholder="<%= t('storefront:messagePlaceholder') %>"
            required
          ></textarea>
          <p class="text-xs text-gray-500 mt-1"><%= t('storefront:minCharsRequired') %></p>
        </div>

        <!-- Submit Button -->
        <div class="flex items-center justify-between pt-4">
          <p class="text-sm text-gray-600">
            <%= t('storefront:respondWithin24h') %>
          </p>
          <button
            type="submit"
            class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
            <%= t('storefront:sendMessage') %>
          </button>
        </div>
      </form>
    </div>

    <!-- Alternative Contact Methods -->
    <div class="mt-8 text-center">
      <p class="text-gray-600 mb-4"><%= t('storefront:preferAnotherWay') %></p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="tel:+1234567890"
          class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <%= t('storefront:callUs') %>
        </a>
        <a
          href="mailto:support@email.com"
          class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <%= t('storefront:emailUs') %>
        </a>
        <a
          href="/pages/contact-us"
          class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <%= t('storefront:fullContactInfo') %>
        </a>
      </div>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
