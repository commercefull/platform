<%- include("../partials/header") %>

<main class="min-h-screen bg-gray-50">
  <!-- Hero Section -->
  <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4"><%= t('storefront:findStoreNearYou') %></h1>
        <p class="text-xl text-blue-100 max-w-3xl mx-auto mb-8">
          <%= t('storefront:storeLocatorDesc') %>
        </p>
        <nav class="flex justify-center" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-2">
            <li>
              <a href="/" class="text-blue-200 hover:text-white transition-colors"><%= t('storefront:home') %></a>
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 text-blue-300 mx-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-blue-200"><%= t('storefront:storeLocator') %></span>
            </li>
          </ol>
        </nav>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Store List -->
    <% if (stores && stores.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% stores.forEach(store => { %>
      <div class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-200 overflow-hidden">
        <div class="p-6">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-900 mb-1"><%= store.name %></h3>
              <% if (store.storeType) { %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                <%= store.storeType %>
              </span>
              <% } %>
            </div>
            <% if (store.settings && store.settings.pickup && store.settings.pickup.enabled) { %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              <%= t('storefront:pickupAvailable') %>
            </span>
            <% } %>
          </div>

          <% if (store.address) { %>
          <div class="space-y-2 text-sm text-gray-600">
            <div class="flex items-start">
              <svg class="w-5 h-5 text-gray-400 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <div>
                <% if (store.address.line1) { %><p><%= store.address.line1 %></p><% } %>
                <% if (store.address.line2) { %><p><%= store.address.line2 %></p><% } %>
                <p>
                  <% if (store.address.city) { %><%= store.address.city %><% } %>
                  <% if (store.address.state) { %>, <%= store.address.state %><% } %>
                  <% if (store.address.postalCode) { %> <%= store.address.postalCode %><% } %>
                </p>
                <% if (store.address.country) { %><p><%= store.address.country %></p><% } %>
              </div>
            </div>

            <% if (store.phone || store.email) { %>
            <div class="flex items-center pt-2 border-t border-gray-100">
              <% if (store.phone) { %>
              <a href="tel:<%= store.phone %>" class="text-blue-600 hover:text-blue-800 text-sm mr-4 flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <%= store.phone %>
              </a>
              <% } %>
              <% if (store.email) { %>
              <a href="mailto:<%= store.email %>" class="text-blue-600 hover:text-blue-800 text-sm flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <%= t('shared:common.email') %>
              </a>
              <% } %>
            </div>
            <% } %>
          </div>
          <% } %>

          <div class="mt-4 pt-4 border-t border-gray-100">
            <a href="/products?store=<%= store.storeId %>"
               class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800">
              <%= t('storefront:browseProducts') %>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-16">
      <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <h3 class="text-lg font-medium text-gray-900 mb-2"><%= t('storefront:noStoresFound') %></h3>
      <p class="text-gray-500"><%= t('storefront:noStoresDesc') %></p>
    </div>
    <% } %>
  </div>
</main>

<%- include("../partials/footer") %>
