<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-percentage me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/hub"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/hub/tax"><%= t('shared:common.taxSettings') %></a></li>
            <li class="breadcrumb-item active">Exemptions</li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-check-circle me-2"></i><%= success %>
      </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
      </div>
      <% } %>

      <!-- Filter -->
      <div class="card mb-3">
        <div class="card-body py-2">
          <form method="GET" action="/hub/tax/exemptions" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 me-2">Filter by status:</label>
            <select name="status" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
              <option value="all" <%= filterStatus === 'all' ? 'selected' : '' %>>All</option>
              <option value="pending" <%= filterStatus === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="approved" <%= filterStatus === 'approved' ? 'selected' : '' %>>Approved</option>
              <option value="rejected" <%= filterStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
              <option value="active" <%= filterStatus === 'active' ? 'selected' : '' %>>Active</option>
            </select>
          </form>
        </div>
      </div>

      <!-- Exemptions List -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Customer Tax Exemptions</h3>
        </div>
        <div class="card-body p-0">
          <table class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Type</th>
                <th>Exemption #</th>
                <th>Business Name</th>
                <th>Scope</th>
                <th>Valid Period</th>
                <th>Status</th>
                <th width="180">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!exemptions || exemptions.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">No tax exemptions found.</td>
              </tr>
              <% } else { %>
                <% exemptions.forEach(function(ex) { %>
                <tr>
                  <td><%= ex.customerId || '—' %></td>
                  <td><span class="badge bg-info"><%= ex.type || '—' %></span></td>
                  <td><%= ex.exemptionNumber || '—' %></td>
                  <td><%= ex.businessName || '—' %></td>
                  <td>
                    <% if (ex.applicableTaxCategoryIds && ex.applicableTaxCategoryIds.length > 0) { %>
                      <small class="text-muted"><%= ex.applicableTaxCategoryIds.length %> categories</small>
                    <% } else { %>
                      <small class="text-muted">All categories</small>
                    <% } %>
                    <% if (ex.exemptionPercent && ex.exemptionPercent < 100) { %>
                      <br><small class="text-warning"><%= ex.exemptionPercent %>% partial</small>
                    <% } %>
                  </td>
                  <td>
                    <% if (ex.startDate) { %>
                      <small>From: <%= new Date(ex.startDate).toLocaleDateString() %></small>
                    <% } %>
                    <% if (ex.expiryDate) { %>
                      <br><small>To: <%= new Date(ex.expiryDate).toLocaleDateString() %></small>
                    <% } %>
                  </td>
                  <td>
                    <% if (ex.status === 'pending') { %>
                      <span class="badge bg-warning">Pending</span>
                    <% } else if (ex.status === 'approved' || ex.status === 'active') { %>
                      <span class="badge bg-success">Approved</span>
                    <% } else if (ex.status === 'rejected') { %>
                      <span class="badge bg-danger">Rejected</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= ex.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (ex.status === 'pending') { %>
                      <form method="POST" action="/hub/tax/exemptions/<%= ex.id %>/approve" class="d-inline">
                        <button type="submit" class="btn btn-success btn-sm" title="Approve">
                          <i class="fas fa-check"></i>
                        </button>
                      </form>
                      <form method="POST" action="/hub/tax/exemptions/<%= ex.id %>/reject" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" title="Reject"
                          onclick="return confirm('Reject this exemption?')">
                          <i class="fas fa-times"></i>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>
