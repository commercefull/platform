<%- include('../partials/header', { pageName, title: pageName }) %>
<%- include('../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <a href="/admin/tracking" class="btn btn-secondary btn-sm">Back</a>
</div>

<div class="card">
  <div class="card-body">
    <form method="POST" action="/admin/tracking">
      <div class="mb-3"><label class="form-label">Store ID *</label><input type="text" name="storeId" required class="form-control"></div>
      <div class="mb-3"><label class="form-label">Organization ID *</label><input type="text" name="organizationId" required class="form-control"></div>
      <div class="mb-3 form-check"><input type="checkbox" name="useDefaultMappings" checked class="form-check-input"><label class="form-check-label">Use Default Mappings</label></div>
      <div class="mb-3 form-check"><input type="checkbox" name="hashPii" class="form-check-input"><label class="form-check-label">Hash PII</label></div>
      <div class="mb-3 form-check"><input type="checkbox" name="serverSideEnabled" class="form-check-input"><label class="form-check-label">Server-Side Tracking</label></div>
      <button type="submit" class="btn btn-primary">Create Config</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
