<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Theme Preview</title>
  <% if (typeof headTags !== 'undefined' && headTags) { %>
    <% headTags.forEach(tag => { %>
      <%- tag %>
    <% }); %>
  <% } %>
  <style>
    :root {
      <% if (typeof cssVariables !== 'undefined' && cssVariables) { %>
        <% Object.entries(cssVariables).forEach(([key, val]) => { %>
          <%= key %>: <%= val %>;
        <% }); %>
      <% } else if (typeof settings !== 'undefined' && settings) { %>
        --color-primary: <%= settings.primaryColor || '#007bff' %>;
        --color-secondary: <%= settings.secondaryColor || '#6c757d' %>;
        --color-accent: <%= settings.accentColor || '#28a745' %>;
        --color-bg: <%= settings.backgroundColor || '#ffffff' %>;
        --color-text: <%= settings.textColor || '#212529' %>;
        --color-header-bg: <%= settings.headerBgColor || '#f8f9fa' %>;
        --color-footer-bg: <%= settings.footerBgColor || '#f8f9fa' %>;
        --font-heading: <%= settings.headingFont || 'Inter, sans-serif' %>;
        --font-body: <%= settings.bodyFont || 'Inter, sans-serif' %>;
        --font-size-base: <%= settings.baseFontSize || 16 %>px;
        --container-max-width: <%= settings.containerMaxWidth || '1280px' %>;
        --header-height: <%= settings.headerHeight || 64 %>px;
        --card-border-radius: <%= settings.cardBorderRadius || 8 %>px;
      <% } %>
    }
    <% if (typeof customCss !== 'undefined' && customCss) { %>
      <%- customCss %>
    <% } %>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font-body, -apple-system, sans-serif); font-size: var(--font-size-base, 16px); background: var(--color-bg, #fff); color: var(--color-text, #333); line-height: 1.6; }
    .preview-banner { background: #333; color: #fff; padding: 6px 16px; text-align: center; font-size: 11px; position: sticky; top: 0; z-index: 100; }
    .preview-header { background: var(--color-header-bg, #f8f9fa); border-bottom: 1px solid #e9ecef; position: sticky; top: 28px; z-index: 99; }
    .preview-header-inner { max-width: var(--container-max-width, 1200px); margin: 0 auto; padding: 0 16px; height: var(--header-height, 64px); display: flex; align-items: center; justify-content: space-between; }
    .preview-logo { font-family: var(--font-heading, inherit); font-size: 20px; font-weight: 700; color: var(--color-primary, #007bff); }
    .preview-nav { display: flex; gap: 20px; }
    .preview-nav a { color: var(--color-text, #333); text-decoration: none; font-size: 14px; }
    .preview-nav a:hover { color: var(--color-primary, #007bff); }
    .preview-search { padding: 6px 12px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 13px; }
    .preview-container { max-width: var(--container-max-width, 1200px); margin: 0 auto; padding: 24px 16px; }
    .preview-hero { background: var(--color-primary, #007bff); color: #fff; padding: 48px; border-radius: var(--card-border-radius, 8px); margin-bottom: 32px; text-align: center; }
    .preview-hero h1 { font-family: var(--font-heading, inherit); font-size: 36px; margin-bottom: 8px; }
    .preview-hero p { font-size: 16px; opacity: 0.9; margin-bottom: 20px; }
    .preview-hero .btn { display: inline-block; padding: 12px 32px; background: #fff; color: var(--color-primary, #007bff); border-radius: 6px; text-decoration: none; font-weight: 600; }
    .preview-section-title { font-family: var(--font-heading, inherit); font-size: 24px; margin-bottom: 16px; }
    .preview-product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px; }
    .preview-product-card { border: 1px solid #e9ecef; border-radius: var(--card-border-radius, 8px); padding: 12px; text-align: center; transition: box-shadow 0.2s; }
    .preview-product-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
    .preview-product-card .img { width: 100%; aspect-ratio: 1; background: #f1f3f5; border-radius: 4px; margin-bottom: 8px; }
    .preview-product-card .name { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
    .preview-product-card .price { color: var(--color-primary, #007bff); font-weight: 700; font-size: 14px; }
    .preview-product-card .badge { display: inline-block; background: var(--color-accent, #28a745); color: #fff; font-size: 10px; padding: 2px 6px; border-radius: 3px; margin-bottom: 4px; }
    .preview-footer { background: var(--color-footer-bg, #f8f9fa); border-top: 1px solid #e9ecef; padding: 24px 16px; margin-top: 40px; }
    .preview-footer-inner { max-width: var(--container-max-width, 1200px); margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .preview-footer h4 { font-family: var(--font-heading, inherit); font-size: 14px; margin-bottom: 8px; }
    .preview-footer a { display: block; color: var(--color-text, #333); text-decoration: none; font-size: 12px; margin-bottom: 4px; }
    .preview-footer-bottom { text-align: center; padding: 12px; font-size: 11px; color: #adb5bd; border-top: 1px solid #e9ecef; }
  </style>
</head>
<body<% if (typeof bodyAttributes !== 'undefined' && bodyAttributes) { %><% Object.entries(bodyAttributes).forEach(([key, val]) => { %> <%= key %>="<%= val %>"<% }); %><% } %>>
  <div class="preview-banner">Theme Preview — <%= title %></div>

  <!-- Header -->
  <div class="preview-header">
    <div class="preview-header-inner">
      <div class="preview-logo">
        <% if (typeof customLogoUrl !== 'undefined' && customLogoUrl) { %>
          <img src="<%= customLogoUrl %>" style="max-height:32px;">
        <% } else { %>
          <%= theme.name %>
        <% } %>
      </div>
      <nav class="preview-nav">
        <a href="#">Home</a>
        <a href="#">Shop</a>
        <a href="#">Categories</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
      </nav>
      <div class="d-flex align-items-center gap-2">
        <input class="preview-search" placeholder="Search products...">
        <span style="font-size:18px;">🛒</span>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="preview-container">
    <!-- Hero Banner -->
    <div class="preview-hero">
      <h1>Welcome to Our Store</h1>
      <p>Discover amazing products tailored just for you</p>
      <a href="#" class="btn">Shop Now</a>
    </div>

    <!-- Products -->
    <h2 class="preview-section-title">Featured Products</h2>
    <div class="preview-product-grid" id="product-grid">
      <% for (let i = 0; i < 8; i++) { %>
        <div class="preview-product-card">
          <% if (i % 3 === 0) { %><div class="badge">SALE</div><% } %>
          <div class="img"></div>
          <div class="name">Product <%= i+1 %></div>
          <div class="price">$<%= (i+1) * 29 %>.99</div>
        </div>
      <% } %>
    </div>

    <!-- Categories -->
    <h2 class="preview-section-title">Shop by Category</h2>
    <div class="preview-product-grid">
      <% for (let i = 0; i < 4; i++) { %>
        <div class="preview-product-card">
          <div class="img" style="aspect-ratio:16/9;"></div>
          <div class="name">Category <%= i+1 %></div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Footer -->
  <div class="preview-footer">
    <div class="preview-footer-inner">
      <div>
        <h4>Customer Service</h4>
        <a href="#">Contact Us</a>
        <a href="#">Shipping</a>
        <a href="#">Returns</a>
      </div>
      <div>
        <h4>About</h4>
        <a href="#">Our Story</a>
        <a href="#">Careers</a>
        <a href="#">Blog</a>
      </div>
      <div>
        <h4>Legal</h4>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
      </div>
    </div>
  </div>
  <div class="preview-footer-bottom">
    &copy; 2026 Store Name. Powered by CommerceFull.
  </div>

  <script>
    // Adjust product grid columns based on theme settings
    const grid = document.getElementById('product-grid');
    <% if (typeof settings !== 'undefined' && settings && settings.productsPerRow) { %>
      grid.style.gridTemplateColumns = `repeat(${<%= settings.productsPerRow %>}, 1fr)`;
    <% } %>
  </script>
</body>
</html>
