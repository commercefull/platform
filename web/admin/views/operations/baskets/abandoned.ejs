<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('shared:common.abandonedCarts') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><%= t('shared:common.operations') %></li>
            <li class="breadcrumb-item active"><%= t('shared:common.abandonedCarts') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Stats Cards -->
      <div class="row mb-4">
        <div class="col-lg-3 col-6">
          <div class="small-box bg-warning">
            <div class="inner">
              <h3><%= stats.totalAbandoned %></h3>
              <p><%= t('shared:common.abandonedCarts') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-shopping-cart"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-danger">
            <div class="inner">
              <h3><%= stats.totalExpired %></h3>
              <p><%= t('operations:expiredCarts') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-clock"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-success">
            <div class="inner">
              <h3><%= stats.recoveryPotential.toFixed(2) %></h3>
              <p><%= t('operations:recoveryValue') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-dollar-sign"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-info">
            <div class="inner">
              <h3><%= stats.avgCartValue.toFixed(2) %></h3>
              <p><%= t('operations:avgCartValue') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-chart-line"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="row mb-3">
        <div class="col-md-12">
          <div class="card">
            <div class="card-body">
              <form method="GET" class="form-inline">
                <div class="form-group mr-3">
                  <label for="days" class="mr-2"><%= t('operations:abandonedFor') %></label>
                  <select name="days" id="days" class="form-control">
                    <option value="1" <%= filters.olderThanDays === 1 ? 'selected' : '' %>>1 day</option>
                    <option value="3" <%= filters.olderThanDays === 3 ? 'selected' : '' %>>3 days</option>
                    <option value="7" <%= filters.olderThanDays === 7 ? 'selected' : '' %>>7 days</option>
                    <option value="14" <%= filters.olderThanDays === 14 ? 'selected' : '' %>>14 days</option>
                    <option value="30" <%= filters.olderThanDays === 30 ? 'selected' : '' %>>30 days</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-secondary mr-2">
                  <i class="fas fa-filter"></i> <%= t('common.filter') %>
                </button>
                <a href="/admin/baskets/abandoned" class="btn btn-outline-secondary">
                  <i class="fas fa-times"></i> <%= t('common.clear') %>
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Abandoned Carts Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('operations:abandonedShoppingCarts') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('operations:cartId') %></th>
                <th><%= t('shared:common.items') %></th>
                <th><%= t('operations:cartValue') %></th>
                <th><%= t('operations:lastActivity') %></th>
                <th><%= t('operations:daysAbandoned') %></th>
                <th><%= t('shared:common.customer') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (abandonedBaskets.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-4">
                    <em><%= t('operations:noAbandonedCarts') %></em>
                  </td>
                </tr>
              <% } else { %>
                <% abandonedBaskets.forEach(basket => { %>
                  <% const cartValue = basket.items.reduce((total, item) => total + (item.unitPrice.amount * item.quantity), 0); %>
                  <% const daysAbandoned = Math.floor((Date.now() - basket.lastActivityAt.getTime()) / (1000 * 60 * 60 * 24)); %>
                  <tr>
                    <td>
                      <code><%= basket.basketId.substring(0, 8) %>...</code>
                    </td>
                    <td>
                      <%= basket.items.length %> item<%= basket.items.length > 1 ? 's' : '' %>
                      <% if (basket.items.length > 0) { %>
                        <br><small class="text-muted"><%= basket.items[0].name %><%= basket.items.length > 1 ? ` +${basket.items.length - 1} more` : '' %></small>
                      <% } %>
                    </td>
                    <td>
                      <strong><%= basket.currency %> <%= cartValue.toFixed(2) %></strong>
                    </td>
                    <td>
                      <%= basket.lastActivityAt.toLocaleDateString() %>
                      <br><small class="text-muted"><%= basket.lastActivityAt.toLocaleTimeString() %></small>
                    </td>
                    <td>
                      <% if (daysAbandoned <= 1) { %>
                        <span class="badge badge-success"><%= daysAbandoned %> day</span>
                      <% } else if (daysAbandoned <= 7) { %>
                        <span class="badge badge-warning"><%= daysAbandoned %> days</span>
                      <% } else { %>
                        <span class="badge badge-danger"><%= daysAbandoned %> days</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (basket.customerId) { %>
                        Customer: <%= basket.customerId.substring(0, 8) %>...
                      <% } else { %>
                        <span class="text-muted"><%= t('shared:common.guest') %></span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/baskets/abandoned/<%= basket.basketId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i> <%= t('shared:common.view') %>
                      </a>
                      <button class="btn btn-sm btn-primary" onclick="recoverCart('<%= basket.basketId %>')">
                        <i class="fas fa-envelope"></i> <%= t('operations:recover') %>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Expired Carts Section -->
      <% if (expiredBaskets.length > 0) { %>
        <div class="card mt-4">
          <div class="card-header">
            <h3 class="card-title"><%= t('operations:expiredCartsCleanup') %></h3>
          </div>
          <div class="card-body">
            <p class="text-muted">
              <%= t('operations:expiredCartsCleanupHint') %>
              <button class="btn btn-sm btn-danger ml-2" onclick="cleanupExpired()">
                <i class="fas fa-trash"></i> <%= t('operations:cleanUpExpiredCarts') %>
              </button>
            </p>
            <div class="table-responsive">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th><%= t('operations:cartId') %></th>
                    <th><%= t('shared:common.items') %></th>
                    <th><%= t('shared:common.expired') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% expiredBaskets.slice(0, 5).forEach(basket => { %>
                    <tr>
                      <td><code><%= basket.basketId.substring(0, 8) %>...</code></td>
                      <td><%= basket.items.length %> item<%= basket.items.length > 1 ? 's' : '' %></td>
                      <td><%= basket.expiresAt ? basket.expiresAt.toLocaleDateString() : 'N/A' %></td>
                    </tr>
                  <% }); %>
                  <% if (expiredBaskets.length > 5) { %>
                    <tr>
                      <td colspan="3" class="text-center text-muted">
                        ... <%= t('operations:andMoreExpiredCarts') %> <%= expiredBaskets.length - 5 %>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </section>
</div>

<!-- Recovery Modal -->
<div class="modal fade" id="recoveryModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('operations:recoverAbandonedCart') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form id="recoveryForm">
          <div class="form-group">
            <label for="recoveryMethod"><%= t('operations:recoveryMethod') %></label>
            <select class="form-control" id="recoveryMethod" name="recoveryMethod" required>
              <option value="email"><%= t('operations:sendRecoveryEmail') %></option>
              <option value="discount"><%= t('operations:applyDiscountCode') %></option>
              <option value="reminder"><%= t('operations:sendReminderSms') %></option>
            </select>
          </div>
          <div class="form-group">
            <label for="message"><%= t('operations:messageOptional') %></label>
            <textarea class="form-control" id="message" name="message" rows="3" placeholder="<%= t('operations:messagePlaceholder') %>"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-primary" id="confirmRecoveryBtn"><%= t('operations:sendRecovery') %></button>
      </div>
    </div>
  </div>
</div>

<script>
let currentCartId = null;

function recoverCart(cartId) {
  currentCartId = cartId;
  $('#recoveryModal').modal('show');
}

document.getElementById('confirmRecoveryBtn').onclick = function() {
  const form = document.getElementById('recoveryForm');
  const formData = new FormData(form);

  fetch(`/admin/baskets/abandoned/${currentCartId}/recover`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
    },
    body: new URLSearchParams(formData)
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      $('#recoveryModal').modal('hide');
      alert('<%= t('operations:recoverySuccess') %>');
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('operations:errorSendingRecovery') %>');
    console.error('Error:', error);
  });
};

function cleanupExpired() {
  if (confirm('<%= t('operations:confirmCleanupExpired') %>')) {
    fetch('/admin/baskets/cleanup-expired', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert(`${data.deletedCount} <%= t('operations:cleanupSuccess') %>`);
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t('operations:errorCleaningUp') %>');
      console.error('Error:', error);
    });
  }
}
</script>
<% endcontent %>
