<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto">
      <a href="/admin/automation/<%= rule.automationRuleId %>/edit" class="btn btn-outline-secondary me-2"><i class="ti ti-edit"></i> <%= t('common.edit') %></a>
      <a href="/admin/automation" class="btn btn-secondary"><i class="ti ti-arrow-left"></i> <%= t('common.back') %></a>
    </div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include("../../partials/alerts") %>
    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t('common.details') %></h3></div>
          <div class="card-body">
            <dl class="row">
              <dt class="col-sm-4"><%= t('common.name') %></dt><dd class="col-sm-8"><%= rule.name || '-' %></dd>
              <dt class="col-sm-4"><%= t('common.description') %></dt><dd class="col-sm-8"><%= rule.description || '-' %></dd>
              <dt class="col-sm-4">Trigger Type</dt><dd class="col-sm-8"><span class="badge bg-info"><%= rule.triggerType %></span></dd>
              <dt class="col-sm-4">Trigger Config</dt><dd class="col-sm-8"><code><%= JSON.stringify(rule.triggerConfig || {}) %></code></dd>
              <dt class="col-sm-4">Condition Match Mode</dt><dd class="col-sm-8"><%= rule.conditionMatchMode || 'all' %></dd>
              <dt class="col-sm-4">Action Execution Mode</dt><dd class="col-sm-8"><%= rule.actionExecutionMode || 'sequential' %></dd>
              <dt class="col-sm-4"><%= t('common.status') %></dt><dd class="col-sm-8"><span class="badge bg-<%= rule.isActive ? 'success' : 'secondary' %>"><%= rule.isActive ? t('common.active') : t('common.inactive') %></span></dd>
              <dt class="col-sm-4"><%= t('common.priority') %></dt><dd class="col-sm-8"><%= rule.priority ?? 0 %></dd>
              <dt class="col-sm-4">Execution Count</dt><dd class="col-sm-8"><%= rule.executionCount || 0 %></dd>
              <dt class="col-sm-4">Success Count</dt><dd class="col-sm-8"><span class="text-success"><%= rule.successCount || 0 %></span></dd>
              <dt class="col-sm-4">Failure Count</dt><dd class="col-sm-8"><span class="text-danger"><%= rule.failureCount || 0 %></span></dd>
              <dt class="col-sm-4">Last Triggered</dt><dd class="col-sm-8"><%= rule.lastTriggeredAt ? new Date(rule.lastTriggeredAt).toLocaleString() : t('common.never') %></dd>
              <dt class="col-sm-4"><%= t('common.dateCreated') %></dt><dd class="col-sm-8"><%= rule.createdAt ? new Date(rule.createdAt).toLocaleString() : '-' %></dd>
            </dl>
          </div>
        </div>
        <div class="card mt-3">
          <div class="card-header"><h3 class="card-title">Conditions</h3></div>
          <div class="card-body">
            <% if (rule.conditions && rule.conditions.length > 0) { %>
              <table class="table table-sm">
                <thead><tr><th>Field</th><th>Operator</th><th>Value</th></tr></thead>
                <tbody>
                  <% rule.conditions.forEach(c => { %>
                    <tr><td><code><%= c.field %></code></td><td><%= c.operator %></td><td><%= c.value !== undefined ? JSON.stringify(c.value) : (c.values ? JSON.stringify(c.values) : '-') %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <p class="text-muted">No conditions — rule fires on every trigger.</p>
            <% } %>
          </div>
        </div>
        <div class="card mt-3">
          <div class="card-header"><h3 class="card-title">Actions</h3></div>
          <div class="card-body">
            <table class="table table-sm">
              <thead><tr><th>Type</th><th>Config</th><th>Delay (ms)</th></tr></thead>
              <tbody>
                <% (rule.actions || []).forEach(a => { %>
                  <tr><td><span class="badge bg-primary"><%= a.type %></span></td><td><code><%= JSON.stringify(a.config || {}) %></code></td><td><%= a.delayMs || 0 %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t('common.actions') %></h3></div>
          <div class="card-body">
            <div class="d-grid gap-2">
              <% if (rule.isActive) { %>
                <form method="POST" action="/admin/automation/<%= rule.automationRuleId %>/deactivate">
                  <button type="submit" class="btn btn-outline-warning w-100"><%= t('common.deactivate') %></button>
                </form>
              <% } else { %>
                <form method="POST" action="/admin/automation/<%= rule.automationRuleId %>/activate">
                  <button type="submit" class="btn btn-outline-success w-100"><%= t('common.activate') %></button>
                </form>
              <% } %>
              <form method="POST" action="/admin/automation/<%= rule.automationRuleId %>/trigger">
                <button type="submit" class="btn btn-outline-primary w-100">Trigger Manually</button>
              </form>
              <form method="POST" action="/admin/automation/<%= rule.automationRuleId %>/delete" onsubmit="return confirm('Are you sure you want to delete this rule?')">
                <button type="submit" class="btn btn-outline-danger w-100"><%= t('common.delete') %></button>
              </form>
              <a href="/admin/automation" class="btn btn-outline-secondary"><%= t('common.backToList') %></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
