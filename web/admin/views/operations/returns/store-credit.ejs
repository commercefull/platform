<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto">
      <a href="/admin/returns" class="btn btn-secondary"><i class="ti ti-arrow-left"></i> <%= t('common.back') %></a>
    </div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include("../../partials/alerts") %>

    <% if (!customerId) { %>
      <div class="card">
        <div class="card-header"><h3 class="card-title">Lookup Customer Store Credit</h3></div>
        <div class="card-body">
          <form method="GET" action="/admin/returns/store-credit" class="row g-2">
            <div class="col-md-8">
              <input type="text" name="customerId" class="form-control" placeholder="Enter Customer ID" required>
            </div>
            <div class="col-md-4">
              <button type="submit" class="btn btn-primary w-100"><%= t('common.search') %></button>
            </div>
          </form>
        </div>
      </div>
    <% } else { %>
      <div class="row">
        <div class="col-md-4">
          <div class="card">
            <div class="card-header"><h3 class="card-title">Balance</h3></div>
            <div class="card-body">
              <% if (balance) { %>
                <div class="mb-3">
                  <h1 class="mb-0">$<%= Number(balance.balance || 0).toFixed(2) %></h1>
                  <small class="text-muted">Available Balance</small>
                </div>
                <dl class="row">
                  <dt class="col-sm-6">Total Credits</dt><dd class="col-sm-6">$<%= Number(balance.totalCredits || 0).toFixed(2) %></dd>
                  <dt class="col-sm-6">Total Debits</dt><dd class="col-sm-6">$<%= Number(balance.totalDebits || 0).toFixed(2) %></dd>
                  <dt class="col-sm-6">Pending Expiry</dt><dd class="col-sm-6">$<%= Number(balance.pendingExpiry || 0).toFixed(2) %></dd>
                </dl>
              <% } else { %>
                <p class="text-muted">No store credit data found for this customer.</p>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="card">
            <div class="card-header"><h3 class="card-title">Ledger Entries</h3></div>
            <div class="card-body p-0">
              <table class="table table-striped table-vcenter">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Balance After</th>
                    <th>Reference</th>
                    <th>Expires</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (ledger && ledger.length > 0) { %>
                    <% ledger.forEach(entry => { %>
                      <tr>
                        <td><%= entry.createdAt ? new Date(entry.createdAt).toLocaleDateString() : '-' %></td>
                        <td>
                          <% const typeColors = { credit: 'success', debit: 'danger', adjustment: 'warning', expiry: 'secondary' }; %>
                          <span class="badge bg-<%= typeColors[entry.entryType] || 'secondary' %>"><%= entry.entryType %></span>
                        </td>
                        <td class="text-<%= entry.entryType === 'credit' || entry.entryType === 'adjustment' ? 'success' : 'danger' %>">
                          <%= entry.entryType === 'credit' ? '+' : '-' %>$<%= Number(entry.amount || 0).toFixed(2) %>
                        </td>
                        <td>$<%= Number(entry.balanceAfter || 0).toFixed(2) %></td>
                        <td><%= entry.reference || '-' %></td>
                        <td><%= entry.expiresAt ? new Date(entry.expiresAt).toLocaleDateString() : '-' %></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="6" class="text-center text-muted py-4"><%= t('common.noData') %></td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</section>
