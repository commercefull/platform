<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto">
      <a href="/admin/returns/store-credit" class="btn btn-outline-secondary me-2">Store Credit</a>
      <a href="/admin/returns/create" class="btn btn-primary"><i class="ti ti-plus"></i> <%= t('common.create') %></a>
    </div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include("../../partials/alerts") %>
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-striped table-vcenter">
          <thead>
            <tr>
              <th>Return #</th>
              <th>Order ID</th>
              <th>Type</th>
              <th><%= t('common.status') %></th>
              <th>Items</th>
              <th>Refund Amount</th>
              <th><%= t('common.dateCreated') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (returns && returns.length > 0) { %>
              <% returns.forEach(r => { %>
                <tr>
                  <td><%= r.returnNumber || '-' %></td>
                  <td><%= r.orderId || '-' %></td>
                  <td><span class="badge bg-info"><%= r.returnType %></span></td>
                  <td>
                    <% const statusColors = { requested: 'warning', approved: 'info', denied: 'danger', inTransit: 'primary', received: 'primary', inspected: 'primary', completed: 'success', cancelled: 'secondary' }; %>
                    <span class="badge bg-<%= statusColors[r.status] || 'secondary' %>"><%= r.status %></span>
                  </td>
                  <td><%= (r.items || []).length %></td>
                  <td><%= r.items ? r.items.reduce((sum, i) => sum + (i.refundAmount || 0), 0).toFixed(2) : '0.00' %></td>
                  <td><%= r.requestedAt ? new Date(r.requestedAt).toLocaleDateString() : '-' %></td>
                  <td><a href="/admin/returns/<%= r.orderReturnId %>" class="btn btn-sm btn-outline-primary"><%= t('common.view') %></a></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="8" class="text-center text-muted py-4"><%= t('common.noData') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
