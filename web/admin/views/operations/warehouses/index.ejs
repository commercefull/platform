<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('shared:common.warehouses') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><%= t('shared:common.operations') %></li>
            <li class="breadcrumb-item active"><%= t('shared:common.warehouses') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Stats Cards -->
      <div class="row mb-4">
        <div class="col-lg-3 col-6">
          <div class="small-box bg-info">
            <div class="inner">
              <h3><%= stats.total %></h3>
              <p><%= t('operations:totalWarehouses') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-warehouse"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-success">
            <div class="inner">
              <h3><%= stats.active %></h3>
              <p><%= t('operations:activeWarehouses') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-check-circle"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-warning">
            <div class="inner">
              <h3><%= stats.fulfillmentCenters %></h3>
              <p><%= t('operations:fulfillmentCenters') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-shipping-fast"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <a href="/admin/warehouses/create" class="small-box bg-primary">
            <div class="inner">
              <h3>+</h3>
              <p><%= t('operations:addWarehouse') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-plus"></i>
            </div>
          </a>
        </div>
      </div>

      <!-- Warehouses Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('operations:warehouseManagement') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('common.code') %></th>
                <th><%= t('common.name') %></th>
                <th><%= t('common.type') %></th>
                <th><%= t('shared:common.location') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('shared:common.default') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (warehouses.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-4">
                    <em><%= t('operations:noWarehouses') %> <a href="/admin/warehouses/create"><%= t('operations:createFirstWarehouse') %></a>.</em>
                  </td>
                </tr>
              <% } else { %>
                <% warehouses.forEach(warehouse => { %>
                  <tr>
                    <td>
                      <strong><code><%= warehouse.code %></code></strong>
                    </td>
                    <td>
                      <%= warehouse.name %>
                      <% if (warehouse.description) { %>
                        <br><small class="text-muted"><%= warehouse.description %></small>
                      <% } %>
                    </td>
                    <td>
                      <% if (warehouse.isVirtual) { %>
                        <span class="badge badge-info"><%= t('shared:common.virtual') %></span>
                      <% } else { %>
                        <span class="badge badge-primary"><%= t('operations:physical') %></span>
                      <% } %>
                      <% if (warehouse.isFulfillmentCenter) { %>
                        <br><small class="text-success"><%= t('shared:common.fulfillmentCenter') %></small>
                      <% } %>
                      <% if (warehouse.isReturnCenter) { %>
                        <br><small class="text-warning"><%= t('shared:common.returnCenter') %></small>
                      <% } %>
                    </td>
                    <td>
                      <%= warehouse.city %>, <%= warehouse.state %>
                      <br><small class="text-muted"><%= warehouse.country %></small>
                    </td>
                    <td>
                      <% if (warehouse.isActive) { %>
                        <span class="badge badge-success"><%= t('shared:common.active') %></span>
                      <% } else { %>
                        <span class="badge badge-secondary"><%= t('shared:common.inactive') %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (warehouse.isDefault) { %>
                        <span class="badge badge-primary"><%= t('shared:common.default') %></span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/warehouses/<%= warehouse.distributionWarehouseId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/warehouses/<%= warehouse.distributionWarehouseId %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% if (warehouse.isActive) { %>
                        <button class="btn btn-sm btn-warning" onclick="deactivateWarehouse('<%= warehouse.distributionWarehouseId %>')">
                          <i class="fas fa-pause"></i>
                        </button>
                      <% } else { %>
                        <button class="btn btn-sm btn-success" onclick="activateWarehouse('<%= warehouse.distributionWarehouseId %>')">
                          <i class="fas fa-play"></i>
                        </button>
                      <% } %>
                      <button class="btn btn-sm btn-danger" onclick="deleteWarehouse('<%= warehouse.distributionWarehouseId %>', '<%= warehouse.name %>')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('operations:deleteWarehouse') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('operations:confirmDeleteWarehouse') %> "<strong id="deleteWarehouseName"></strong>"?</p>
        <p class="text-danger"><small><%= t('operations:deleteWarehouseWarning') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('operations:deleteWarehouse') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function activateWarehouse(warehouseId) {
  fetch(`/admin/warehouses/${warehouseId}/activate`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('operations:errorActivating') %>');
    console.error('Error:', error);
  });
}

function deactivateWarehouse(warehouseId) {
  fetch(`/admin/warehouses/${warehouseId}/deactivate`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('operations:errorDeactivating') %>');
    console.error('Error:', error);
  });
}

function deleteWarehouse(warehouseId, warehouseName) {
  document.getElementById('deleteWarehouseName').textContent = warehouseName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/warehouses/${warehouseId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t('operations:errorDeletingWarehouse') %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}
</script>
<% endcontent %>
