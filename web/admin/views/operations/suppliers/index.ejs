<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('shared:common.suppliers') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><%= t('shared:common.operations') %></li>
            <li class="breadcrumb-item active"><%= t('shared:common.suppliers') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Stats Cards -->
      <div class="row mb-4">
        <div class="col-lg-3 col-6">
          <div class="small-box bg-info">
            <div class="inner">
              <h3><%= stats.total %></h3>
              <p><%= t('operations:totalSuppliers') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-building"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-success">
            <div class="inner">
              <h3><%= stats.active %></h3>
              <p><%= t('operations:activeSuppliers') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-check-circle"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-warning">
            <div class="inner">
              <h3><%= stats.pending %></h3>
              <p><%= t('operations:pendingApproval') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-clock"></i>
            </div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <a href="/admin/suppliers/create" class="small-box bg-primary">
            <div class="inner">
              <h3>+</h3>
              <p><%= t('operations:addSupplier') %></p>
            </div>
            <div class="icon">
              <i class="fas fa-plus"></i>
            </div>
          </a>
        </div>
      </div>

      <!-- Filters -->
      <div class="row mb-3">
        <div class="col-md-12">
          <div class="card">
            <div class="card-body">
              <form method="GET" class="form-inline">
                <div class="form-group mr-3">
                  <label for="status" class="mr-2"><%= t('common.status') %>:</label>
                  <select name="status" id="status" class="form-control">
                    <option value=""><%= t('shared:common.allStatus') %></option>
                    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= t('shared:common.active') %></option>
                    <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= t('shared:common.inactive') %></option>
                    <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>><%= t('shared:common.pending') %></option>
                    <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>><%= t('shared:common.suspended') %></option>
                    <option value="blacklisted" <%= filters.status === 'blacklisted' ? 'selected' : '' %>><%= t('operations:blacklisted') %></option>
                  </select>
                </div>
                <button type="submit" class="btn btn-secondary mr-2">
                  <i class="fas fa-filter"></i> <%= t('common.filter') %>
                </button>
                <a href="/admin/suppliers" class="btn btn-outline-secondary">
                  <i class="fas fa-times"></i> <%= t('common.clear') %>
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Suppliers Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('operations:supplierManagement') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('common.code') %></th>
                <th><%= t('common.name') %></th>
                <th><%= t('common.email') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('shared:common.rating') %></th>
                <th><%= t('common.currency') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (suppliers.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-4">
                    <em><%= t('operations:noSuppliers') %> <a href="/admin/suppliers/create"><%= t('operations:createFirstSupplier') %></a>.</em>
                  </td>
                </tr>
              <% } else { %>
                <% suppliers.forEach(supplier => { %>
                  <tr>
                    <td>
                      <strong><code><%= supplier.code %></code></strong>
                    </td>
                    <td>
                      <%= supplier.name %>
                      <% if (supplier.description) { %>
                        <br><small class="text-muted"><%= supplier.description %></small>
                      <% } %>
                    </td>
                    <td>
                      <% if (supplier.email) { %>
                        <a href="mailto:<%= supplier.email %>"><%= supplier.email %></a>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (supplier.status === 'active') { %>
                        <span class="badge badge-success"><%= t('shared:common.active') %></span>
                      <% } else if (supplier.status === 'pending') { %>
                        <span class="badge badge-warning"><%= t('shared:common.pending') %></span>
                      <% } else if (supplier.status === 'inactive') { %>
                        <span class="badge badge-secondary"><%= t('shared:common.inactive') %></span>
                      <% } else if (supplier.status === 'suspended') { %>
                        <span class="badge badge-danger"><%= t('shared:common.suspended') %></span>
                      <% } else if (supplier.status === 'blacklisted') { %>
                        <span class="badge badge-dark"><%= t('operations:blacklisted') %></span>
                      <% } else { %>
                        <span class="badge badge-light"><%= supplier.status %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (supplier.rating) { %>
                        <span class="text-warning">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <% if (i <= supplier.rating) { %>★<% } else { %>☆<% } %>
                          <% } %>
                        </span>
                        <small class="text-muted">(<%= supplier.rating %>)</small>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td><%= supplier.currency %></td>
                    <td>
                      <a href="/admin/suppliers/<%= supplier.supplierId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/suppliers/<%= supplier.supplierId %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% if (supplier.status === 'pending') { %>
                        <button class="btn btn-sm btn-success" onclick="approveSupplier('<%= supplier.supplierId %>')">
                          <i class="fas fa-check"></i> <%= t('shared:common.approve') %>
                        </button>
                      <% } else if (supplier.status === 'active') { %>
                        <button class="btn btn-sm btn-warning" onclick="suspendSupplier('<%= supplier.supplierId %>')">
                          <i class="fas fa-pause"></i> <%= t('operations:suspend') %>
                        </button>
                      <% } else if (supplier.status === 'suspended') { %>
                        <button class="btn btn-sm btn-success" onclick="activateSupplier('<%= supplier.supplierId %>')">
                          <i class="fas fa-play"></i> <%= t('shared:common.activate') %>
                        </button>
                      <% } %>
                      <button class="btn btn-sm btn-danger" onclick="deleteSupplier('<%= supplier.supplierId %>', '<%= supplier.name %>')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('operations:deleteSupplier') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('operations:confirmDeleteSupplier') %> "<strong id="deleteSupplierName"></strong>"?</p>
        <p class="text-danger"><small><%= t('shared:common.thisActionCannotBeUndone') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('operations:deleteSupplier') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function approveSupplier(supplierId) {
  fetch(`/admin/suppliers/${supplierId}/approve`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('operations:errorApprovingSupplier') %>');
    console.error('Error:', error);
  });
}

function suspendSupplier(supplierId) {
  fetch(`/admin/suppliers/${supplierId}/suspend`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('operations:errorSuspendingSupplier') %>');
    console.error('Error:', error);
  });
}

function activateSupplier(supplierId) {
  fetch(`/admin/suppliers/${supplierId}/activate`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('operations:errorActivatingSupplier') %>');
    console.error('Error:', error);
  });
}

function deleteSupplier(supplierId, supplierName) {
  document.getElementById('deleteSupplierName').textContent = supplierName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/suppliers/${supplierId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t('operations:errorDeletingSupplier') %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}
</script>
<% endcontent %>
