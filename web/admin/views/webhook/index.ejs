<%- include('../partials/header', { pageName, title: pageName }) %>
<%- include('../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <a href="/admin/webhooks/create" class="btn btn-primary btn-sm">Create Webhook</a>
</div>

<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-striped table-sm">
      <thead><tr><th>Name</th><th>URL</th><th>Events</th><th>Active</th><th>Actions</th></tr></thead>
      <tbody>
        <% endpoints.forEach(function(e) { %>
        <tr>
          <td><a href="/admin/webhooks/<%= e.webhookEndpointId %>"><%= e.name %></a></td>
          <td><code><%= (e.url || '').substring(0, 50) %>...</code></td>
          <td><%= (e.events || []).length %> events</td>
          <td><%= e.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>' %></td>
          <td>
            <a href="/admin/webhooks/<%= e.webhookEndpointId %>" class="btn btn-info btn-sm">View</a>
            <a href="/admin/webhooks/<%= e.webhookEndpointId %>/edit" class="btn btn-warning btn-sm">Edit</a>
          </td>
        </tr>
        <% }); %>
        <% if (!endpoints || endpoints.length === 0) { %>
        <tr><td colspan="5" class="text-center text-muted">No webhook endpoints found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
