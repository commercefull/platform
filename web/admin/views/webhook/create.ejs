<%- include('../partials/header', { pageName, title: pageName }) %>
<%- include('../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <a href="/admin/webhooks" class="btn btn-secondary btn-sm">Back</a>
</div>

<div class="card">
  <div class="card-body">
    <form method="POST" action="/admin/webhooks">
      <div class="mb-3"><label class="form-label">Name *</label><input type="text" name="name" required class="form-control"></div>
      <div class="mb-3"><label class="form-label">URL *</label><input type="url" name="url" required class="form-control" placeholder="https://..."></div>
      <div class="mb-3">
        <label class="form-label">Events *</label>
        <div class="row">
          <% availableEvents.forEach(function(ev) { %>
          <div class="col-md-4 mb-1">
            <div class="form-check">
              <input type="checkbox" name="events" value="<%= ev %>" class="form-check-input" id="ev_<%= ev %>">
              <label class="form-check-label" for="ev_<%= ev %>"><%= ev %></label>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <div class="mb-3"><label class="form-label">Custom Headers (JSON)</label><textarea name="headers" class="form-control" rows="3" placeholder='{"X-Custom":"value"}'></textarea></div>
      <button type="submit" class="btn btn-primary">Create Webhook</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
