<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-warehouse me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/hub"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item">Inventory</li>
            <li class="breadcrumb-item active">Allocation Rules</li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-check-circle me-2"></i><%= success %>
      </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
      </div>
      <% } %>

      <!-- Create Allocation Rule -->
      <div class="card card-primary">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-plus me-2"></i>Create Allocation Rule</h3>
        </div>
        <form method="POST" action="/hub/inventory/allocation-rules">
          <div class="card-body">
            <div class="row">
              <div class="col-md-4 mb-3">
                <label class="form-label">Rule Name</label>
                <input type="text" class="form-control" name="name" required>
              </div>
              <div class="col-md-3 mb-3">
                <label class="form-label">Scope</label>
                <select class="form-select" name="scope">
                  <option value="global" selected>Global</option>
                  <option value="pool">Pool</option>
                  <option value="category">Category</option>
                  <option value="product">Product</option>
                </select>
              </div>
              <div class="col-md-3 mb-3">
                <label class="form-label">Allocation Strategy</label>
                <select class="form-select" name="allocationStrategy">
                  <option value="fifo" selected>FIFO (First In, First Out)</option>
                  <option value="lifo">LIFO (Last In, First Out)</option>
                  <option value="nearest">Nearest Location</option>
                  <option value="even_split">Even Split</option>
                  <option value="priority">Priority-Based</option>
                </select>
              </div>
              <div class="col-md-2 mb-3">
                <label class="form-label">Priority</label>
                <input type="number" class="form-control" name="priority" value="0" min="0">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea class="form-control" name="description" rows="2"></textarea>
            </div>

            <div class="row">
              <div class="col-md-3 mb-3">
                <label class="form-label">Reservation Policy</label>
                <select class="form-select" name="reservationPolicy">
                  <option value="immediate" selected>Immediate</option>
                  <option value="deferred">Deferred</option>
                </select>
              </div>
              <div class="col-md-3 mb-3">
                <label class="form-label">Low Stock Threshold</label>
                <input type="number" class="form-control" name="lowStockThreshold" value="0" min="0">
              </div>
              <div class="col-md-3 mb-3">
                <label class="form-label">Oversell Buffer</label>
                <input type="number" class="form-control" name="oversellBuffer" value="0" min="0">
              </div>
              <div class="col-md-3 mb-3">
                <label class="form-label">Max Allocation Per Order</label>
                <input type="number" class="form-control" name="maxAllocationPerOrder" value="0" min="0">
              </div>
            </div>

            <div class="row">
              <div class="col-md-3 mb-3">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" name="allowBackorder" value="true">
                  <label class="form-check-label">Allow Backorder</label>
                </div>
              </div>
              <div class="col-md-3 mb-3">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" name="allowOversell" value="true">
                  <label class="form-check-label">Allow Oversell</label>
                </div>
              </div>
              <div class="col-md-3 mb-3">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" name="isActive" value="true" checked>
                  <label class="form-check-label">Active</label>
                </div>
              </div>
            </div>

            <h5 class="mt-3 mb-2">Conditions (optional)</h5>
            <p class="text-muted small">Define conditions that must match for this allocation rule to apply.</p>
            <%- include('../partials/condition-builder', {
              fieldName: 'conditions',
              conditions: [],
              attributes: [
                { value: 'orderTotal', label: 'Order Total' },
                { value: 'itemQuantity', label: 'Item Quantity' },
                { value: 'customerRegion', label: 'Customer Region' },
                { value: 'productSku', label: 'Product SKU' },
                { value: 'channel', label: 'Sales Channel' }
              ]
            }) %>
          </div>
          <div class="card-footer">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save me-1"></i>Create Rule
            </button>
          </div>
        </form>
      </div>

      <!-- Existing Rules -->
      <div class="card mt-3">
        <div class="card-header">
          <h3 class="card-title">Existing Allocation Rules</h3>
        </div>
        <div class="card-body p-0">
          <table class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Scope</th>
                <th>Strategy</th>
                <th>Reservation</th>
                <th>Backorder</th>
                <th>Oversell</th>
                <th>Max/Order</th>
                <th>Priority</th>
                <th>Active</th>
                <th width="80">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!rules || rules.length === 0) { %>
              <tr><td colspan="10" class="text-center text-muted py-4">No allocation rules configured.</td></tr>
              <% } else { %>
                <% rules.forEach(function(rule) { %>
                <tr>
                  <td><%= rule.name || '—' %></td>
                  <td><span class="badge bg-info"><%= rule.scope || '—' %></span></td>
                  <td><%= rule.allocationStrategy || '—' %></td>
                  <td><%= rule.reservationPolicy || '—' %></td>
                  <td>
                    <% if (rule.allowBackorder) { %>
                      <i class="fas fa-check text-success"></i>
                    <% } else { %>
                      <i class="fas fa-times text-danger"></i>
                    <% } %>
                  </td>
                  <td>
                    <% if (rule.allowOversell) { %>
                      <i class="fas fa-check text-success"></i>
                    <% } else { %>
                      <i class="fas fa-times text-danger"></i>
                    <% } %>
                  </td>
                  <td><%= rule.maxAllocationPerOrder || 0 %></td>
                  <td><%= rule.priority || 0 %></td>
                  <td>
                    <% if (rule.isActive) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td>
                    <button class="btn btn-outline-danger btn-sm" onclick="deleteRule('<%= rule.inventoryAllocationRuleId %>')">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  async function deleteRule(ruleId) {
    if (!confirm('Delete this allocation rule?')) return;
    try {
      const resp = await fetch('/hub/inventory/allocation-rules/' + ruleId, { method: 'DELETE' });
      const result = await resp.json();
      if (result.success) {
        location.reload();
      } else {
        alert(result.error || 'Failed to delete rule');
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  }
</script>

<%- include('../partials/footer') %>
