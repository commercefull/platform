<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>

  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include("../partials/alerts") %>
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-striped table-vcenter">
          <thead><tr><th><%= t('common.name') %></th><th><%= t('common.status') %></th><th><%= t('common.actions') %></th></tr></thead>
          <tbody>
            <% if (tickets && tickets.length > 0) { %>
              <% tickets.forEach(item => { %>
                <tr>
                  <td><%= item.subject || item.name || '-' %></td>
                  <td><span class="badge bg-<%= item.status === 'active' || item.isActive ? 'success' : 'secondary' %>"><%= item.status || (item.isActive ? t('common.active') : t('common.inactive')) %></span></td>
                  <td><a href="<%= item.supportTicketId %>" class="btn btn-sm btn-outline-primary"><%= t('common.view') %></a></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="10" class="text-center text-muted py-4"><%= t('common.noData') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
