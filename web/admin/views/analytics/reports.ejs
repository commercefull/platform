<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-file-alt me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin/analytics"><%= t('shared:common.analytics') %></a></li>
            <li class="breadcrumb-item active"><%= t('analytics:reports') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <!-- Quick Report Generation -->
      <div class="row">
        <div class="col-12">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-play me-2"></i><%= t('analytics:generateReportNow') %></h3>
            </div>
            <div class="card-body">
              <form id="generateReportForm">
                <div class="row">
                  <div class="col-md-3">
                    <div class="form-group">
                      <label><%= t('shared:common.reportType') %></label>
                      <select class="form-control" name="reportType" required>
                        <option value="sales"><%= t('analytics:salesReport') %></option>
                        <option value="customers"><%= t('analytics:customerReport') %></option>
                        <option value="products"><%= t('analytics:productReport') %></option>
                        <option value="inventory"><%= t('shared:common.inventory') %></option>
                        <option value="executive"><%= t('analytics:executive') %></option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label><%= t('shared:common.period') %></label>
                      <select class="form-control" name="period">
                        <option value="7d"><%= t('analytics:last7Days') %></option>
                        <option value="30d" selected><%= t('analytics:last30Days') %></option>
                        <option value="90d"><%= t('analytics:last90Days') %></option>
                        <option value="1y"><%= t('analytics:lastYear') %></option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label><%= t('shared:common.format') %></label>
                      <select class="form-control" name="format">
                        <option value="html">HTML</option>
                        <option value="pdf">PDF</option>
                        <option value="excel">Excel</option>
                        <option value="csv">CSV</option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label>&nbsp;</label>
                      <button type="submit" class="btn btn-primary btn-block w-100">
                        <i class="fas fa-file-download me-2"></i><%= t('analytics:generate') %>
                      </button>
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Scheduled Reports -->
      <div class="row">
        <div class="col-lg-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-clock me-2"></i><%= t('shared:common.scheduledReports') %></h3>
              <div class="card-tools">
                <button type="button" class="btn btn-tool" data-bs-toggle="modal" data-bs-target="#newScheduleModal">
                  <i class="fas fa-plus"></i>
                </button>
              </div>
            </div>
            <div class="card-body table-responsive p-0">
              <table class="table table-hover text-nowrap">
                <thead>
                  <tr>
                    <th><%= t('analytics:reportName') %></th>
                    <th><%= t('shared:common.reportType') %></th>
                    <th><%= t('shared:common.frequency') %></th>
                    <th><%= t('common.status') %></th>
                    <th><%= t('common.actions') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% (reports || []).forEach(function(report) { %>
                  <tr>
                    <td><%= report.name %></td>
                    <td><%= report.reportType %></td>
                    <td><%= report.type %></td>
                    <td>
                      <span class="badge bg-<%= report.isActive ? 'success' : 'secondary' %>">
                        <%= report.isActive ? t('common.active') : t('shared:common.paused') %>
                      </span>
                    </td>
                    <td>
                      <button class="btn btn-sm btn-outline-primary"><i class="fas fa-play"></i></button>
                      <button class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit"></i></button>
                      <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                  <% }); %>
                  <% if ((reports || []).length === 0) { %>
                  <tr>
                    <td colspan="5" class="text-center text-muted">
                      <%= t('analytics:noScheduledReports') %>
                    </td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-history me-2"></i><%= t('analytics:reportHistory') %></h3>
            </div>
            <div class="card-body table-responsive p-0">
              <table class="table table-hover text-nowrap">
                <thead>
                  <tr>
                    <th><%= t('analytics:report') %></th>
                    <th><%= t('analytics:generated') %></th>
                    <th><%= t('common.status') %></th>
                    <th><%= t('common.actions') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% (reportHistory || []).forEach(function(execution) { %>
                  <tr>
                    <td><%= execution.reportScheduleId.slice(-8) %></td>
                    <td><%= new Date(execution.startedAt).toLocaleString() %></td>
                    <td>
                      <span class="badge bg-<%= execution.status === 'completed' ? 'success' : execution.status === 'failed' ? 'danger' : 'warning' %>">
                        <%= execution.status %>
                      </span>
                    </td>
                    <td>
                      <% if (execution.fileUrl) { %>
                      <a href="<%= execution.fileUrl %>" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-download"></i>
                      </a>
                      <% } %>
                    </td>
                  </tr>
                  <% }); %>
                  <% if ((reportHistory || []).length === 0) { %>
                  <tr>
                    <td colspan="4" class="text-center text-muted">
                      <%= t('analytics:noReportHistory') %>
                    </td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Report Templates -->
      <div class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-file-invoice me-2"></i><%= t('analytics:reportTemplates') %></h3>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-3">
                  <div class="card card-outline card-primary">
                    <div class="card-body text-center">
                      <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
                      <h5><%= t('analytics:salesReport') %></h5>
                      <p class="text-muted small"><%= t('analytics:salesReportDesc') %></p>
                      <button class="btn btn-primary btn-sm" onclick="generateReport('sales')"><%= t('analytics:generate') %></button>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="card card-outline card-success">
                    <div class="card-body text-center">
                      <i class="fas fa-users fa-3x text-success mb-3"></i>
                      <h5><%= t('analytics:customerReport') %></h5>
                      <p class="text-muted small"><%= t('analytics:customerReportDesc') %></p>
                      <button class="btn btn-success btn-sm" onclick="generateReport('customers')"><%= t('analytics:generate') %></button>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="card card-outline card-warning">
                    <div class="card-body text-center">
                      <i class="fas fa-box fa-3x text-warning mb-3"></i>
                      <h5><%= t('analytics:productReport') %></h5>
                      <p class="text-muted small"><%= t('analytics:productReportDesc') %></p>
                      <button class="btn btn-warning btn-sm" onclick="generateReport('products')"><%= t('analytics:generate') %></button>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="card card-outline card-danger">
                    <div class="card-body text-center">
                      <i class="fas fa-briefcase fa-3x text-danger mb-3"></i>
                      <h5><%= t('analytics:executive') %></h5>
                      <p class="text-muted small"><%= t('analytics:executiveSummaryDesc') %></p>
                      <button class="btn btn-danger btn-sm" onclick="generateReport('executive')"><%= t('analytics:generate') %></button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- New Schedule Modal -->
<div class="modal fade" id="newScheduleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('analytics:createScheduledReport') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="scheduleForm">
          <div class="mb-3">
            <label class="form-label"><%= t('analytics:reportName') %></label>
            <input type="text" class="form-control" name="name" required>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('shared:common.reportType') %></label>
            <select class="form-control" name="reportType" required>
              <option value="sales"><%= t('analytics:salesReport') %></option>
              <option value="customers"><%= t('analytics:customerReport') %></option>
              <option value="products"><%= t('analytics:productReport') %></option>
              <option value="inventory"><%= t('shared:common.inventory') %></option>
              <option value="executive"><%= t('analytics:executive') %></option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('shared:common.frequency') %></label>
            <select class="form-control" name="type" required>
              <option value="daily"><%= t('analytics:daily') %></option>
              <option value="weekly"><%= t('shared:common.weekly') %></option>
              <option value="monthly"><%= t('shared:common.monthly') %></option>
              <option value="quarterly"><%= t('shared:common.quarterly') %></option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('analytics:recipients') %></label>
            <input type="text" class="form-control" name="recipients" placeholder="email@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('shared:common.format') %></label>
            <select class="form-control" name="format">
              <option value="pdf">PDF</option>
              <option value="excel">Excel</option>
              <option value="csv">CSV</option>
              <option value="html">HTML</option>
            </select>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-primary" onclick="createSchedule()"><%= t('shared:common.createSchedule') %></button>
      </div>
    </div>
  </div>
</div>

<script>
  function generateReport(type) {
    const form = document.getElementById('generateReportForm');
    form.querySelector('[name="reportType"]').value = type;
    form.dispatchEvent(new Event('submit'));
  }

  document.getElementById('generateReportForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);
    
    try {
      const response = await fetch('/admin/analytics/reports/run-now', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        alert('<%= t("analytics:reportGeneratedSuccess") %>');
        console.log(result.report);
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("analytics:errorGeneratingReport") %>: ' + error.message);
    }
  });

  async function createSchedule() {
    const form = document.getElementById('scheduleForm');
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    data.recipients = data.recipients.split(',').map(e => e.trim()).filter(e => e);
    
    try {
      const response = await fetch('/admin/analytics/reports/schedules', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        alert('<%= t("analytics:scheduleCreatedSuccess") %>');
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("analytics:errorCreatingSchedule") %>: ' + error.message);
    }
  }
</script>

<%- include('../partials/footer') %>
