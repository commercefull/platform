<div class="page-header d-print-none"><div class="row g-2 align-items-center"><div class="col"><h2 class="page-title"><%= pageName %></h2></div></div></div>
<section class="content"><div class="container-fluid"><%- include('../partials/alerts') %><div class="card mb-3"><div class="card-body"><form method="GET" class="row g-3"><div class="col-md-4"><label class="form-label"><%= t('analytics:store') %></label><select class="form-select" name="storeId"><option value=""><%= t('analytics:allStores') %></option><% (stores || []).forEach(function(store) { %><option value="<%= store.storeId %>" <%= filters.storeId === store.storeId ? 'selected' : '' %>><%= store.name %></option><% }) %></select></div><div class="col-md-3"><label class="form-label"><%= t('shared:common.from') %></label><input class="form-control" type="date" name="dateFrom" value="<%= filters.dateFrom %>"></div><div class="col-md-3"><label class="form-label"><%= t('shared:common.to') %></label><input class="form-control" type="date" name="dateTo" value="<%= filters.dateTo %>"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit"><%= t('shared:common.apply') %></button></div></form></div></div><div class="card"><div class="card-body table-responsive p-0"><table class="table table-hover"><thead><tr><th><%= t('analytics:store') %></th><th><%= t('shared:common.orders') %></th><th><%= t('shared:common.revenue') %></th><th><%= t('analytics:aov') %></th><th><%= t('analytics:topProduct') %></th></tr></thead><tbody><% (summary || []).forEach(function(item) { %><tr><td><%= item.storeName %></td><td><%= item.totalOrders %></td><td>$<%= Number(item.totalRevenue || 0).toFixed(2) %></td><td>$<%= Number(item.averageOrderValue || 0).toFixed(2) %></td><td><%= item.topProducts && item.topProducts[0] ? item.topProducts[0].name : '-' %></td></tr><% }) %><% if (!summary || summary.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4"><%= t('analytics:noSalesData') %></td></tr><% } %></tbody></table></div></div></div></section>
