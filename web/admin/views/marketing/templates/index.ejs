<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-envelope-open-text me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/marketing/campaigns"><%= t('shared:common.marketing') %></a></li>
            <li class="breadcrumb-item active"><%= t('marketing:templates.title') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-list me-2"></i><%= t('marketing:templates.title') %></h3>
          <button class="btn btn-sm btn-success float-end" data-bs-toggle="modal" data-bs-target="#addTemplateModal">
            <i class="fas fa-plus me-1"></i><%= t('shared:common.createTemplate') %>
          </button>
        </div>
        <div class="card-body">
          <div class="row">
            <% (templates || []).forEach(function(template) { %>
            <div class="col-md-4 mb-3">
              <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <span><%= template.name %></span>
                  <span class="badge bg-<%= template.isActive ? 'success' : 'secondary' %>">
                    <%= template.isActive ? t('shared:common.active') : t('shared:common.draft') %>
                  </span>
                </div>
                <div class="card-body">
                  <p class="text-muted small"><%= template.description || t('marketing:templates.noDescription') %></p>
                  <div class="mb-2">
                    <span class="badge bg-info"><%= template.templateType || 'custom' %></span>
                  </div>
                  <small class="text-muted"><%= t('marketing:templates.subjectLabel') %> <%= template.subject || '-' %></small>
                </div>
                <div class="card-footer">
                  <a href="/admin/marketing/templates/<%= template.emailTemplateId %>/edit" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-edit"></i> <%= t('common.edit') %>
                  </a>
                  <button class="btn btn-sm btn-outline-info" onclick="previewTemplate('<%= template.emailTemplateId %>')">
                    <i class="fas fa-eye"></i> <%= t('marketing:templates.preview') %>
                  </button>
                  <button class="btn btn-sm btn-outline-secondary" onclick="duplicateTemplate('<%= template.emailTemplateId %>')">
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              </div>
            </div>
            <% }); %>
            <% if ((templates || []).length === 0) { %>
            <div class="col-12 text-center text-muted py-4">
              <i class="fas fa-envelope-open-text fa-3x mb-3 d-block"></i>
              <%= t('marketing:templates.noTemplatesYet') %>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- System Templates -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-cog me-2"></i><%= t('marketing:templates.systemTemplates') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover">
            <thead>
              <tr>
                <th><%= t('shared:common.template') %></th>
                <th><%= t('marketing:templates.trigger') %></th>
                <th><%= t('marketing:templates.lastModified') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% const systemTemplates = [
                { id: 'order-confirmation', name: '<%= t("marketing:templates.orderConfirmation") %>', trigger: '<%= t("marketing:templates.orderPlaced") %>' },
                { id: 'shipping-notification', name: '<%= t("marketing:templates.shippingNotification") %>', trigger: '<%= t("marketing:templates.orderShipped") %>' },
                { id: 'password-reset', name: '<%= t("marketing:templates.passwordReset") %>', trigger: '<%= t("marketing:templates.passwordResetRequested") %>' },
                { id: 'welcome-email', name: '<%= t("marketing:templates.welcomeEmail") %>', trigger: '<%= t("marketing:templates.accountCreated") %>' },
                { id: 'abandoned-cart', name: '<%= t("marketing:templates.abandonedCart") %>', trigger: '<%= t("marketing:templates.cartAbandoned") %>' }
              ]; %>
              <% systemTemplates.forEach(function(st) { %>
              <tr>
                <td><strong><%= st.name %></strong></td>
                <td><span class="badge bg-secondary"><%= st.trigger %></span></td>
                <td>-</td>
                <td>
                  <a href="/admin/marketing/templates/system/<%= st.id %>/edit" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-edit"></i> <%= t('shared:common.customize') %>
                  </a>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Add Template Modal -->
<div class="modal fade" id="addTemplateModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('marketing:templates.createEmailTemplate') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/marketing/templates">
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label"><%= t('marketing:templates.name') %> <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="name" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label"><%= t('marketing:templates.templateType') %></label>
                <select class="form-select" name="templateType">
                  <option value="promotional"><%= t('marketing:templates.promotional') %></option>
                  <option value="transactional"><%= t('marketing:templates.transactional') %></option>
                  <option value="newsletter"><%= t('marketing:templates.newsletter') %></option>
                  <option value="custom"><%= t('marketing:templates.custom') %></option>
                </select>
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('marketing:subjectLine') %> <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="subject" required>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('shared:common.description') %></label>
            <textarea class="form-control" name="description" rows="2"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('marketing:templates.emailContent') %></label>
            <textarea class="form-control font-monospace" name="content" rows="10"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
          <button type="submit" class="btn btn-primary"><%= t('shared:common.createTemplate') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function previewTemplate(id) {
    window.open(`/admin/marketing/templates/${id}/preview`, '_blank');
  }
  async function duplicateTemplate(id) {
    const res = await fetch(`/admin/marketing/templates/${id}/duplicate`, { method: 'POST' });
    if ((await res.json()).success) location.reload();
  }
</script>

<%- include('../../partials/footer') %>
