<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('marketing:emailCampaigns') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/marketing"><%= t('shared:common.marketing') %></a></li>
            <li class="breadcrumb-item active"><%= t('marketing:campaigns') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Action Bar -->
      <div class="row mb-3">
        <div class="col-12">
          <a href="/admin/marketing/campaigns/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> <%= t('marketing:createCampaign') %>
          </a>
          <div class="float-right">
            <span class="badge badge-info"><%= t('shared:common.total2') %> <%= campaigns.length %></span>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="row mb-3">
        <div class="col-md-12">
          <div class="card">
            <div class="card-body">
              <form method="GET" class="form-inline">
                <div class="form-group mr-3">
                  <label for="status" class="mr-2"><%= t('common.status') %>:</label>
                  <select name="status" id="status" class="form-control">
                    <option value=""><%= t('shared:common.allStatus') %></option>
                    <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>><%= t('shared:common.draft') %></option>
                    <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>><%= t('shared:common.scheduled') %></option>
                    <option value="sending" <%= filters.status === 'sending' ? 'selected' : '' %>><%= t('marketing:sending') %></option>
                    <option value="sent" <%= filters.status === 'sent' ? 'selected' : '' %>><%= t('shared:common.sent') %></option>
                    <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>><%= t('shared:common.cancelled') %></option>
                  </select>
                </div>
                <button type="submit" class="btn btn-secondary mr-2">
                  <i class="fas fa-filter"></i> <%= t('common.filter') %>
                </button>
                <a href="/admin/marketing/campaigns" class="btn btn-outline-secondary">
                  <i class="fas fa-times"></i> <%= t('common.clear') %>
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Campaigns Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('marketing:emailCampaigns') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('shared:common.name') %></th>
                <th><%= t('shared:common.subject') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('marketing:recipients') %></th>
                <th><%= t('shared:common.sentAt') %></th>
                <th><%= t('marketing:openRate') %></th>
                <th><%= t('marketing:clickRate') %></th>
                <th><%= t('marketing:scheduledAt') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (campaigns.length === 0) { %>
                <tr>
                  <td colspan="9" class="text-center py-4">
                    <em><%= t('marketing:noCampaigns') %> <a href="/admin/marketing/campaigns/create"><%= t('marketing:createFirstCampaign') %></a>.</em>
                  </td>
                </tr>
              <% } else { %>
                <% campaigns.forEach(campaign => { %>
                  <tr>
                    <td>
                      <strong><%= campaign.name %></strong>
                      <% if (campaign.senderName) { %>
                        <br><small class="text-muted"><%= t('marketing:from') %> <%= campaign.senderName %></small>
                      <% } %>
                    </td>
                    <td><%= campaign.subject %></td>
                    <td>
                      <span class="badge badge-<%= campaign.status === 'sent' ? 'success' : campaign.status === 'sending' ? 'info' : campaign.status === 'scheduled' ? 'warning' : 'secondary' %>">
                        <%= campaign.status %>
                      </span>
                    </td>
                    <td>
                      <% if (campaign.recipientCount !== undefined) { %>
                        <%= campaign.recipientCount.toLocaleString() %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (campaign.sentAt) { %>
                        <%= new Date(campaign.sentAt).toLocaleDateString() %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (campaign.openRate !== undefined) { %>
                        <%= campaign.openRate.toFixed(1) %>%
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (campaign.clickRate !== undefined) { %>
                        <%= campaign.clickRate.toFixed(1) %>%
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (campaign.scheduledAt) { %>
                        <%= new Date(campaign.scheduledAt).toLocaleString() %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/marketing/campaigns/<%= campaign.emailCampaignId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/marketing/campaigns/<%= campaign.emailCampaignId %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% if (campaign.status === 'draft') { %>
                        <button class="btn btn-sm btn-success" onclick="sendCampaign('<%= campaign.emailCampaignId %>', '<%= campaign.name %>')">
                          <i class="fas fa-paper-plane"></i>
                        </button>
                      <% } %>
                      <button class="btn btn-sm btn-danger" onclick="deleteCampaign('<%= campaign.emailCampaignId %>', '<%= campaign.name %>')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('marketing:deleteCampaign') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('marketing:confirmDeleteCampaign') %> "<strong id="deleteCampaignName"></strong>"?</p>
        <p class="text-danger"><small><%= t('marketing:deleteWarning') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('marketing:deleteCampaignBtn') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function deleteCampaign(campaignId, campaignName) {
  document.getElementById('deleteCampaignName').textContent = campaignName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/marketing/campaigns/${campaignId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t('marketing:errorDeleting') %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}

function sendCampaign(campaignId, campaignName) {
  if (confirm(`<%= t('marketing:confirmSendCampaign') %> "${campaignName}" <%= t('marketing:immediately') %>`)) {
    fetch(`/admin/marketing/campaigns/${campaignId}/send`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t('marketing:errorSending') %>');
      console.error('Error:', error);
    });
  }
}
</script>
<% endcontent %>
