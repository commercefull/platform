<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= affiliate ? t('marketing:affiliates.edit') : t('marketing:affiliates.create') %></h2>
    </div>
    <div class="col-auto">
      <a href="/admin/marketing/affiliates" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24"
          stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <polyline points="15 6 9 12 15 18"/>
        </svg>
        <%= t('marketing:affiliates.backToAffiliates') %>
      </a>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../partials/alerts') %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= affiliate ? t('common.edit') : t('shared:common.new') %> <%= t('marketing:affiliates.title') %></h3>
      </div>
      <div class="card-body">
        <form method="POST" action="/admin/marketing/affiliates">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label required"><%= t('common.name') %></label>
              <input type="text" name="name" class="form-control" required
                value="<%= (formData && formData.name) || (affiliate && affiliate.name) || '' %>"
                placeholder="<%= t('marketing:affiliates.name') %>">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label required"><%= t('shared:common.email') %></label>
              <input type="email" name="email" class="form-control" required
                value="<%= (formData && formData.email) || (affiliate && affiliate.email) || '' %>"
                placeholder="affiliate@example.com">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label required"><%= t('marketing:affiliates.code') %></label>
              <input type="text" name="code" class="form-control" required
                value="<%= (formData && formData.code) || (affiliate && affiliate.code) || '' %>"
                placeholder="e.g. PARTNER2024">
              <small class="text-muted"><%= t('marketing:affiliates.codeHint') %></small>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label required"><%= t('marketing:affiliates.commissionRate') %> (%)</label>
              <input type="number" name="commissionRate" class="form-control" required min="0" max="100" step="0.01"
                value="<%= (formData && formData.commissionRate) || (affiliate && affiliate.commissionRate) || '10' %>">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label"><%= t('marketing:affiliates.trackingUrlOptional') %></label>
              <input type="url" name="trackingUrl" class="form-control"
                value="<%= (formData && formData.trackingUrl) || '' %>"
                placeholder="https://yourstore.com/ref/CODE">
              <small class="text-muted"><%= t('marketing:affiliates.trackingUrlHint') %></small>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label"><%= t('marketing:affiliates.trackingSlugOptional') %></label>
              <input type="text" name="trackingSlug" class="form-control"
                value="<%= (formData && formData.trackingSlug) || '' %>"
                placeholder="e.g. partner2024">
              <small class="text-muted"><%= t('marketing:affiliates.trackingSlugHint') %></small>
            </div>
          </div>
          <div class="form-footer">
            <button type="submit" class="btn btn-primary">
              <%= affiliate ? t('marketing:affiliates.update') : t('marketing:affiliates.create') %>
            </button>
            <a href="/admin/marketing/affiliates" class="btn btn-link"><%= t('common.cancel') %></a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
