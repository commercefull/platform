<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('marketing:seo.settings') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/marketing"><%= t('shared:common.marketing') %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.seo') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-ban"></i> <%= error %>
        </div>
      <% } %>

      <!-- SEO Tools -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('marketing:seo.tools') %></h3>
            </div>
            <div class="card-body">
              <p><%= t('marketing:seo.generateFiles') %></p>
              <div class="btn-group-vertical d-block">
                <button onclick="generateRobotsTxt()" class="btn btn-outline-primary mb-2">
                  <i class="fas fa-robot"></i> <%= t('marketing:seo.generateRobots') %>
                </button>
                <button onclick="generateSitemap()" class="btn btn-outline-success">
                  <i class="fas fa-sitemap"></i> <%= t('marketing:seo.generateSitemap') %>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('shared:common.lastUpdated') %></h3>
            </div>
            <div class="card-body">
              <p class="text-muted"><%= t('marketing:seo.lastUpdatedLabel') %></p>
              <p class="font-weight-bold"><%= seoSettings.lastUpdated.toLocaleDateString() %> <%= seoSettings.lastUpdated.toLocaleTimeString() %></p>
            </div>
          </div>
        </div>
      </div>

      <!-- SEO Settings Form -->
      <form method="POST" action="/admin/marketing/seo">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"><%= t('marketing:seo.globalSettings') %></h3>
            <div class="card-tools">
              <button type="submit" class="btn btn-primary btn-sm">
                <i class="fas fa-save"></i> <%= t('shared:common.saveSettings') %>
              </button>
            </div>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="siteName"><%= t('marketing:seo.siteName') %></label>
                  <input type="text" class="form-control" id="siteName" name="siteName" value="<%= seoSettings.siteName %>" required>
                  <small class="form-text text-muted"><%= t('marketing:seo.siteNameHint') %></small>
                </div>

                <div class="form-group">
                  <label for="siteDescription"><%= t('marketing:seo.siteDescription') %></label>
                  <textarea class="form-control" id="siteDescription" name="siteDescription" rows="3" required><%= seoSettings.siteDescription %></textarea>
                  <small class="form-text text-muted"><%= t('marketing:seo.siteDescriptionHint') %></small>
                </div>

                <div class="form-group">
                  <label for="defaultMetaTitle"><%= t('marketing:seo.defaultMetaTitle') %></label>
                  <input type="text" class="form-control" id="defaultMetaTitle" name="defaultMetaTitle" value="<%= seoSettings.defaultMetaTitle %>" required>
                  <small class="form-text text-muted"><%= t('marketing:seo.defaultMetaTitleHint') %></small>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group">
                  <label for="defaultMetaDescription"><%= t('marketing:seo.defaultMetaDescription') %></label>
                  <textarea class="form-control" id="defaultMetaDescription" name="defaultMetaDescription" rows="3" required><%= seoSettings.defaultMetaDescription %></textarea>
                  <small class="form-text text-muted"><%= t('marketing:seo.defaultMetaDescriptionHint') %></small>
                </div>

                <div class="form-group">
                  <label for="defaultKeywords"><%= t('marketing:seo.defaultKeywords') %></label>
                  <input type="text" class="form-control" id="defaultKeywords" name="defaultKeywords" value="<%= seoSettings.defaultKeywords %>" required>
                  <small class="form-text text-muted"><%= t('marketing:seo.defaultKeywordsHint') %></small>
                </div>

                <div class="form-group">
                  <label for="ogImageUrl"><%= t('marketing:seo.ogImageUrl') %></label>
                  <input type="url" class="form-control" id="ogImageUrl" name="ogImageUrl" value="<%= seoSettings.ogImageUrl %>">
                  <small class="form-text text-muted"><%= t('marketing:seo.ogImageUrlHint') %></small>
                </div>
              </div>
            </div>

            <hr>

            <div class="row">
              <div class="col-md-6">
                <h5><%= t('marketing:seo.analyticsTracking') %></h5>

                <div class="form-group">
                  <label for="googleAnalyticsId"><%= t('marketing:seo.googleAnalyticsId') %></label>
                  <input type="text" class="form-control" id="googleAnalyticsId" name="googleAnalyticsId" value="<%= seoSettings.googleAnalyticsId %>" placeholder="G-XXXXXXXXXX or UA-XXXXXXXXX-X">
                  <small class="form-text text-muted"><%= t('marketing:seo.googleAnalyticsIdHint') %></small>
                </div>

                <div class="form-group">
                  <label for="facebookPixelId"><%= t('marketing:seo.facebookPixelId') %></label>
                  <input type="text" class="form-control" id="facebookPixelId" name="facebookPixelId" value="<%= seoSettings.facebookPixelId %>" placeholder="123456789012345">
                  <small class="form-text text-muted"><%= t('marketing:seo.facebookPixelIdHint') %></small>
                </div>
              </div>

              <div class="col-md-6">
                <h5><%= t('marketing:seo.socialMedia') %></h5>

                <div class="form-group">
                  <label for="twitterCardType"><%= t('marketing:seo.twitterCardType') %></label>
                  <select class="form-control" id="twitterCardType" name="twitterCardType">
                    <option value="summary" <%= seoSettings.twitterCardType === 'summary' ? 'selected' : '' %>><%= t('marketing:seo.twitterSummary') %></option>
                    <option value="summary_large_image" <%= seoSettings.twitterCardType === 'summary_large_image' ? 'selected' : '' %>><%= t('marketing:seo.twitterSummaryLargeImage') %></option>
                    <option value="app" <%= seoSettings.twitterCardType === 'app' ? 'selected' : '' %>><%= t('marketing:seo.twitterApp') %></option>
                    <option value="player" <%= seoSettings.twitterCardType === 'player' ? 'selected' : '' %>><%= t('marketing:seo.twitterPlayer') %></option>
                  </select>
                  <small class="form-text text-muted"><%= t('marketing:seo.twitterCardTypeHint') %></small>
                </div>
              </div>
            </div>

            <hr>

            <div class="row">
              <div class="col-md-6">
                <h5><%= t('marketing:seo.advancedSettings') %></h5>

                <div class="form-check">
                  <input type="checkbox" class="form-check-input" id="structuredData" name="structuredData" <%= seoSettings.structuredData ? 'checked' : '' %>>
                  <label class="form-check-label" for="structuredData">
                    <%= t('marketing:seo.enableStructuredData') %>
                  </label>
                  <small class="form-text text-muted d-block"><%= t('marketing:seo.structuredDataHint') %></small>
                </div>

                <div class="form-check">
                  <input type="checkbox" class="form-check-input" id="canonicalUrls" name="canonicalUrls" <%= seoSettings.canonicalUrls ? 'checked' : '' %>>
                  <label class="form-check-label" for="canonicalUrls">
                    <%= t('marketing:seo.enableCanonicalUrls') %>
                  </label>
                  <small class="form-text text-muted d-block"><%= t('marketing:seo.canonicalUrlsHint') %></small>
                </div>
              </div>

              <div class="col-md-6">
                <h5><%= t('marketing:seo.robotsTxtContent') %></h5>
                <div class="form-group">
                  <textarea class="form-control" id="robotsTxt" name="robotsTxt" rows="6" placeholder="User-agent: *
Allow: /

Sitemap: https://yourdomain.com/sitemap.xml"><%= seoSettings.robotsTxt %></textarea>
                  <small class="form-text text-muted"><%= t('marketing:seo.robotsTxtHint') %></small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
function generateRobotsTxt() {
  if (confirm('<%= t('marketing:seo.confirmGenerateRobots') %>')) {
    window.open('/admin/marketing/seo/robots.txt', '_blank');
  }
}

function generateSitemap() {
  if (confirm('<%= t('marketing:seo.confirmGenerateSitemap') %>')) {
    window.open('/admin/marketing/seo/sitemap.xml', '_blank');
  }
}
</script>
<% endcontent %>
