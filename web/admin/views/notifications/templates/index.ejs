<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('notifications:notificationTemplates') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.notifications') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Action Bar -->
      <div class="row mb-3">
        <div class="col-12">
          <a href="/admin/notifications/templates/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> <%= t('shared:common.createTemplate') %>
          </a>
          <div class="float-right">
            <span class="badge badge-info"><%= t('shared:common.total2') %> <%= templates.length %></span>
            <span class="badge badge-success ml-2"><%= t('notifications:activeLabel') %> <%= stats.active %></span>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="row mb-3">
        <div class="col-md-12">
          <div class="card">
            <div class="card-body">
              <form method="GET" class="form-inline">
                <div class="form-group mr-3">
                  <label for="category" class="mr-2"><%= t('notifications:categoryLabel') %></label>
                  <select name="category" id="category" class="form-control">
                    <option value=""><%= t('shared:common.allCategories') %></option>
                    <% categories.forEach(category => { %>
                      <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>>
                        <%= category %>
                      </option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-group mr-3">
                  <label for="activeOnly" class="mr-2"><%= t('notifications:statusLabel') %></label>
                  <select name="activeOnly" id="activeOnly" class="form-control">
                    <option value="false" <%= filters.activeOnly === false ? 'selected' : '' %>><%= t('notifications:allTemplates') %></option>
                    <option value="true" <%= filters.activeOnly !== false ? 'selected' : '' %>><%= t('notifications:activeOnly') %></option>
                  </select>
                </div>
                <button type="submit" class="btn btn-secondary mr-2">
                  <i class="fas fa-filter"></i> <%= t('common.filter') %>
                </button>
                <a href="/admin/notifications/templates" class="btn btn-outline-secondary">
                  <i class="fas fa-times"></i> <%= t('common.clear') %>
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Templates Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('notifications:notificationTemplates') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('common.name') %></th>
                <th><%= t('common.type') %></th>
                <th><%= t('notifications:channels') %></th>
                <th><%= t('shared:common.category') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (templates.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-4">
                    <em><%= t('notifications:noTemplates') %> <a href="/admin/notifications/templates/create"><%= t('notifications:createFirstTemplate') %></a>.</em>
                  </td>
                </tr>
              <% } else { %>
                <% templates.forEach(template => { %>
                  <tr>
                    <td>
                      <strong><%= template.name %></strong>
                      <% if (template.description) { %>
                        <br><small class="text-muted"><%= template.description %></small>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-secondary"><%= template.type.replace('_', ' ') %></span>
                    </td>
                    <td>
                      <small><%= template.supportedChannels %></small>
                      <% if (template.defaultChannel !== template.supportedChannels) { %>
                        <br><small class="text-muted"><%= t('notifications:defaultLabel') %> <%= template.defaultChannel %></small>
                      <% } %>
                    </td>
                    <td>
                      <% if (template.categoryCode) { %>
                        <span class="badge badge-info"><%= template.categoryCode %></span>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (template.isActive) { %>
                        <span class="badge badge-success"><%= t('common.active') %></span>
                      <% } else { %>
                        <span class="badge badge-secondary"><%= t('common.inactive') %></span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/notifications/templates/<%= template.notificationTemplateId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/notifications/templates/<%= template.notificationTemplateId %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% if (template.isActive) { %>
                        <button class="btn btn-sm btn-warning" onclick="deactivateTemplate('<%= template.notificationTemplateId %>')">
                          <i class="fas fa-pause"></i>
                        </button>
                      <% } else { %>
                        <button class="btn btn-sm btn-success" onclick="activateTemplate('<%= template.notificationTemplateId %>')">
                          <i class="fas fa-play"></i>
                        </button>
                      <% } %>
                      <button class="btn btn-sm btn-danger" onclick="deleteTemplate('<%= template.notificationTemplateId %>', '<%= template.name %>')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('notifications:deleteTemplateTitle') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('notifications:confirmDeleteTemplate') %> "<strong id="deleteTemplateName"></strong>"?</p>
        <p class="text-danger"><small><%= t('shared:common.thisActionCannotBeUndone') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('notifications:deleteTemplateBtn') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function activateTemplate(templateId) {
  fetch(`/admin/notifications/templates/${templateId}/activate`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('notifications:errorActivating') %>');
    console.error('Error:', error);
  });
}

function deactivateTemplate(templateId) {
  fetch(`/admin/notifications/templates/${templateId}/deactivate`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('<%= t("common.error") %>: ' + data.message);
    }
  })
  .catch(error => {
    alert('<%= t('notifications:errorDeactivating') %>');
    console.error('Error:', error);
  });
}

function deleteTemplate(templateId, templateName) {
  document.getElementById('deleteTemplateName').textContent = templateName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/notifications/templates/${templateId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t('notifications:errorDeleting') %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}
</script>
<% endcontent %>
