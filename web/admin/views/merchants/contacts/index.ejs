<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= t('merchant:merchants.merchantContacts') %></h2>
    </div>
    <div class="col-auto ms-auto">
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addContactModal">
        <%= t('merchant:merchants.addContact') %>
      </button>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../../partials/alerts') %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('merchant:contacts') %></h3>
        <span class="float-end text-muted"><%= (contacts || []).length %> records</span>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th><%= t('common.name') %></th>
              <th><%= t('common.role') %></th>
              <th><%= t('layout.email') %></th>
              <th><%= t('common.phone') %></th>
              <th><%= t('shared:common.primary') %></th>
              <th><%= t('common.dateCreated') %></th>
            </tr>
          </thead>
          <tbody>
            <% (contacts || []).forEach(function(c) { %>
            <tr>
              <td><%= c.name %></td>
              <td><%= c.role || '-' %></td>
              <td><%= c.email || '-' %></td>
              <td><%= c.phone || '-' %></td>
              <td><%= c.isPrimary ? '<span class="badge bg-success">' + t('common.yes') + '</span>' : '-' %></td>
              <td><%= new Date(c.createdAt).toLocaleDateString() %></td>
            </tr>
            <% }); %>
            <% if ((contacts || []).length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-4"><%= t('merchant:noContacts') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Add Contact Modal -->
<div class="modal fade" id="addContactModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/operations/merchants/<%= merchantId %>/contacts">
        <div class="modal-header">
          <h5 class="modal-title"><%= t('merchant:merchants.addContact') %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label"><%= t('common.name') %> <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" required>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('common.role') %></label>
            <input type="text" class="form-control" name="role">
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('layout.email') %></label>
            <input type="email" class="form-control" name="email">
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('common.phone') %></label>
            <input type="text" class="form-control" name="phone">
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" name="isPrimary" value="true" id="isPrimary">
            <label class="form-check-label" for="isPrimary"><%= t('merchant:merchants.primaryContact') %></label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
          <button type="submit" class="btn btn-primary"><%= t('merchant:merchants.addContact') %></button>
        </div>
      </form>
    </div>
  </div>
</div>
