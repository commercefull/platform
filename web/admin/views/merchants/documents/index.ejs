<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= t('merchant:merchants.verificationDocuments') %></h2>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../../partials/alerts') %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('merchant:documents') %></h3>
        <span class="float-end text-muted"><%= (documents || []).length %> records</span>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th><%= t('common.type') %></th>
              <th><%= t('merchant:merchants.file') %></th>
              <th><%= t('common.status') %></th>
              <th><%= t('merchant:merchants.reviewedAt') %></th>
              <th><%= t('merchant:merchants.reviewNote') %></th>
              <th><%= t('common.dateCreated') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% (documents || []).forEach(function(d) { %>
            <tr>
              <td><%= d.documentType %></td>
              <td><a href="<%= d.fileUrl %>" target="_blank"><%= t('merchant:merchants.viewFile') %></a></td>
              <td>
                <span class="badge bg-<%= d.status === 'approved' ? 'success' : d.status === 'rejected' ? 'danger' : 'warning' %>">
                  <%= d.status %>
                </span>
              </td>
              <td><%= d.reviewedAt ? new Date(d.reviewedAt).toLocaleDateString() : '-' %></td>
              <td><%= d.reviewNote || '-' %></td>
              <td><%= new Date(d.createdAt).toLocaleDateString() %></td>
              <td>
                <form method="POST" action="/admin/operations/merchants/<%= merchantId %>/documents/<%= d.merchantVerificationDocumentId %>/status" class="d-inline">
                  <select name="status" class="form-select form-select-sm d-inline w-auto">
                    <option value="pending" <%= d.status === 'pending' ? 'selected' : '' %>><%= t('common.pending') %></option>
                    <option value="approved" <%= d.status === 'approved' ? 'selected' : '' %>><%= t('shared:common.approved') %></option>
                    <option value="rejected" <%= d.status === 'rejected' ? 'selected' : '' %>><%= t('shared:common.rejected') %></option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-outline-primary ms-1"><%= t('common.update') %></button>
                </form>
              </td>
            </tr>
            <% }); %>
            <% if ((documents || []).length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-4"><%= t('merchant:noDocuments') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
