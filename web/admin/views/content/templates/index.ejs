<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-file-code me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/content/pages"><%= t('shared:common.content') %></a></li>
            <li class="breadcrumb-item active"><%= t('content:templates') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-list me-2"></i><%= t('content:pageTemplates') %></h3>
          <button class="btn btn-sm btn-success float-end" data-bs-toggle="modal" data-bs-target="#addTemplateModal">
            <i class="fas fa-plus me-1"></i><%= t('content:addTemplate') %>
          </button>
        </div>
        <div class="card-body">
          <div class="row">
            <% (templates || []).forEach(function(template) { %>
            <div class="col-md-4 mb-3">
              <div class="card h-100">
                <div class="card-header">
                  <h5 class="mb-0"><%= template.name %></h5>
                </div>
                <div class="card-body">
                  <p class="text-muted"><%= template.description || t('content:noDescription') %></p>
                  <div class="mb-2">
                    <span class="badge bg-secondary"><%= template.templateType || 'page' %></span>
                    <span class="badge bg-info"><%= template.pageCount || 0 %> <%= t('content:pagesCount') %></span>
                  </div>
                  <code class="small"><%= template.identifier %></code>
                </div>
                <div class="card-footer">
                  <a href="/admin/content/templates/<%= template.contentTemplateId %>/edit" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-edit"></i> <%= t('common.edit') %>
                  </a>
                  <button class="btn btn-sm btn-outline-info" onclick="previewTemplate('<%= template.contentTemplateId %>')">
                    <i class="fas fa-eye"></i> <%= t('content:preview') %>
                  </button>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteTemplate('<%= template.contentTemplateId %>')">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            </div>
            <% }); %>
            <% if ((templates || []).length === 0) { %>
            <div class="col-12 text-center text-muted py-4">
              <i class="fas fa-file-code fa-3x mb-3 d-block"></i>
              <%= t('content:noTemplates') %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Add Template Modal -->
<div class="modal fade" id="addTemplateModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('content:addPageTemplate') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/content/templates">
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label"><%= t('content:templateName') %> <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="name" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label"><%= t('content:identifier') %> <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="identifier" required placeholder="e.g., landing-page">
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('content:templateType') %></label>
            <select class="form-select" name="templateType">
              <option value="page"><%= t('shared:common.pages') %></option>
              <option value="blog"><%= t('content:blogPost') %></option>
              <option value="product"><%= t('shared:common.products') %></option>
              <option value="category"><%= t('nav.categories') %></option>
              <option value="email"><%= t('common.email') %></option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('shared:common.description') %></label>
            <textarea class="form-control" name="description" rows="2"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('content:templateContent') %></label>
            <textarea class="form-control font-monospace" name="content" rows="10" placeholder="<div class='container'>&#10;  <%- content %>&#10;</div>"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
          <button type="submit" class="btn btn-primary"><%= t('common.createTemplate') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function previewTemplate(id) {
    window.open(`/admin/content/templates/${id}/preview`, '_blank');
  }
  async function deleteTemplate(id) {
    if (!confirm('<%= t('content:confirmDeleteTemplate') %>')) return;
    const res = await fetch(`/admin/content/templates/${id}`, { method: 'DELETE' });
    if ((await res.json()).success) location.reload();
  }
</script>

<%- include('../../partials/footer') %>
