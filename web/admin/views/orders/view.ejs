<%- include("../layout") %>

<%- include("../partials/navbar") %>

<%- include("../partials/sidebar") %>

<!-- Content Wrapper -->
<div class="content-wrapper">
  <!-- Content Header -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/orders"><%= t('shared:common.orders') %></a></li>
            <li class="breadcrumb-item active">#<%= order.orderNumber %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <%- include("../partials/alerts") %>

      <div class="row">
        <!-- Order Info -->
        <div class="col-md-8">
          <!-- Order Details Card -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('shared:common.orders').replace('s', '') %> #<%= order.orderNumber %></h3>
              <div class="card-tools">
                <span class="badge badge-<%= 
                  order.status === 'completed' ? 'success' :
                  order.status === 'cancelled' ? 'danger' :
                  order.status === 'pending' ? 'warning' : 'info' %>">
                  <%= order.status.toUpperCase() %>
                </span>
              </div>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <p><strong><%= t('order:orderDate') %></strong> <%= new Date(order.orderDate).toLocaleString() %></p>
                  <p><strong><%= t('shared:common.customer') %>:</strong> <%= order.customerName || t('shared:common.guest') %></p>
                  <p><strong><%= t('shared:common.email2') %></strong> <%= order.customerEmail %></p>
                  <% if (order.customerPhone) { %>
                    <p><strong><%= t('shared:common.phone2') %></strong> <%= order.customerPhone %></p>
                  <% } %>
                </div>
                <div class="col-md-6">
                  <p><strong><%= t('shared:common.payment') %>:</strong>
                    <span class="badge badge-<%= order.paymentStatus === 'paid' ? 'success' : 'warning' %>">
                      <%= order.paymentStatus %>
                    </span>
                  </p>
                  <p><strong><%= t('shared:common.fulfillment') %>:</strong>
                    <span class="badge badge-<%= order.fulfillmentStatus === 'fulfilled' ? 'success' : 'info' %>">
                      <%= order.fulfillmentStatus %>
                    </span>
                  </p>
                  <p><strong><%= t('order:currency') %></strong> <%= order.currencyCode %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Order Items -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('shared:common.orderItems') %> (<%= order.totalItems %>)</h3>
            </div>
            <div class="card-body table-responsive p-0">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th><%= t('shared:common.product') %></th>
                    <th><%= t('shared:common.sku') %></th>
                    <th><%= t('shared:common.qty') %></th>
                    <th><%= t('order:unitPrice') %></th>
                    <th><%= t('shared:common.discount') %></th>
                    <th><%= t('shared:common.tax') %></th>
                    <th><%= t('common.total') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% order.items.forEach(item => { %>
                  <tr>
                    <td>
                      <strong><%= item.name %></strong>
                      <% if (item.description) { %>
                        <br><small class="text-muted"><%= item.description %></small>
                      <% } %>
                    </td>
                    <td><code><%= item.sku %></code></td>
                    <td><%= item.quantity %></td>
                    <td>$<%= item.unitPrice.toFixed(2) %></td>
                    <td class="text-danger">-$<%= item.discountTotal.toFixed(2) %></td>
                    <td>$<%= item.taxTotal.toFixed(2) %></td>
                    <td><strong>$<%= item.lineTotal.toFixed(2) %></strong></td>
                  </tr>
                  <% }); %>
                </tbody>
                <tfoot>
                  <tr>
                    <td colspan="6" class="text-right"><strong><%= t('order:subtotal') %></strong></td>
                    <td>$<%= order.subtotal.toFixed(2) %></td>
                  </tr>
                  <tr>
                    <td colspan="6" class="text-right"><%= t('shared:common.discount') %>:</td>
                    <td class="text-danger">-$<%= order.discountTotal.toFixed(2) %></td>
                  </tr>
                  <tr>
                    <td colspan="6" class="text-right"><%= t('shared:common.tax') %>:</td>
                    <td>$<%= order.taxTotal.toFixed(2) %></td>
                  </tr>
                  <tr>
                    <td colspan="6" class="text-right"><%= t('order:shipping') %></td>
                    <td>$<%= order.shippingTotal.toFixed(2) %></td>
                  </tr>
                  <tr class="table-active">
                    <td colspan="6" class="text-right"><strong><%= t('common.total') %>:</strong></td>
                    <td><strong>$<%= order.totalAmount.toFixed(2) %></strong></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>

          <!-- Addresses -->
          <div class="row">
            <% if (order.shippingAddress) { %>
            <div class="col-md-6">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title"><i class="fas fa-shipping-fast mr-2"></i><%= t('shared:common.shippingAddress') %></h3>
                </div>
                <div class="card-body">
                  <p><strong><%= order.shippingAddress.fullName %></strong></p>
                  <% if (order.shippingAddress.company) { %>
                    <p><%= order.shippingAddress.company %></p>
                  <% } %>
                  <p><%= order.shippingAddress.address1 %></p>
                  <% if (order.shippingAddress.address2) { %>
                    <p><%= order.shippingAddress.address2 %></p>
                  <% } %>
                  <p><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %></p>
                  <p><%= order.shippingAddress.country %></p>
                  <% if (order.shippingAddress.phone) { %>
                    <p><i class="fas fa-phone mr-1"></i><%= order.shippingAddress.phone %></p>
                  <% } %>
                </div>
              </div>
            </div>
            <% } %>
            <% if (order.billingAddress) { %>
            <div class="col-md-6">
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title"><i class="fas fa-file-invoice mr-2"></i><%= t('shared:common.billingAddress') %></h3>
                </div>
                <div class="card-body">
                  <p><strong><%= order.billingAddress.fullName %></strong></p>
                  <% if (order.billingAddress.company) { %>
                    <p><%= order.billingAddress.company %></p>
                  <% } %>
                  <p><%= order.billingAddress.address1 %></p>
                  <% if (order.billingAddress.address2) { %>
                    <p><%= order.billingAddress.address2 %></p>
                  <% } %>
                  <p><%= order.billingAddress.city %>, <%= order.billingAddress.state %> <%= order.billingAddress.postalCode %></p>
                  <p><%= order.billingAddress.country %></p>
                </div>
              </div>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Sidebar Actions -->
        <div class="col-md-4">
          <!-- Actions Card -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('common.actions') %></h3>
            </div>
            <div class="card-body">
              <!-- Update Status -->
              <form action="/admin/orders/<%= order.orderId %>/status" method="POST" class="mb-3">
                <div class="form-group">
                  <label><%= t('order:updateStatus') %></label>
                  <select name="status" class="form-control" required>
                    <% orderStatuses.forEach(s => { %>
                      <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-group">
                  <label><%= t('order:noteOptional') %></label>
                  <input type="text" name="note" class="form-control" placeholder="<%= t('order:notePlaceholder') %>">
                </div>
                <button type="submit" class="btn btn-primary btn-block"><%= t('order:updateStatus') %></button>
              </form>

              <hr>

              <!-- Quick Actions -->
              <% if (order.status !== 'cancelled' && order.status !== 'refunded') { %>
                <form action="/admin/orders/<%= order.orderId %>/cancel" method="POST" class="mb-2">
                  <input type="hidden" name="reason" value="Cancelled by admin">
                  <button type="submit" class="btn btn-danger btn-block" onclick="return confirm('<%= t('order:confirmCancel') %>')">
                    <i class="fas fa-times mr-1"></i><%= t('order:cancel') %>
                  </button>
                </form>
              <% } %>

              <% if (order.paymentStatus === 'paid' && order.status !== 'refunded') { %>
                <a href="/admin/orders/<%= order.orderId %>/refund" class="btn btn-warning btn-block">
                  <i class="fas fa-undo mr-1"></i><%= t('order:processRefund') %>
                </a>
              <% } %>

              <a href="/admin/orders" class="btn btn-secondary btn-block mt-3">
                <i class="fas fa-arrow-left mr-1"></i><%= t('shared:common.backToOrders') %>
              </a>
            </div>
          </div>

          <!-- Customer Notes -->
          <% if (order.customerNotes) { %>
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('order:customerNotes') %></h3>
            </div>
            <div class="card-body">
              <p><%= order.customerNotes %></p>
            </div>
          </div>
          <% } %>

          <!-- Tags -->
          <% if (order.tags && order.tags.length > 0) { %>
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('shared:common.tags') %></h3>
            </div>
            <div class="card-body">
              <% order.tags.forEach(tag => { %>
                <span class="badge badge-info mr-1"><%= tag %></span>
              <% }); %>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include("../partials/footer") %>
