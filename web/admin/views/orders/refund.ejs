<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-undo me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/orders"><%= t('shared:common.orders') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/orders/<%= order.orderId %>"><%= t('shared:common.orders').replace('s', '') %> #<%= order.orderNumber %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.refund') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
      </div>
      <% } %>

      <div class="row">
        <!-- Refund Form -->
        <div class="col-lg-8">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-money-bill-wave me-2"></i><%= t('order:processRefund') %></h3>
            </div>
            <form method="POST" action="/admin/orders/<%= order.orderId %>/refund">
              <div class="card-body">
                <!-- Order Items -->
                <h5 class="mb-3"><%= t('shared:common.orderItems') %></h5>
                <table class="table table-bordered mb-4">
                  <thead class="table-light">
                    <tr>
                      <th>
                        <input type="checkbox" id="selectAll" onchange="toggleAllItems()">
                      </th>
                      <th><%= t('shared:common.product') %></th>
                      <th><%= t('common.quantity') %></th>
                      <th><%= t('order:unitPrice') %></th>
                      <th><%= t('common.total') %></th>
                      <th><%= t('shared:common.refund') %> <%= t('shared:common.qty') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% (order.items || []).forEach(function(item, index) { %>
                    <tr>
                      <td>
                        <input type="checkbox" class="item-checkbox" name="refundItems[<%= index %>][selected]" value="true" onchange="calculateTotal()">
                      </td>
                      <td>
                        <strong><%= item.productName || item.name %></strong>
                        <% if (item.sku) { %><br><small class="text-muted">SKU: <%= item.sku %></small><% } %>
                      </td>
                      <td><%= item.quantity %></td>
                      <td>$<%= (item.unitPrice || item.price || 0).toFixed(2) %></td>
                      <td>$<%= ((item.unitPrice || item.price || 0) * item.quantity).toFixed(2) %></td>
                      <td style="width: 100px;">
                        <input type="hidden" name="refundItems[<%= index %>][orderItemId]" value="<%= item.orderItemId %>">
                        <input type="number" class="form-control form-control-sm refund-qty" 
                               name="refundItems[<%= index %>][quantity]" 
                               min="0" max="<%= item.quantity %>" value="<%= item.quantity %>"
                               data-price="<%= item.unitPrice || item.price || 0 %>"
                               onchange="calculateTotal()">
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>

                <!-- Refund Amount -->
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.refund') %> <%= t('common.amount') %> <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="amount" id="refundAmount" 
                               step="0.01" min="0" max="<%= order.totalAmount %>" 
                               value="<%= (typeof formData !== 'undefined' && formData.amount) || order.totalAmount %>" required>
                      </div>
                      <small class="text-muted"><%= t('order:maxRefundable') %>: $<%= order.totalAmount.toFixed(2) %></small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('order:refundType') %></label>
                      <select class="form-select" name="refundType">
                        <option value="full"><%= t('order:fullRefund') %></option>
                        <option value="partial"><%= t('order:partialRefund') %></option>
                        <option value="items"><%= t('order:selectedItemsOnly') %></option>
                      </select>
                    </div>
                  </div>
                </div>

                <!-- Reason -->
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('order:refundReason') %> <span class="text-danger">*</span></label>
                  <select class="form-select mb-2" name="reasonType" onchange="updateReasonText(this)">
                    <option value=""><%= t('order:selectReason') %></option>
                    <option value="customer_request"><%= t('order:reasonCustomerRequest') %></option>
                    <option value="defective_product"><%= t('order:reasonDefective') %></option>
                    <option value="wrong_item"><%= t('order:reasonWrongItem') %></option>
                    <option value="not_as_described"><%= t('shared:common.notAsDescribed') %></option>
                    <option value="damaged_in_shipping"><%= t('order:reasonDamaged') %></option>
                    <option value="late_delivery"><%= t('order:reasonLateDelivery') %></option>
                    <option value="duplicate_order"><%= t('order:reasonDuplicate') %></option>
                    <option value="other"><%= t('shared:common.other') %></option>
                  </select>
                  <textarea class="form-control" name="reason" id="refundReason" rows="3" 
                            placeholder="<%= t('order:refundReasonPlaceholder') %>" required><%= (typeof formData !== 'undefined' && formData.reason) || '' %></textarea>
                </div>

                <!-- Options -->
                <div class="form-group mb-3">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="restockItems" value="true" id="restockItems" checked>
                    <label class="form-check-label" for="restockItems">
                      <%= t('order:restockItems') %>
                    </label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="notifyCustomer" value="true" id="notifyCustomer" checked>
                    <label class="form-check-label" for="notifyCustomer">
                      <%= t('order:notifyCustomer') %>
                    </label>
                  </div>
                </div>
              </div>
              <div class="card-footer">
                <button type="submit" class="btn btn-danger">
                  <i class="fas fa-undo me-2"></i><%= t('order:processRefund') %>
                </button>
                <a href="/admin/orders/<%= order.orderId %>" class="btn btn-secondary">
                  <i class="fas fa-times me-2"></i><%= t('common.cancel') %>
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-receipt me-2"></i><%= t('shared:common.orderSummary') %></h3>
            </div>
            <div class="card-body">
              <table class="table table-sm">
                <tr>
                  <td><%= t('shared:common.order2') %>:</td>
                  <td class="text-end"><strong>#<%= order.orderNumber %></strong></td>
                </tr>
                <tr>
                  <td><%= t('shared:common.date') %>:</td>
                  <td class="text-end"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                </tr>
                <tr>
                  <td><%= t('common.status') %>:</td>
                  <td class="text-end">
                    <span class="badge bg-<%= order.status === 'completed' ? 'success' : order.status === 'cancelled' ? 'danger' : 'warning' %>">
                      <%= order.status %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td><%= t('order:paymentStatus') %>:</td>
                  <td class="text-end">
                    <span class="badge bg-<%= order.paymentStatus === 'paid' ? 'success' : 'warning' %>">
                      <%= order.paymentStatus %>
                    </span>
                  </td>
                </tr>
                <tr class="table-light">
                  <td><strong><%= t('order:subtotal') %></strong></td>
                  <td class="text-end">$<%= (order.subtotal || 0).toFixed(2) %></td>
                </tr>
                <% if (order.discountAmount > 0) { %>
                <tr>
                  <td><%= t('shared:common.discount') %>:</td>
                  <td class="text-end text-danger">-$<%= order.discountAmount.toFixed(2) %></td>
                </tr>
                <% } %>
                <% if (order.taxAmount > 0) { %>
                <tr>
                  <td><%= t('shared:common.tax') %>:</td>
                  <td class="text-end">$<%= order.taxAmount.toFixed(2) %></td>
                </tr>
                <% } %>
                <% if (order.shippingAmount > 0) { %>
                <tr>
                  <td><%= t('order:shipping') %></td>
                  <td class="text-end">$<%= order.shippingAmount.toFixed(2) %></td>
                </tr>
                <% } %>
                <tr class="table-primary">
                  <td><strong><%= t('common.total') %>:</strong></td>
                  <td class="text-end"><strong>$<%= order.totalAmount.toFixed(2) %></strong></td>
                </tr>
                <% if (order.refundedAmount > 0) { %>
                <tr class="table-warning">
                  <td><%= t('order:alreadyRefunded') %>:</td>
                  <td class="text-end text-danger">-$<%= order.refundedAmount.toFixed(2) %></td>
                </tr>
                <tr class="table-info">
                  <td><strong><%= t('order:refundable') %>:</strong></td>
                  <td class="text-end"><strong>$<%= (order.totalAmount - (order.refundedAmount || 0)).toFixed(2) %></strong></td>
                </tr>
                <% } %>
              </table>
            </div>
          </div>

          <!-- Customer Info -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-user me-2"></i><%= t('shared:common.customer') %></h3>
            </div>
            <div class="card-body">
              <% if (order.customer) { %>
              <p class="mb-1"><strong><%= order.customer.firstName %> <%= order.customer.lastName %></strong></p>
              <p class="mb-1 text-muted"><%= order.customer.email %></p>
              <% if (order.customer.phone) { %>
              <p class="mb-0 text-muted"><%= order.customer.phone %></p>
              <% } %>
              <% } else { %>
              <p class="text-muted mb-0"><%= t('order:guestCheckout') %></p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  function toggleAllItems() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.item-checkbox');
    checkboxes.forEach(cb => cb.checked = selectAll.checked);
    calculateTotal();
  }

  function calculateTotal() {
    let total = 0;
    const checkboxes = document.querySelectorAll('.item-checkbox');
    checkboxes.forEach((cb, index) => {
      if (cb.checked) {
        const qtyInput = document.querySelectorAll('.refund-qty')[index];
        const price = parseFloat(qtyInput.dataset.price) || 0;
        const qty = parseInt(qtyInput.value) || 0;
        total += price * qty;
      }
    });
    document.getElementById('refundAmount').value = total.toFixed(2);
  }

  function updateReasonText(select) {
    const reasonMap = {
      'customer_request': 'Customer requested refund',
      'defective_product': 'Product was defective',
      'wrong_item': 'Wrong item was shipped',
      'not_as_described': 'Product not as described',
      'damaged_in_shipping': 'Product damaged during shipping',
      'late_delivery': 'Order delivered late',
      'duplicate_order': 'Duplicate order placed',
      'other': ''
    };
    const textarea = document.getElementById('refundReason');
    if (select.value && reasonMap[select.value]) {
      textarea.value = reasonMap[select.value];
    }
  }
</script>

<%- include('../partials/footer') %>
