<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('order:refunds') %></h3>
  </div>
  <div class="card-body p-0">
    <% if (refunds && refunds.length > 0) { %>
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th><%= t('order:refundId') %></th>
          <th><%= t('common.amount') %></th>
          <th><%= t('common.status') %></th>
          <th><%= t('shared:common.reason') %></th>
          <th><%= t('shared:common.transactionId') %></th>
          <th><%= t('common.date') %></th>
        </tr>
      </thead>
      <tbody>
        <% refunds.forEach(function(refund) { %>
        <tr>
          <td><code><%= refund.orderPaymentRefundId.substring(0, 8) %>…</code></td>
          <td><%= refund.amount %></td>
          <td>
            <% if (refund.status === 'completed') { %>
              <span class="badge badge-success"><%= refund.status %></span>
            <% } else if (refund.status === 'failed') { %>
              <span class="badge badge-danger"><%= refund.status %></span>
            <% } else { %>
              <span class="badge badge-warning"><%= refund.status %></span>
            <% } %>
          </td>
          <td><%= refund.reason || '—' %></td>
          <td><%= refund.transactionId || '—' %></td>
          <td><%= new Date(refund.createdAt).toLocaleString() %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="p-3 text-muted"><%= t('order:noRefunds') %></div>
    <% } %>
  </div>
</div>
