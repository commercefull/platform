<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto"><a href="/admin/membership/plans/create" class="btn btn-primary"><i class="ti ti-plus"></i> <%= t('common.create') %></a></div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include("../../../partials/alerts") %>
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-striped table-vcenter">
          <thead><tr><th><%= t('common.name') %></th><th><%= t('common.status') %></th><th><%= t('common.actions') %></th></tr></thead>
          <tbody>
            <% if (plans && plans.length > 0) { %>
              <% plans.forEach(item => { %>
                <tr>
                  <td><%= item.name || item.name || '-' %></td>
                  <td><span class="badge bg-<%= item.status === 'active' || item.isActive ? 'success' : 'secondary' %>"><%= item.status || (item.isActive ? t('common.active') : t('common.inactive')) %></span></td>
                  <td><a href="<%= item.membershipTierId %>" class="btn btn-sm btn-outline-primary"><%= t('common.view') %></a></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="10" class="text-center text-muted py-4"><%= t('common.noData') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
