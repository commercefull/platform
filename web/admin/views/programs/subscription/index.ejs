<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-sync-alt me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.subscriptions') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <!-- Stats -->
      <div class="row">
        <div class="col-lg-3 col-6">
          <div class="small-box bg-info">
            <div class="inner">
              <h3><%= stats.totalSubscriptions || 0 %></h3>
              <p><%= t('subscription:totalSubscriptions') %></p>
            </div>
            <div class="icon"><i class="fas fa-sync-alt"></i></div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-success">
            <div class="inner">
              <h3><%= stats.activeSubscriptions || 0 %></h3>
              <p><%= t('common.active') %></p>
            </div>
            <div class="icon"><i class="fas fa-check-circle"></i></div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-warning">
            <div class="inner">
              <h3>$<%= (stats.mrr || 0).toLocaleString() %></h3>
              <p><%= t('subscription:monthlyRecurringRevenue') %></p>
            </div>
            <div class="icon"><i class="fas fa-dollar-sign"></i></div>
          </div>
        </div>
        <div class="col-lg-3 col-6">
          <div class="small-box bg-danger">
            <div class="inner">
              <h3><%= stats.churnRate || 0 %>%</h3>
              <p><%= t('shared:common.churnRate') %></p>
            </div>
            <div class="icon"><i class="fas fa-chart-line"></i></div>
          </div>
        </div>
      </div>

      <!-- Subscription Plans -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-box me-2"></i><%= t('shared:common.subscriptionPlans') %></h3>
          <button class="btn btn-sm btn-success float-end" data-bs-toggle="modal" data-bs-target="#addPlanModal">
            <i class="fas fa-plus me-1"></i><%= t('subscription:addPlan') %>
          </button>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover">
            <thead>
              <tr>
                <th><%= t('subscription:planName') %></th>
                <th><%= t('common.price') %></th>
                <th><%= t('shared:common.billingCycle') %></th>
                <th><%= t('subscription:subscribers') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% (plans || []).forEach(function(plan) { %>
              <tr>
                <td>
                  <strong><%= plan.name %></strong>
                  <br><small class="text-muted"><%= plan.description || '' %></small>
                </td>
                <td>$<%= (plan.price || 0).toFixed(2) %></td>
                <td><%= plan.billingCycle || 'monthly' %></td>
                <td><%= plan.subscriberCount || 0 %></td>
                <td>
                  <span class="badge bg-<%= plan.isActive ? 'success' : 'secondary' %>">
                    <%= plan.isActive ? t('common.active') : t('common.inactive') %>
                  </span>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" onclick="editPlan('<%= plan.subscriptionPlanId %>')">
                    <i class="fas fa-edit"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-danger" onclick="deletePlan('<%= plan.subscriptionPlanId %>')">
                    <i class="fas fa-trash"></i>
                  </button>
                </td>
              </tr>
              <% }); %>
              <% if ((plans || []).length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-4"><%= t('subscription:noPlans') %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Active Subscriptions -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-users me-2"></i><%= t('shared:common.activeSubscriptions') %></h3>
          <a href="/admin/programs/subscription/all" class="btn btn-sm btn-primary float-end"><%= t('shared:common.viewAll') %></a>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover">
            <thead>
              <tr>
                <th><%= t('shared:common.customer') %></th>
                <th><%= t('subscription:plan') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('subscription:started') %></th>
                <th><%= t('subscription:nextBilling') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% (subscriptions || []).slice(0, 10).forEach(function(sub) { %>
              <tr>
                <td>
                  <strong><%= sub.customerName || sub.email %></strong>
                  <br><small class="text-muted"><%= sub.email %></small>
                </td>
                <td><span class="badge bg-info"><%= sub.planName %></span></td>
                <td>
                  <span class="badge bg-<%= sub.status === 'active' ? 'success' : sub.status === 'cancelled' ? 'danger' : sub.status === 'paused' ? 'warning' : 'secondary' %>">
                    <%= sub.status %>
                  </span>
                </td>
                <td><%= new Date(sub.startDate).toLocaleDateString() %></td>
                <td><%= sub.nextBillingDate ? new Date(sub.nextBillingDate).toLocaleDateString() : '-' %></td>
                <td>
                  <a href="/admin/programs/subscription/<%= sub.subscriptionId %>" class="btn btn-sm btn-outline-info">
                    <i class="fas fa-eye"></i>
                  </a>
                </td>
              </tr>
              <% }); %>
              <% if ((subscriptions || []).length === 0) { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-4"><%= t('subscription:noActiveSubscriptions') %></td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Add Plan Modal -->
<div class="modal fade" id="addPlanModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= t('subscription:addSubscriptionPlan') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/programs/subscription/plans">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label"><%= t('subscription:planName') %> <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" required>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label"><%= t('common.price') %> <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <input type="number" class="form-control" name="price" step="0.01" min="0" required>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label"><%= t('shared:common.billingCycle') %></label>
                <select class="form-select" name="billingCycle">
                  <option value="weekly"><%= t('shared:common.weekly') %></option>
                  <option value="monthly" selected><%= t('shared:common.monthly') %></option>
                  <option value="quarterly"><%= t('shared:common.quarterly') %></option>
                  <option value="yearly"><%= t('subscription:yearly') %></option>
                </select>
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('common.description') %></label>
            <textarea class="form-control" name="description" rows="2"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('subscription:trialDays') %></label>
            <input type="number" class="form-control" name="trialDays" min="0" value="0">
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="isActive" value="true" id="planIsActive" checked>
            <label class="form-check-label" for="planIsActive"><%= t('common.active') %></label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
          <button type="submit" class="btn btn-primary"><%= t('shared:common.createPlan') %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function editPlan(id) { window.location.href = `/admin/programs/subscription/plans/${id}/edit`; }
  async function deletePlan(id) {
    if (!confirm('<%= t('subscription:confirmDeletePlan') %>')) return;
    const res = await fetch(`/admin/programs/subscription/plans/${id}`, { method: 'DELETE' });
    if ((await res.json()).success) location.reload();
  }
</script>

<%- include('../../partials/footer') %>
