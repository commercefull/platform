<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto"><a href="/admin/b2b/quotes" class="btn btn-secondary"><i class="ti ti-arrow-left"></i> <%= t('common.back') %></a></div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include("../../../partials/alerts") %>
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= pageName %></h3></div>
      <div class="card-body">
        <form method="POST" action="/admin/b2b/quotes">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label"><%= t('common.name') %></label>
              <input type="text" name="name" class="form-control" value="<%= item?.name || '' %>" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label"><%= t('common.status') %></label>
              <select name="status" class="form-select">
                <option value="active" <%= item?.status === 'active' ? 'selected' : '' %>><%= t('common.active') %></option>
                <option value="inactive" <%= item?.status === 'inactive' ? 'selected' : '' %>><%= t('common.inactive') %></option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label"><%= t('common.description') %></label>
            <textarea name="description" class="form-control" rows="3"><%= item?.description || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary"><%= t('common.save') %></button>
        </form>
      </div>
    </div>
  </div>
</section>
