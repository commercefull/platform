<%- include('../../partials/header', { pageName, title: pageName }) %>
<%- include('../../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
</div>

<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-striped table-sm">
      <thead><tr><th>Rule Name</th><th>Vendor</th><th>Type</th><th>Rate</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% rules.forEach(function(r) { %>
        <tr>
          <td><%= r.name || r.ruleName || '-' %></td>
          <td><%= r.vendorId || '-' %></td>
          <td><%= r.commissionType || r.type || '-' %></td>
          <td><%= r.rate != null ? r.rate + '%' : '-' %></td>
          <td><%= r.isActive ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>' %></td>
          <td><a href="/admin/marketplace/commissions/<%= r.ruleId || r.commissionRuleId %>" class="btn btn-info btn-sm">View</a></td>
        </tr>
        <% }); %>
        <% if (!rules || rules.length === 0) { %>
        <tr><td colspan="6" class="text-center text-muted">No commission rules found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
