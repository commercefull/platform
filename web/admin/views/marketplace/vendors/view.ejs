<%- include('../../partials/header', { pageName, title: pageName }) %>
<%- include('../../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <div>
    <a href="/admin/marketplace/vendors/<%= vendor.vendorId %>/edit" class="btn btn-warning btn-sm">Edit</a>
    <a href="/admin/marketplace/vendors" class="btn btn-secondary btn-sm">Back</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm">
      <tr><th>Vendor ID</th><td><code><%= vendor.vendorId %></code></td></tr>
      <tr><th>Name</th><td><%= vendor.name %></td></tr>
      <tr><th>Legal Name</th><td><%= vendor.legalName || '-' %></td></tr>
      <tr><th>Email</th><td><%= vendor.email %></td></tr>
      <tr><th>Tier</th><td><span class="badge bg-info"><%= vendor.tier %></span></td></tr>
      <tr><th>Status</th><td>
        <% if (vendor.status === 'approved') { %><span class="badge bg-success"><%= vendor.status %></span>
        <% } else if (vendor.status === 'pending') { %><span class="badge bg-warning"><%= vendor.status %></span>
        <% } else { %><span class="badge bg-danger"><%= vendor.status %></span><% } %>
      </td></tr>
      <tr><th>Tax ID</th><td><%= vendor.taxId || '-' %></td></tr>
      <tr><th>Created</th><td><%= new Date(vendor.createdAt).toLocaleString() %></td></tr>
    </table>

    <div class="mt-3">
      <% if (vendor.status === 'pending') { %>
      <form method="POST" action="/admin/marketplace/vendors/<%= vendor.vendorId %>/approve" class="d-inline">
        <button type="submit" class="btn btn-success btn-sm">Approve</button>
      </form>
      <% } %>
      <% if (vendor.status === 'approved') { %>
      <form method="POST" action="/admin/marketplace/vendors/<%= vendor.vendorId %>/suspend" class="d-inline">
        <button type="submit" class="btn btn-danger btn-sm">Suspend</button>
      </form>
      <% } %>
    </div>
  </div>
</div>

<% if (vendor.stats) { %>
<div class="card">
  <div class="card-header"><h5>Stats</h5></div>
  <div class="card-body">
    <table class="table table-sm">
      <tr><th>Total Orders</th><td><%= vendor.stats.totalOrders %></td></tr>
      <tr><th>Total Revenue</th><td>$<%= (vendor.stats.totalRevenueCents / 100).toFixed(2) %></td></tr>
      <tr><th>Total Payouts</th><td>$<%= (vendor.stats.totalPayoutsCents / 100).toFixed(2) %></td></tr>
      <tr><th>Outstanding Balance</th><td>$<%= (vendor.stats.outstandingBalanceCents / 100).toFixed(2) %></td></tr>
      <tr><th>Average Rating</th><td><%= vendor.stats.averageRating.toFixed(1) %></td></tr>
      <tr><th>Product Count</th><td><%= vendor.stats.productCount %></td></tr>
    </table>
  </div>
</div>
<% } %>

<%- include('../../partials/footer') %>
