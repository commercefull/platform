<%- include('../../partials/header', { pageName, title: pageName }) %>
<%- include('../../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <a href="/admin/marketplace/vendors/create" class="btn btn-primary btn-sm">Create Vendor</a>
</div>

<form method="GET" action="/admin/marketplace/vendors" class="row g-2 mb-3">
  <div class="col-md-3">
    <select name="status" class="form-select form-select-sm">
      <option value="">All Statuses</option>
      <option value="pending" <%= filterStatus === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="approved" <%= filterStatus === 'approved' ? 'selected' : '' %>>Approved</option>
      <option value="suspended" <%= filterStatus === 'suspended' ? 'selected' : '' %>>Suspended</option>
      <option value="terminated" <%= filterStatus === 'terminated' ? 'selected' : '' %>>Terminated</option>
    </select>
  </div>
  <div class="col-md-2">
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/admin/marketplace/vendors" class="btn btn-secondary btn-sm">Clear</a>
  </div>
</form>

<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-striped table-sm">
      <thead><tr><th>Name</th><th>Email</th><th>Tier</th><th>Status</th><th>Rating</th><th>Products</th><th>Actions</th></tr></thead>
      <tbody>
        <% vendors.forEach(function(v) { %>
        <tr>
          <td><a href="/admin/marketplace/vendors/<%= v.vendorId %>"><%= v.name %></a></td>
          <td><%= v.email %></td>
          <td><span class="badge bg-info"><%= v.tier %></span></td>
          <td>
            <% if (v.status === 'approved') { %><span class="badge bg-success"><%= v.status %></span>
            <% } else if (v.status === 'pending') { %><span class="badge bg-warning"><%= v.status %></span>
            <% } else { %><span class="badge bg-danger"><%= v.status %></span><% } %>
          </td>
          <td><%= v.stats ? v.stats.averageRating.toFixed(1) : '-' %></td>
          <td><%= v.stats ? v.stats.productCount : 0 %></td>
          <td>
            <a href="/admin/marketplace/vendors/<%= v.vendorId %>" class="btn btn-info btn-sm">View</a>
            <a href="/admin/marketplace/vendors/<%= v.vendorId %>/edit" class="btn btn-warning btn-sm">Edit</a>
          </td>
        </tr>
        <% }); %>
        <% if (!vendors || vendors.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted">No vendors found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
