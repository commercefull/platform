<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-building me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item active"><%= t('settings:businessInformation') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-8">
          <form id="businessInfoForm">
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-file-contract me-2"></i><%= t('settings:legalInfo') %></h3>
              </div>
              <div class="card-body">
                <% const businessInfo = settings.businessInfo ? (typeof settings.businessInfo === 'string' ? JSON.parse(settings.businessInfo) : settings.businessInfo) : {}; %>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('settings:legalBusinessName') %></label>
                  <input type="text" class="form-control" name="legalName" value="<%= businessInfo.legalName || '' %>" placeholder="<%= t('settings:legalBusinessNamePlaceholder') %>">
                  <small class="text-muted"><%= t('settings:legalBusinessNameHint') %></small>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.taxIdVatNumber') %></label>
                  <input type="text" class="form-control" name="taxId" value="<%= businessInfo.taxId || '' %>" placeholder="XX-XXXXXXX">
                  <small class="text-muted"><%= t('settings:taxIdHint') %></small>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('settings:registrationNumber') %></label>
                  <input type="text" class="form-control" name="registrationNumber" value="<%= businessInfo.registrationNumber || '' %>" placeholder="Registration number">
                  <small class="text-muted"><%= t('settings:registrationNumberHint') %></small>
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">
              <i class="fas fa-save me-2"></i><%= t('settings:saveBusinessInfo') %>
            </button>
          </form>
        </div>
        <div class="col-lg-4">
          <!-- Quick Links -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-link me-2"></i><%= t('shared:common.settings') %></h3>
            </div>
            <div class="list-group list-group-flush">
              <a href="/admin/settings/store" class="list-group-item list-group-item-action">
                <i class="fas fa-store me-2"></i><%= t('shared:common.storeSettings') %>
              </a>
              <a href="/admin/settings/business" class="list-group-item list-group-item-action active">
                <i class="fas fa-building me-2"></i><%= t('settings:businessInformation') %>
              </a>
              <a href="/admin/settings/localization" class="list-group-item list-group-item-action">
                <i class="fas fa-language me-2"></i><%= t('shared:common.localization') %>
              </a>
              <a href="/admin/platform/configuration" class="list-group-item list-group-item-action">
                <i class="fas fa-cog me-2"></i><%= t('settings:platformConfig') %>
              </a>
            </div>
          </div>

          <!-- Info Card -->
          <div class="card card-outline card-info">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-info-circle me-2"></i><%= t('settings:whyThisMatters') %></h3>
            </div>
            <div class="card-body">
              <p class="mb-2"><%= t('settings:businessInfoUsedFor') %></p>
              <ul class="mb-0">
                <li><%= t('settings:invoiceGeneration') %></li>
                <li><%= t('settings:taxCompliance') %></li>
                <li><%= t('settings:legalDocumentation') %></li>
                <li><%= t('settings:paymentProcessing') %></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.getElementById('businessInfoForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);

    try {
      const response = await fetch('/admin/settings/business', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        alert('<%= t('settings:businessInfoSavedSuccess') %>');
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("common.error") %>: ' + error.message);
    }
  });
</script>

<%- include('../partials/footer') %>
