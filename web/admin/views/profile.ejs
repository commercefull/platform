<div class="row">
  <div class="col-md-3">

    <!-- Profile Image -->
    <div class="card card-primary card-outline">
      <div class="card-body box-profile">
        <div class="text-center">
          <img class="profile-user-img img-fluid img-circle"
               src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/user4-128x128.jpg"
               alt="<%= t('profile.userProfilePicture') %>">
        </div>

        <h3 class="profile-username text-center">
          <% if (typeof user !== 'undefined' && user) { %>
            <%= user.name || user.email || t('profile.adminUser') %>
          <% } else { %>
            <%= t('profile.adminUser') %>
          <% } %>
        </h3>

        <p class="text-muted text-center"><%= t('profile.administrator') %></p>

        <ul class="list-group list-group-unbordered mb-3">
          <li class="list-group-item">
            <b><%= t('profile.orders') %></b> <a class="float-right">1,322</a>
          </li>
          <li class="list-group-item">
            <b><%= t('profile.revenue') %></b> <a class="float-right">$54,321</a>
          </li>
          <li class="list-group-item">
            <b><%= t('profile.customers') %></b> <a class="float-right">543</a>
          </li>
        </ul>

        <a href="#" class="btn btn-primary btn-block"><b><%= t('profile.editProfile') %></b></a>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->

    <!-- About Me Box -->
    <div class="card card-primary">
      <div class="card-header">
        <h3 class="card-title"><%= t('profile.aboutMe') %></h3>
      </div>
      <!-- /.card-header -->
      <div class="card-body">
        <strong><i class="fas fa-book mr-1"></i> <%= t('profile.education') %></strong>

        <p class="text-muted">
          <%= t('profile.educationValue') %>
        </p>

        <hr>

        <strong><i class="fas fa-map-marker-alt mr-1"></i> <%= t('profile.location') %></strong>

        <p class="text-muted"><%= t('profile.locationValue') %></p>

        <hr>

        <strong><i class="fas fa-pencil-alt mr-1"></i> <%= t('profile.skills') %></strong>

        <p class="text-muted">
          <span class="tag tag-danger"><%= t('profile.skillEcommerce') %></span>
          <span class="tag tag-success"><%= t('profile.skillNodejs') %></span>
          <span class="tag tag-info"><%= t('profile.skillReact') %></span>
          <span class="tag tag-warning"><%= t('profile.skillPostgresql') %></span>
        </p>

        <hr>

        <strong><i class="far fa-file-alt mr-1"></i> <%= t('profile.notes') %></strong>

        <p class="text-muted"><%= t('profile.notesValue') %></p>
      </div>
      <!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
  <!-- /.col -->
  <div class="col-md-9">
    <div class="card">
      <div class="card-header p-2">
        <ul class="nav nav-pills">
          <li class="nav-item"><a class="nav-link active" href="#activity" data-toggle="tab"><%= t('profile.activity') %></a></li>
          <li class="nav-item"><a class="nav-link" href="#timeline" data-toggle="tab"><%= t('profile.timeline') %></a></li>
          <li class="nav-item"><a class="nav-link" href="#settings" data-toggle="tab"><%= t('profile.settings') %></a></li>
        </ul>
      </div><!-- /.card-header -->
      <div class="card-body">
        <div class="tab-content">
          <div class="active tab-pane" id="activity">
            <!-- Post -->
            <div class="post">
              <div class="user-block">
                <img class="img-circle img-bordered-sm" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/user1-128x128.jpg" alt="user image">
                <span class="username">
                  <a href="#"><%= t('profile.demoUser1') %></a>
                  <a href="#" class="float-right btn-tool"><i class="fas fa-times"></i></a>
                </span>
                <span class="description"><%= t('profile.sharedPublicly') %></span>
              </div>
              <!-- /.user-block -->
              <p>
                <%= t('profile.activityPost1') %>
              </p>

              <p>
                <a href="#" class="link-black text-sm mr-2"><i class="fas fa-share mr-1"></i> <%= t('profile.share') %></a>
                <a href="#" class="link-black text-sm"><i class="far fa-thumbs-up mr-1"></i> <%= t('profile.like') %></a>
                <span class="float-right">
                  <a href="#" class="link-black text-sm">
                    <i class="far fa-comments mr-1"></i> <%= t('profile.comments') %> (5)
                  </a>
                </span>
              </p>

              <input class="form-control form-control-sm" type="text" placeholder="<%= t('profile.typeComment') %>">
            </div>
            <!-- /.post -->

            <!-- Post -->
            <div class="post clearfix">
              <div class="user-block">
                <img class="img-circle img-bordered-sm" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/user7-128x128.jpg" alt="User Image">
                <span class="username">
                  <a href="#"><%= t('profile.demoUser2') %></a>
                  <a href="#" class="float-right btn-tool"><i class="fas fa-times"></i></a>
                </span>
                <span class="description"><%= t('profile.sentMessage') %></span>
              </div>
              <!-- /.user-block -->
              <p>
                <%= t('profile.activityPost2') %>
              </p>

              <form class="form-horizontal">
                <div class="input-group input-group-sm mb-0">
                  <input class="form-control form-control-sm" placeholder="<%= t('profile.response') %>">
                  <div class="input-group-append">
                    <button type="submit" class="btn btn-danger"><%= t('profile.send') %></button>
                  </div>
                </div>
              </form>
            </div>
            <!-- /.post -->

            <!-- Post -->
            <div class="post">
              <div class="user-block">
                <img class="img-circle img-bordered-sm" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/user6-128x128.jpg" alt="User Image">
                <span class="username">
                  <a href="#"><%= t('profile.demoUser3') %></a>
                  <a href="#" class="float-right btn-tool"><i class="fas fa-times"></i></a>
                </span>
                <span class="description"><%= t('profile.postedPhotos') %></span>
              </div>
              <!-- /.user-block -->
              <div class="row mb-3">
                <div class="col-sm-6">
                  <img class="img-fluid" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/photo1.png" alt="Photo">
                </div>
                <!-- /.col -->
                <div class="col-sm-6">
                  <div class="row">
                    <div class="col-sm-6">
                      <img class="img-fluid mb-3" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/photo2.png" alt="Photo">
                      <img class="img-fluid" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/photo3.jpg" alt="Photo">
                    </div>
                    <!-- /.col -->
                    <div class="col-sm-6">
                      <img class="img-fluid mb-3" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/photo4.jpg" alt="Photo">
                      <img class="img-fluid" src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/img/photo1.png" alt="Photo">
                    </div>
                    <!-- /.col -->
                  </div>
                  <!-- /.row -->
                </div>
                <!-- /.col -->
              </div>
              <!-- /.row -->

              <p>
                <a href="#" class="link-black text-sm mr-2"><i class="fas fa-share mr-1"></i> <%= t('profile.share') %></a>
                <a href="#" class="link-black text-sm"><i class="far fa-thumbs-up mr-1"></i> <%= t('profile.like') %></a>
                <span class="float-right">
                  <a href="#" class="link-black text-sm">
                    <i class="far fa-comments mr-1"></i> <%= t('profile.comments') %> (5)
                  </a>
                </span>
              </p>

              <input class="form-control form-control-sm" type="text" placeholder="<%= t('profile.typeComment') %>">
            </div>
            <!-- /.post -->
          </div>
          <!-- /.tab-pane -->
          <div class="tab-pane" id="timeline">
            <!-- The timeline -->
            <div class="timeline timeline-inverse">
              <!-- timeline time label -->
              <div class="time-label">
                <span class="bg-danger">
                  10 Feb. 2014
                </span>
              </div>
              <!-- /.timeline-label -->
              <!-- timeline item -->
              <div>
                <i class="fas fa-envelope bg-primary"></i>

                <div class="timeline-item">
                  <span class="time"><i class="far fa-clock"></i> 12:05</span>

                  <h3 class="timeline-header"><a href="#"><%= t('profile.supportTeamEmail') %></a> <%= t('profile.sentYouEmail') %></h3>

                  <div class="timeline-body">
                    <%= t('profile.emailBody') %>
                  </div>
                  <div class="timeline-footer">
                    <a href="#" class="btn btn-primary btn-sm"><%= t('profile.readMore') %></a>
                    <a href="#" class="btn btn-danger btn-sm"><%= t('common.delete') %></a>
                  </div>
                </div>
              </div>
              <!-- END timeline item -->
              <!-- timeline item -->
              <div>
                <i class="fas fa-user bg-info"></i>

                <div class="timeline-item">
                  <span class="time"><i class="far fa-clock"></i> 5 mins ago</span>

                  <h3 class="timeline-header border-0"><a href="#">Sarah Young</a> <%= t('profile.acceptedFriendRequest') %>
                  </h3>
                </div>
              </div>
              <!-- END timeline item -->
              <!-- timeline item -->
              <div>
                <i class="fas fa-comments bg-warning"></i>

                <div class="timeline-item">
                  <span class="time"><i class="far fa-clock"></i> 27 mins ago</span>

                  <h3 class="timeline-header"><a href="#">Jay White</a> <%= t('profile.commentedOnPost') %></h3>

                  <div class="timeline-body">
                    <%= t('profile.commentBody') %>
                  </div>
                  <div class="timeline-footer">
                    <a href="#" class="btn btn-warning btn-flat btn-sm"><%= t('profile.viewComment') %></a>
                  </div>
                </div>
              </div>
              <!-- END timeline item -->
              <!-- timeline time label -->
              <div class="time-label">
                <span class="bg-success">
                  3 Jan. 2014
                </span>
              </div>
              <!-- /.timeline-label -->
              <!-- timeline item -->
              <div>
                <i class="fas fa-camera bg-purple"></i>

                <div class="timeline-item">
                  <span class="time"><i class="far fa-clock"></i> 2 days ago</span>

                  <h3 class="timeline-header"><a href="#">Mina Lee</a> <%= t('profile.uploadedPhotos') %></h3>

                  <div class="timeline-body">
                    <img src="https://via.placeholder.com/150x100" alt="...">
                    <img src="https://via.placeholder.com/150x100" alt="...">
                    <img src="https://via.placeholder.com/150x100" alt="...">
                    <img src="https://via.placeholder.com/150x100" alt="...">
                  </div>
                </div>
              </div>
              <!-- END timeline item -->
              <div>
                <i class="far fa-clock bg-gray"></i>
              </div>
            </div>
          </div>
          <!-- /.tab-pane -->

          <div class="tab-pane" id="settings">
            <form class="form-horizontal">
              <div class="form-group row">
                <label for="inputName" class="col-sm-2 col-form-label"><%= t('profile.name') %></label>
                <div class="col-sm-10">
                  <input type="email" class="form-control" id="inputName" placeholder="<%= t('profile.name') %>">
                </div>
              </div>
              <div class="form-group row">
                <label for="inputEmail" class="col-sm-2 col-form-label"><%= t('profile.email') %></label>
                <div class="col-sm-10">
                  <input type="email" class="form-control" id="inputEmail" placeholder="<%= t('profile.email') %>">
                </div>
              </div>
              <div class="form-group row">
                <label for="inputName2" class="col-sm-2 col-form-label"><%= t('profile.name') %></label>
                <div class="col-sm-10">
                  <input type="text" class="form-control" id="inputName2" placeholder="<%= t('profile.name') %>">
                </div>
              </div>
              <div class="form-group row">
                <label for="inputExperience" class="col-sm-2 col-form-label"><%= t('profile.experience') %></label>
                <div class="col-sm-10">
                  <textarea class="form-control" id="inputExperience" placeholder="<%= t('profile.experience') %>"></textarea>
                </div>
              </div>
              <div class="form-group row">
                <label for="inputSkills" class="col-sm-2 col-form-label"><%= t('profile.skills') %></label>
                <div class="col-sm-10">
                  <input type="text" class="form-control" id="inputSkills" placeholder="<%= t('profile.skills') %>">
                </div>
              </div>
              <div class="form-group row">
                <div class="offset-sm-2 col-sm-10">
                  <div class="checkbox">
                    <label>
                      <input type="checkbox"> <%= t('profile.agreeTerms') %> <a href="#"><%= t('profile.termsAndConditions') %></a>
                    </label>
                  </div>
                </div>
              </div>
              <div class="form-group row">
                <div class="offset-sm-2 col-sm-10">
                  <button type="submit" class="btn btn-danger"><%= t('profile.submit') %></button>
                </div>
              </div>
            </form>
          </div>
          <!-- /.tab-pane -->
        </div>
        <!-- /.tab-content -->
      </div><!-- /.card-body -->
    </div>
    <!-- /.card -->
  </div>
  <!-- /.col -->
</div>
<!-- /.row -->
