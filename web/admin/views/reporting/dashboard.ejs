<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto"><a href="/admin/reporting/schedules" class="btn btn-outline-secondary"><%= t('shared:common.scheduledReports') %></a></div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include('../partials/alerts') %>
    <div class="row">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t('analytics:generateReportBtn') %></h3></div>
          <div class="card-body">
            <form method="POST" action="/admin/reporting/generate">
              <div class="mb-3">
                <label class="form-label"><%= t('shared:common.reportType') %></label>
                <select class="form-select" name="reportType" id="reportType" required>
                  <option value=""><%= t('common.selectPlaceholder') %></option>
                  <% Object.entries(templates || {}).forEach(function(entry) { const key = entry[0]; const tpl = entry[1]; %>
                    <option value="<%= key %>"><%= tpl.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label"><%= t('shared:common.from') %></label>
                  <input type="date" class="form-control" name="dateFrom">
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label"><%= t('shared:common.to') %></label>
                  <input type="date" class="form-control" name="dateTo">
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label"><%= t('store.title') %> (<%= t('common.optional').toLowerCase() %>)</label>
                  <input type="text" class="form-control" name="storeId" placeholder="Filter by store">
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label"><%= t('common.optional') %></label>
                  <input type="number" class="form-control" name="limit" placeholder="Row limit" value="100">
                </div>
              </div>
              <button type="submit" class="btn btn-primary"><%= t('analytics:generateReportBtn') %></button>
            </form>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-header"><h3 class="card-title"><%= t('analytics:reportTemplates') %></h3></div>
          <div class="card-body">
            <ul class="list-group list-group-flush">
              <% Object.entries(templates || {}).forEach(function(entry) { const key = entry[0]; const tpl = entry[1]; %>
                <li class="list-group-item">
                  <strong><%= tpl.name %></strong>
                  <br><small class="text-muted"><%= tpl.description %></small>
                  <br><small><%= t('shared:common.format') %>: <%= tpl.defaultFormat %></small>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
