<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('product:productQa') %></h3>
  </div>
  <div class="card-body p-0">
    <% if (qaList && qaList.length > 0) { %>
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th><%= t('shared:common.question') %></th>
          <th><%= t('product:asker') %></th>
          <th><%= t('common.status') %></th>
          <th><%= t('common.date') %></th>
          <th><%= t('common.actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% qaList.forEach(function(qa) { %>
        <tr>
          <td><%= qa.question %></td>
          <td><%= qa.askerName || qa.askerEmail || '—' %></td>
          <td>
            <% if (qa.status === 'approved') { %>
              <span class="badge bg-success"><%= t('shared:common.approved') %></span>
            <% } else if (qa.status === 'rejected') { %>
              <span class="badge bg-danger"><%= t('shared:common.rejected') %></span>
            <% } else { %>
              <span class="badge bg-warning text-dark"><%= t('shared:common.pending') %></span>
            <% } %>
          </td>
          <td><%= new Date(qa.createdAt).toLocaleDateString() %></td>
          <td>
            <% if (qa.status !== 'approved') { %>
            <form method="POST" action="/admin/products/<%= productId %>/qa/<%= qa.productQaId %>/status" class="d-inline">
              <input type="hidden" name="status" value="approved">
              <button type="submit" class="btn btn-sm btn-outline-success"><%= t('shared:common.approve') %></button>
            </form>
            <% } %>
            <% if (qa.status !== 'rejected') { %>
            <form method="POST" action="/admin/products/<%= productId %>/qa/<%= qa.productQaId %>/status" class="d-inline">
              <input type="hidden" name="status" value="rejected">
              <button type="submit" class="btn btn-sm btn-outline-danger"><%= t('product:reject') %></button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="p-3 text-muted"><%= t('product:noQaEntries') %></div>
    <% } %>
  </div>
</div>
