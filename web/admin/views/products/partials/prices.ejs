<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('product:productPrices') %></h3>
  </div>
  <div class="card-body p-0">
    <% if (prices && prices.length > 0) { %>
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th><%= t('product:variant') %></th>
          <th><%= t('shared:common.currency') %></th>
          <th><%= t('common.amount') %></th>
          <th><%= t('product:salePrice') %></th>
          <th><%= t('product:compareAt') %></th>
          <th><%= t('product:cost') %></th>
        </tr>
      </thead>
      <tbody>
        <% prices.forEach(function(price) { %>
        <tr>
          <td><%= price.productVariantId || t('product:baseProduct') %></td>
          <td><strong><%= price.currencyCode %></strong></td>
          <td><%= (price.priceCents / 100).toFixed(2) %></td>
          <td><%= price.salePriceCents != null ? (price.salePriceCents / 100).toFixed(2) : '—' %></td>
          <td><%= price.compareAtPriceCents != null ? (price.compareAtPriceCents / 100).toFixed(2) : '—' %></td>
          <td><%= price.costPriceCents != null ? (price.costPriceCents / 100).toFixed(2) : '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="p-3 text-muted"><%= t('product:noCustomPrices') %></div>
    <% } %>
  </div>
  <div class="card-footer">
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#addPriceForm">
      <i class="fas fa-plus me-1"></i><%= t('product:addPrice') %>
    </button>
    <div class="collapse mt-3" id="addPriceForm">
      <form method="POST" action="/admin/products/<%= productId %>/prices">
        <div class="row g-2">
          <div class="col-md-2">
            <label class="form-label"><%= t('shared:common.currency') %> <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" name="currencyCode" placeholder="USD" required maxlength="3">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('common.amount') %> <span class="text-danger">*</span></label>
            <input type="number" class="form-control form-control-sm" name="amount" step="0.01" min="0" required>
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:salePrice') %></label>
            <input type="number" class="form-control form-control-sm" name="saleAmount" step="0.01" min="0">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:compareAt') %></label>
            <input type="number" class="form-control form-control-sm" name="compareAtAmount" step="0.01" min="0">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:cost') %></label>
            <input type="number" class="form-control form-control-sm" name="costAmount" step="0.01" min="0">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:variantId') %></label>
            <input type="text" class="form-control form-control-sm" name="productVariantId" placeholder="">
          </div>
          <div class="col-12 mt-2">
            <button type="submit" class="btn btn-primary btn-sm"><%= t('product:savePrice') %></button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
