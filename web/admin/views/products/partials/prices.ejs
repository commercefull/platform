<div class="card">
  <div class="card-header">
    <h3 class="card-title"><%= t('product:productPrices') %></h3>
  </div>
  <div class="card-body p-0">
    <% if (prices && prices.length > 0) { %>
    <table class="table table-striped mb-0">
      <thead>
        <tr>
          <th><%= t('shared:common.currency') %></th>
          <th><%= t('common.amount') %></th>
          <th><%= t('product:compareAt') %></th>
          <th><%= t('product:minQty') %></th>
          <th><%= t('product:maxQty') %></th>
          <th><%= t('product:startsAt') %></th>
          <th><%= t('product:endsAt') %></th>
        </tr>
      </thead>
      <tbody>
        <% prices.forEach(function(price) { %>
        <tr>
          <td><strong><%= price.currencyCode %></strong></td>
          <td><%= price.amount %></td>
          <td><%= price.compareAtAmount || '—' %></td>
          <td><%= price.minQuantity || '—' %></td>
          <td><%= price.maxQuantity || '—' %></td>
          <td><%= price.startsAt ? new Date(price.startsAt).toLocaleDateString() : '—' %></td>
          <td><%= price.endsAt ? new Date(price.endsAt).toLocaleDateString() : '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <div class="p-3 text-muted"><%= t('product:noCustomPrices') %></div>
    <% } %>
  </div>
  <div class="card-footer">
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#addPriceForm">
      <i class="fas fa-plus me-1"></i><%= t('product:addPrice') %>
    </button>
    <div class="collapse mt-3" id="addPriceForm">
      <form method="POST" action="/admin/products/<%= productId %>/prices">
        <div class="row g-2">
          <div class="col-md-2">
            <label class="form-label"><%= t('shared:common.currency') %> <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" name="currencyCode" placeholder="USD" required maxlength="3">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('common.amount') %> <span class="text-danger">*</span></label>
            <input type="number" class="form-control form-control-sm" name="amount" step="0.01" min="0" required>
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:compareAt') %></label>
            <input type="number" class="form-control form-control-sm" name="compareAtAmount" step="0.01" min="0">
          </div>
          <div class="col-md-1">
            <label class="form-label"><%= t('product:minQty') %></label>
            <input type="number" class="form-control form-control-sm" name="minQuantity" min="1">
          </div>
          <div class="col-md-1">
            <label class="form-label"><%= t('product:maxQty') %></label>
            <input type="number" class="form-control form-control-sm" name="maxQuantity" min="1">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:startsAt') %></label>
            <input type="date" class="form-control form-control-sm" name="startsAt">
          </div>
          <div class="col-md-2">
            <label class="form-label"><%= t('product:endsAt') %></label>
            <input type="date" class="form-control form-control-sm" name="endsAt">
          </div>
          <div class="col-12 mt-2">
            <button type="submit" class="btn btn-primary btn-sm"><%= t('product:savePrice') %></button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
