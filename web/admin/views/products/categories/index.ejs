<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-tags me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/products"><%= t('shared:common.products') %></a></li>
            <li class="breadcrumb-item active"><%= t('nav.categories') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (success) { %>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-check-circle me-2"></i><%= success %>
      </div>
      <% } %>

      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h3 class="card-title"><%= t('product:category.title') %></h3>
          <a href="/admin/products/categories/create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i><%= t('product:category.new') %>
          </a>
        </div>
        <div class="card-body p-0">
          <% if (categories && categories.length > 0) { %>
          <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th><%= t('common.name') %></th>
                <th><%= t('shared:common.slug') %></th>
                <th><%= t('shared:common.parent') %></th>
                <th><%= t('product:category.position') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(function(cat) { %>
              <tr>
                <td><%= cat.name %></td>
                <td><code><%= cat.slug %></code></td>
                <td><%= cat.parentId || '—' %></td>
                <td><%= cat.position %></td>
                <td>
                  <% if (cat.isActive) { %>
                    <span class="badge bg-success"><%= t('common.active') %></span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= t('common.inactive') %></span>
                  <% } %>
                </td>
                <td>
                  <a href="/admin/products/categories/<%= cat.productCategoryId %>/edit" class="btn btn-sm btn-outline-primary"><%= t('common.edit') %></a>
                  <form method="POST" action="/admin/products/categories/<%= cat.productCategoryId %>?_method=DELETE" class="d-inline" onsubmit="return confirm('<%= t('product:category.confirmDelete') %>')">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><%= t('common.delete') %></button>
                  </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="p-4 text-muted text-center"><%= t('product:category.noCategories') %> <a href="/admin/products/categories/create"><%= t('product:category.createOne') %></a>.</div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../../partials/footer') %>
