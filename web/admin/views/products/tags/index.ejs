<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-hashtag me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/products"><%= t('shared:common.products') %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.tags') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (success) { %>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-check-circle me-2"></i><%= success %>
      </div>
      <% } %>

      <div class="row">
        <!-- Create Tag Form -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('product:tag.addNew') %></h3>
            </div>
            <form method="POST" action="/admin/products/tags">
              <div class="card-body">
                <div class="mb-3">
                  <label class="form-label"><%= t('common.name') %> <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" name="name" required>
                </div>
                <div class="mb-3">
                  <label class="form-label"><%= t('shared:common.slug') %></label>
                  <input type="text" class="form-control" name="slug" placeholder="<%= t('common.autoGenerated') %>">
                </div>
                <div class="mb-3">
                  <label class="form-label"><%= t('shared:common.description') %></label>
                  <textarea class="form-control" name="description" rows="2"></textarea>
                </div>
              </div>
              <div class="card-footer">
                <button type="submit" class="btn btn-primary"><i class="fas fa-plus me-1"></i><%= t('product:tag.addTag') %></button>
              </div>
            </form>
          </div>
        </div>

        <!-- Tags List -->
        <div class="col-md-8">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('product:tag.allTags') %> (<%= tags ? tags.length : 0 %>)</h3>
            </div>
            <div class="card-body p-0">
              <% if (tags && tags.length > 0) { %>
              <table class="table table-striped mb-0">
                <thead>
                  <tr>
                    <th><%= t('common.name') %></th>
                    <th><%= t('shared:common.slug') %></th>
                    <th><%= t('shared:common.description') %></th>
                    <th><%= t('common.actions') %></th>
                  </tr>
                </thead>
                <tbody>
                  <% tags.forEach(function(tag) { %>
                  <tr>
                    <td><%= tag.name %></td>
                    <td><code><%= tag.slug %></code></td>
                    <td><%= tag.description || '—' %></td>
                    <td>
                      <form method="POST" action="/admin/products/tags/<%= tag.productTagId %>?_method=DELETE" class="d-inline" onsubmit="return confirm('<%= t('product:tag.confirmDelete') %>')">
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" class="btn btn-sm btn-outline-danger"><%= t('common.delete') %></button>
                      </form>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
              <% } else { %>
              <div class="p-4 text-muted text-center"><%= t('product:tag.noTags') %></div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../../partials/footer') %>
