<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-plus-circle me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/products"><%= t('shared:common.products') %></a></li>
            <li class="breadcrumb-item active"><%= t('common.create') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
      </div>
      <% } %>

      <form method="POST" action="/admin/products" enctype="multipart/form-data">
        <div class="row">
          <!-- Main Content -->
          <div class="col-lg-8">
            <!-- Basic Info -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle me-2"></i><%= t('shared:common.basicInformation') %></h3>
              </div>
              <div class="card-body">
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.productName') %> <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" name="name" value="<%= formData.name || '' %>" required placeholder="<%= t('shared:common.productName') %>">
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.sku') %></label>
                      <input type="text" class="form-control" name="sku" value="<%= formData.sku || '' %>" placeholder="<%= t('shared:common.sku') %>">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.slug') %></label>
                      <input type="text" class="form-control" name="slug" value="<%= formData.slug || '' %>" placeholder="url-friendly-name">
                    </div>
                  </div>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:shortDescription') %></label>
                  <textarea class="form-control" name="shortDescription" rows="2" placeholder="<%= t('product:shortDescription') %>"><%= formData.shortDescription || '' %></textarea>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:fullDescription') %></label>
                  <textarea class="form-control" name="description" rows="5" placeholder="<%= t('product:fullDescription') %>"><%= formData.description || '' %></textarea>
                </div>
              </div>
            </div>

            <!-- Pricing -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-dollar-sign me-2"></i><%= t('common.pricing') %></h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:basePrice') %> <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="basePrice" value="<%= formData.basePrice || '0.00' %>" step="0.01" min="0" required>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:salePrice') %></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="salePrice" value="<%= formData.salePrice || '' %>" step="0.01" min="0">
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.cost') %></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="cost" value="<%= formData.cost || '' %>" step="0.01" min="0">
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.currency') %></label>
                      <select class="form-select" name="currencyCode">
                        <option value="USD" <%= formData.currencyCode === 'USD' ? 'selected' : '' %>><%= t('product:usDollar') %></option>
                        <option value="EUR" <%= formData.currencyCode === 'EUR' ? 'selected' : '' %>><%= t('product:euro') %></option>
                        <option value="GBP" <%= formData.currencyCode === 'GBP' ? 'selected' : '' %>><%= t('product:britishPound') %></option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.taxClass') %></label>
                      <select class="form-select" name="taxClass">
                        <option value=""><%= t('product:standard') %></option>
                        <option value="reduced" <%= formData.taxClass === 'reduced' ? 'selected' : '' %>><%= t('product:reduced') %></option>
                        <option value="zero" <%= formData.taxClass === 'zero' ? 'selected' : '' %>><%= t('product:zeroRate') %></option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Dimensions -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-ruler-combined me-2"></i><%= t('product:dimensionsWeight') %></h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.weight') %></label>
                      <div class="input-group">
                        <input type="number" class="form-control" name="weight" value="<%= formData.weight || '' %>" step="0.01" min="0">
                        <select class="form-select" name="weightUnit" style="max-width: 100px;">
                          <option value="kg" <%= formData.weightUnit === 'kg' ? 'selected' : '' %>>kg</option>
                          <option value="lb" <%= formData.weightUnit === 'lb' ? 'selected' : '' %>>lb</option>
                          <option value="g" <%= formData.weightUnit === 'g' ? 'selected' : '' %>>g</option>
                          <option value="oz" <%= formData.weightUnit === 'oz' ? 'selected' : '' %>>oz</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:length') %></label>
                      <input type="number" class="form-control" name="length" value="<%= formData.length || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:width') %></label>
                      <input type="number" class="form-control" name="width" value="<%= formData.width || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:height') %></label>
                      <div class="input-group">
                        <input type="number" class="form-control" name="height" value="<%= formData.height || '' %>" step="0.01" min="0">
                        <select class="form-select" name="dimensionUnit" style="max-width: 80px;">
                          <option value="cm" <%= formData.dimensionUnit === 'cm' ? 'selected' : '' %>>cm</option>
                          <option value="in" <%= formData.dimensionUnit === 'in' ? 'selected' : '' %>>in</option>
                          <option value="m" <%= formData.dimensionUnit === 'm' ? 'selected' : '' %>>m</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Order Limits & Policies -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-shield-alt me-2"></i><%= t('product:orderLimits') %></h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:minOrderQuantity') %></label>
                      <input type="number" class="form-control" name="minOrderQuantity" value="<%= formData.minOrderQuantity || 1 %>" min="1" step="1">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:maxOrderQuantity') %></label>
                      <input type="number" class="form-control" name="maxOrderQuantity" value="<%= formData.maxOrderQuantity || '' %>" min="1" step="1" placeholder="<%= t('product:noLimit') %>">
                    </div>
                  </div>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:warranty') %></label>
                  <textarea class="form-control" name="warranty" rows="2" placeholder="<%= t('product:warranty') %>"><%= formData.warranty || '' %></textarea>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.returnPolicy') %></label>
                  <textarea class="form-control" name="returnPolicy" rows="2" placeholder="<%= t('shared:common.returnPolicy') %>"><%= formData.returnPolicy || '' %></textarea>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.externalId') %></label>
                  <input type="text" class="form-control" name="externalId" value="<%= formData.externalId || '' %>" placeholder="<%= t('shared:common.externalId') %>">
                </div>
              </div>
            </div>

            <!-- SEO -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-search me-2"></i><%= t('common.seo') %></h3>
              </div>
              <div class="card-body">
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.metaTitle') %></label>
                  <input type="text" class="form-control" name="metaTitle" value="<%= formData.metaTitle || '' %>" maxlength="70">
                  <small class="text-muted"><%= t('product:seoRecommendedTitle') %></small>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.metaDescription') %></label>
                  <textarea class="form-control" name="metaDescription" rows="2" maxlength="160"><%= formData.metaDescription || '' %></textarea>
                  <small class="text-muted"><%= t('product:seoRecommendedDesc') %></small>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:metaKeywords') %></label>
                  <input type="text" class="form-control" name="metaKeywords" value="<%= formData.metaKeywords || '' %>" placeholder="keyword1, keyword2, keyword3">
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="col-lg-4">
            <!-- Publish -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-paper-plane me-2"></i><%= t('product:publish') %></h3>
              </div>
              <div class="card-body">
                <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                  <i class="fas fa-save me-2"></i><%= t('product:create') %>
                </button>
                <a href="/admin/products" class="btn btn-secondary w-100">
                  <i class="fas fa-times me-2"></i><%= t('common.cancel') %>
                </a>
              </div>
            </div>

            <!-- Organization -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-folder me-2"></i><%= t('product:organization') %></h3>
              </div>
              <div class="card-body">
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:productType') %></label>
                  <select class="form-select" name="productTypeId">
                    <option value=""><%= t('shared:common.selectType') %></option>
                    <% (productTypes || []).forEach(function(type) { %>
                    <option value="<%= type.productTypeId %>" <%= formData.productTypeId === type.productTypeId ? 'selected' : '' %>><%= type.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('common.category') %></label>
                  <select class="form-select" name="categoryId">
                    <option value=""><%= t('product:selectCategory') %></option>
                    <% (categories || []).forEach(function(cat) { %>
                    <option value="<%= cat.productCategoryId %>" <%= formData.categoryId === cat.productCategoryId ? 'selected' : '' %>><%= cat.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.tags') %></label>
                  <input type="text" class="form-control" name="tags" value="<%= formData.tags || '' %>" placeholder="tag1, tag2, tag3">
                </div>
              </div>
            </div>

            <!-- Options -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-cog me-2"></i><%= t('product:options') %></h3>
              </div>
              <div class="card-body">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="isFeatured" <%= formData.isFeatured ? 'checked' : '' %>>
                  <label class="form-check-label" for="isFeatured"><%= t('product:featuredProduct') %></label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isTaxable" value="true" id="isTaxable" <%= formData.isTaxable !== false ? 'checked' : '' %>>
                  <label class="form-check-label" for="isTaxable"><%= t('product:taxable') %></label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isVirtual" value="true" id="isVirtual" <%= formData.isVirtual ? 'checked' : '' %>>
                  <label class="form-check-label" for="isVirtual"><%= t('product:virtualProduct') %></label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isDownloadable" value="true" id="isDownloadable" <%= formData.isDownloadable ? 'checked' : '' %>>
                  <label class="form-check-label" for="isDownloadable"><%= t('product:downloadable') %></label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="isSubscription" value="true" id="isSubscription" <%= formData.isSubscription ? 'checked' : '' %>>
                  <label class="form-check-label" for="isSubscription"><%= t('product:subscriptionProduct') %></label>
                </div>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </section>
</div>

<%- include('../partials/footer') %>
