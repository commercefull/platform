<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-edit me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/products"><%= t('shared:common.products') %></a></li>
            <li class="breadcrumb-item active"><%= t('common.edit') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
      </div>
      <% } %>

      <form method="POST" action="/admin/products/<%= product.productId %>" enctype="multipart/form-data">
        <div class="row">
          <!-- Main Content -->
          <div class="col-lg-8">
            <!-- Basic Info -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle me-2"></i><%= t('shared:common.basicInformation') %></h3>
              </div>
              <div class="card-body">
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.productName') %> <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" name="name" value="<%= product.name || '' %>" required>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.sku') %></label>
                      <input type="text" class="form-control" name="sku" value="<%= product.sku || '' %>">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.slug') %></label>
                      <input type="text" class="form-control" name="slug" value="<%= product.slug || '' %>">
                    </div>
                  </div>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:shortDescription') %></label>
                  <textarea class="form-control" name="shortDescription" rows="2"><%= product.shortDescription || '' %></textarea>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:fullDescription') %></label>
                  <textarea class="form-control" name="description" rows="5"><%= product.description || '' %></textarea>
                </div>
              </div>
            </div>

            <!-- Pricing -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-dollar-sign me-2"></i><%= t('common.pricing') %></h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:basePrice') %> <span class="text-danger">*</span></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="basePrice" value="<%= product.basePrice || 0 %>" step="0.01" min="0" required>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:salePrice') %></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="salePrice" value="<%= product.salePrice || '' %>" step="0.01" min="0">
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.cost') %></label>
                      <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" name="cost" value="<%= product.cost || '' %>" step="0.01" min="0">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Dimensions -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-ruler-combined me-2"></i><%= t('product:dimensionsWeight') %></h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.weight') %></label>
                      <div class="input-group">
                        <input type="number" class="form-control" name="weight" value="<%= product.weight || '' %>" step="0.01" min="0">
                        <select class="form-select" name="weightUnit" style="max-width: 100px;">
                          <option value="kg" <%= product.weightUnit === 'kg' ? 'selected' : '' %>>kg</option>
                          <option value="lb" <%= product.weightUnit === 'lb' ? 'selected' : '' %>>lb</option>
                          <option value="g" <%= product.weightUnit === 'g' ? 'selected' : '' %>>g</option>
                          <option value="oz" <%= product.weightUnit === 'oz' ? 'selected' : '' %>>oz</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:length') %></label>
                      <input type="number" class="form-control" name="length" value="<%= product.length || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:width') %></label>
                      <input type="number" class="form-control" name="width" value="<%= product.width || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:height') %></label>
                      <div class="input-group">
                        <input type="number" class="form-control" name="height" value="<%= product.height || '' %>" step="0.01" min="0">
                        <select class="form-select" name="dimensionUnit" style="max-width: 80px;">
                          <option value="cm" <%= product.dimensionUnit === 'cm' ? 'selected' : '' %>>cm</option>
                          <option value="in" <%= product.dimensionUnit === 'in' ? 'selected' : '' %>>in</option>
                          <option value="m" <%= product.dimensionUnit === 'm' ? 'selected' : '' %>>m</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Order Limits & Policies -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-shield-alt me-2"></i><%= t('product:orderLimits') %></h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:minOrderQuantity') %></label>
                      <input type="number" class="form-control" name="minOrderQuantity" value="<%= product.minOrderQuantity || 1 %>" min="1" step="1">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('product:maxOrderQuantity') %></label>
                      <input type="number" class="form-control" name="maxOrderQuantity" value="<%= product.maxOrderQuantity || '' %>" min="1" step="1" placeholder="<%= t('product:noLimit') %>">
                    </div>
                  </div>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:warranty') %></label>
                  <textarea class="form-control" name="warranty" rows="2"><%= product.warranty || '' %></textarea>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.returnPolicy') %></label>
                  <textarea class="form-control" name="returnPolicy" rows="2"><%= product.returnPolicy || '' %></textarea>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.externalId') %></label>
                  <input type="text" class="form-control" name="externalId" value="<%= product.externalId || '' %>" placeholder="<%= t('shared:common.externalId') %>">
                </div>
              </div>
            </div>

            <!-- Product Attributes -->
            <% if ((productAttributes && productAttributes.length > 0) || (allAttributes && allAttributes.length > 0)) { %>
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-sliders-h me-2"></i><%= t('product:productAttributes') %></h3>
              </div>
              <div class="card-body">
                <% if (productAttributes && productAttributes.length > 0) { %>
                  <% productAttributes.forEach(function(pa) { %>
                  <div class="form-group mb-3">
                    <label class="form-label"><%= pa.attribute.name %> <small class="text-muted">(<%= pa.attribute.code %>)</small></label>
                    <% if (pa.attribute.type === 'text') { %>
                      <input type="text" class="form-control" name="attr_<%= pa.attributeId %>" value="<%= pa.value || pa.valueText || '' %>">
                    <% } else if (pa.attribute.type === 'number') { %>
                      <input type="number" class="form-control" name="attr_<%= pa.attributeId %>" value="<%= pa.valueNumeric || pa.value || '' %>" step="any">
                    <% } else if (pa.attribute.type === 'checkbox') { %>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="attr_<%= pa.attributeId %>" value="true" <%= pa.valueBoolean ? 'checked' : '' %>>
                        <label class="form-check-label"><%= t('shared:common.enabled') %></label>
                      </div>
                    <% } else { %>
                      <input type="text" class="form-control" name="attr_<%= pa.attributeId %>" value="<%= pa.value || '' %>">
                    <% } %>
                  </div>
                  <% }); %>
                <% } else { %>
                  <p class="text-muted mb-0"><%= t('product:noAttributes') %></p>
                <% } %>
              </div>
            </div>
            <% } %>

            <!-- Variants (read-only summary) -->
            <% if (product.variants && product.variants.length > 0) { %>
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-layer-group me-2"></i><%= t('product:variants') %> (<%= product.variants.length %>)</h3>
              </div>
              <div class="card-body table-responsive p-0">
                <table class="table table-sm table-hover mb-0">
                  <thead>
                    <tr>
                      <th><%= t('common.name') %></th>
                      <th><%= t('shared:common.sku') %></th>
                      <th><%= t('shared:common.barcode') %></th>
                      <th><%= t('product:attribute') %></th>
                      <th class="text-right"><%= t('common.price') %></th>
                      <th class="text-center"><%= t('shared:common.stock') %></th>
                      <th class="text-center"><%= t('common.status') %></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% product.variants.forEach(function(variant) { %>
                    <tr>
                      <td>
                        <strong><%= variant.name %></strong>
                        <% if (variant.isDefault) { %><span class="badge badge-primary ml-1"><%= t('shared:common.default') %></span><% } %>
                      </td>
                      <td><code><%= variant.sku %></code></td>
                      <td><code><%= variant.barcode || '-' %></code></td>
                      <td>
                        <% if (variant.attributes && variant.attributes.length > 0) { %>
                          <% variant.attributes.forEach(function(attr) { %>
                            <span class="badge badge-outline-secondary mr-1"><%= attr.attributeName %>: <%= attr.displayValue || attr.value %></span>
                          <% }); %>
                        <% } else { %>
                          <span class="text-muted">-</span>
                        <% } %>
                      </td>
                      <td class="text-right"><%= product.currency %> <%= variant.effectivePrice.toFixed(2) %></td>
                      <td class="text-center">
                        <% if (variant.isLowStock) { %>
                          <span class="badge badge-warning"><%= variant.stockQuantity %></span>
                        <% } else if (variant.isInStock) { %>
                          <span class="badge badge-success"><%= variant.stockQuantity %></span>
                        <% } else { %>
                          <span class="badge badge-danger">0</span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <% if (variant.isActive) { %>
                          <span class="badge badge-success"><%= t('common.active') %></span>
                        <% } else { %>
                          <span class="badge badge-secondary"><%= t('common.inactive') %></span>
                        <% } %>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <div class="card-footer text-muted">
                <small><%= t('common.variantsManagedViaApi') %></small>
              </div>
            </div>
            <% } %>

            <!-- Images (read-only summary) -->
            <% if (product.images && product.images.length > 0) { %>
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-images me-2"></i><%= t('product:images') %> (<%= product.images.length %>)</h3>
              </div>
              <div class="card-body">
                <div class="row">
                  <% product.images.forEach(function(img) { %>
                  <div class="col-md-3 col-6 mb-3">
                    <div class="position-relative">
                      <img src="<%= img.url %>" alt="<%= img.altText || product.name %>" class="img-fluid rounded" style="border: 1px solid #ddd;">
                      <% if (img.isPrimary) { %>
                        <span class="badge badge-primary position-absolute" style="top: 5px; left: 20px;"><%= t('shared:common.primary') %></span>
                      <% } %>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
              <div class="card-footer text-muted">
                <small><%= t('common.imagesManagedViaApi') %></small>
              </div>
            </div>
            <% } %>

            <!-- SEO -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-search me-2"></i><%= t('common.seo') %></h3>
              </div>
              <div class="card-body">
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.metaTitle') %></label>
                  <input type="text" class="form-control" name="metaTitle" value="<%= product.metaTitle || '' %>" maxlength="70">
                  <small class="text-muted"><%= t('product:seoRecommendedTitle') %></small>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.metaDescription') %></label>
                  <textarea class="form-control" name="metaDescription" rows="2" maxlength="160"><%= product.metaDescription || '' %></textarea>
                  <small class="text-muted"><%= t('product:seoRecommendedDesc') %></small>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:metaKeywords') %></label>
                  <input type="text" class="form-control" name="metaKeywords" value="<%= product.metaKeywords || '' %>">
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="col-lg-4">
            <!-- Publish -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-paper-plane me-2"></i><%= t('product:publish') %></h3>
              </div>
              <div class="card-body">
                <div class="d-flex justify-content-between mb-3">
                  <span><%= t('common.status') %>:</span>
                  <span class="badge bg-<%= product.status === 'active' ? 'success' : product.status === 'draft' ? 'warning' : 'secondary' %>">
                    <%= product.status %>
                  </span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                  <span><%= t('product:visibility') %>:</span>
                  <span class="badge bg-info"><%= product.visibility %></span>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('common.status') %></label>
                  <select class="form-select" name="status">
                    <option value="draft" <%= product.status === 'draft' ? 'selected' : '' %>><%= t('shared:common.draft') %></option>
                    <option value="active" <%= product.status === 'active' ? 'selected' : '' %>><%= t('common.active') %></option>
                    <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>><%= t('common.inactive') %></option>
                    <option value="archived" <%= product.status === 'archived' ? 'selected' : '' %>><%= t('product:archived') %></option>
                  </select>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:visibility') %></label>
                  <select class="form-select" name="visibility">
                    <option value="visible" <%= product.visibility === 'visible' ? 'selected' : '' %>><%= t('product:visible') %></option>
                    <option value="hidden" <%= product.visibility === 'hidden' ? 'selected' : '' %>><%= t('product:hidden') %></option>
                    <option value="catalog" <%= product.visibility === 'catalog' ? 'selected' : '' %>><%= t('product:catalogOnly') %></option>
                    <option value="search" <%= product.visibility === 'search' ? 'selected' : '' %>><%= t('product:searchOnly') %></option>
                  </select>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 mb-2">
                  <i class="fas fa-save me-2"></i><%= t('shared:common.saveChanges') %>
                </button>
                <a href="/admin/products/<%= product.productId %>" class="btn btn-secondary w-100">
                  <i class="fas fa-times me-2"></i><%= t('common.cancel') %>
                </a>
              </div>
            </div>

            <!-- Organization -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-folder me-2"></i><%= t('product:organization') %></h3>
              </div>
              <div class="card-body">
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('product:productType') %></label>
                  <select class="form-select" name="productTypeId">
                    <option value=""><%= t('shared:common.selectType') %></option>
                    <% (productTypes || []).forEach(function(type) { %>
                    <option value="<%= type.productTypeId %>" <%= product.productTypeId === type.productTypeId ? 'selected' : '' %>><%= type.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('common.category') %></label>
                  <select class="form-select" name="categoryId">
                    <option value=""><%= t('product:selectCategory') %></option>
                    <% (categories || []).forEach(function(cat) { %>
                    <option value="<%= cat.productCategoryId %>" <%= product.categoryId === cat.productCategoryId ? 'selected' : '' %>><%= cat.name %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.tags') %></label>
                  <input type="text" class="form-control" name="tags" value="<%= (product.tags || []).join(', ') %>" placeholder="tag1, tag2, tag3">
                  <small class="text-muted"><%= t('product:commaSeparated') %></small>
                </div>
              </div>
            </div>

            <!-- Options -->
            <div class="card">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-cog me-2"></i><%= t('product:options') %></h3>
              </div>
              <div class="card-body">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isFeatured" value="true" id="isFeatured" <%= product.isFeatured ? 'checked' : '' %>>
                  <label class="form-check-label" for="isFeatured"><%= t('product:featuredProduct') %></label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isTaxable" value="true" id="isTaxable" <%= product.isTaxable !== false ? 'checked' : '' %>>
                  <label class="form-check-label" for="isTaxable"><%= t('product:taxable') %></label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isVirtual" value="true" id="isVirtual" <%= product.isVirtual ? 'checked' : '' %>>
                  <label class="form-check-label" for="isVirtual"><%= t('product:virtualProduct') %></label>
                </div>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" name="isDownloadable" value="true" id="isDownloadable" <%= product.isDownloadable ? 'checked' : '' %>>
                  <label class="form-check-label" for="isDownloadable"><%= t('product:downloadable') %></label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="isSubscription" value="true" id="isSubscription" <%= product.isSubscription ? 'checked' : '' %>>
                  <label class="form-check-label" for="isSubscription"><%= t('product:subscriptionProduct') %></label>
                </div>
              </div>
            </div>

            <!-- Danger Zone -->
            <div class="card card-danger">
              <div class="card-header">
                <h3 class="card-title"><i class="fas fa-exclamation-triangle me-2"></i><%= t('product:dangerZone') %></h3>
              </div>
              <div class="card-body">
                <button type="button" class="btn btn-outline-danger w-100" onclick="deleteProduct()">
                  <i class="fas fa-trash me-2"></i><%= t('product:deleteProduct') %>
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
  async function deleteProduct() {
    if (!confirm('Are you sure you want to delete this product? This action cannot be undone.')) return;

    try {
      const response = await fetch('/admin/products/<%= product.productId %>', { method: 'DELETE' });
      const result = await response.json();
      if (result.success) {
        window.location.href = '/admin/products?success=' + encodeURIComponent('<%= t("common.deletedSuccess") %>');
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("common.error") %>: ' + error.message);
    }
  }
</script>

<%- include('../partials/footer') %>
