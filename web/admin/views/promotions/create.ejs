<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('promotion:create') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('dashboard.title') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/promotions"><%= t('shared:common.promotions') %></a></li>
            <li class="breadcrumb-item active"><%= t('common.create') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Error Messages -->
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-ban"></i> <%= error %>
        </div>
      <% } %>

      <div class="row">
        <div class="col-md-12">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title"><%= t('promotion:promotions.promotionDetails') %></h3>
            </div>

            <form action="/admin/promotions" method="POST">
              <div class="card-body">
                <!-- Basic Information -->
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="code"><%= t('promotion:promotions.promotionCode') %></label>
                      <input type="text" class="form-control" id="code" name="code"
                             value="<%= formData?.code || '' %>" required>
                      <small class="form-text text-muted"><%= t('promotion:promotions.promotionCodeHelp') %></small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="name"><%= t('promotion:promotions.promotionNameLabel') %></label>
                      <input type="text" class="form-control" id="name" name="name"
                             value="<%= formData?.name || '' %>" required>
                      <small class="form-text text-muted"><%= t('promotion:promotions.promotionNameHelp') %></small>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label for="description"><%= t('shared:common.description') %></label>
                  <textarea class="form-control" id="description" name="description" rows="3"><%= formData?.description || '' %></textarea>
                  <small class="form-text text-muted"><%= t('promotion:promotions.descriptionHelp') %></small>
                </div>

                <!-- Promotion Type and Value -->
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="type"><%= t('promotion:promotions.promotionType') %></label>
                      <select class="form-control" id="type" name="type" required onchange="updateDiscountLabel()">
                        <option value=""><%= t('shared:common.selectType') %></option>
                        <option value="percentage" <%= (formData?.type === 'percentage') ? 'selected' : '' %>><%= t('promotion:promotions.percentageDiscount') %></option>
                        <option value="fixed_amount" <%= (formData?.type === 'fixed_amount') ? 'selected' : '' %>><%= t('promotion:promotions.fixedAmountDiscount') %></option>
                        <option value="free_shipping" <%= (formData?.type === 'free_shipping') ? 'selected' : '' %>><%= t('shared:common.freeShipping') %></option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="discountValue" id="discountLabel"><%= t('promotion:promotions.discountValue') %></label>
                      <input type="number" class="form-control" id="discountValue" name="value"
                             value="<%= formData?.value || '' %>" step="0.01" min="0" required>
                      <small class="form-text text-muted" id="discountHelp"><%= t('promotion:promotions.discountHelp') %></small>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="isActive"><%= t('common.status') %></label>
                      <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="isActive" name="isActive" value="true"
                               <%= (formData?.isActive !== false) ? 'checked' : '' %>>
                        <label class="custom-control-label" for="isActive"><%= t('shared:common.active') %></label>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Conditions -->
                <h5 class="mt-4 mb-3"><%= t('promotion:promotions.conditions') %></h5>
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="minimumOrderAmount"><%= t('promotion:coupon.minOrderAmount') %></label>
                      <input type="number" class="form-control" id="minimumOrderAmount" name="minOrderAmount"
                             value="<%= formData?.minOrderAmount || '' %>" step="0.01" min="0">
                      <small class="form-text text-muted"><%= t('promotion:promotions.minimumOrderHelp') %></small>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="maximumDiscountAmount"><%= t('promotion:coupon.maxDiscountAmount') %></label>
                      <input type="number" class="form-control" id="maximumDiscountAmount" name="maxDiscountAmount"
                             value="<%= formData?.maxDiscountAmount || '' %>" step="0.01" min="0">
                      <small class="form-text text-muted"><%= t('promotion:promotions.maximumDiscountHelp') %></small>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="usageLimit"><%= t('promotion:promotions.usageLimit') %></label>
                      <input type="number" class="form-control" id="usageLimit" name="usageLimit"
                             value="<%= formData?.usageLimit || '' %>" min="1">
                      <small class="form-text text-muted"><%= t('promotion:promotions.usageLimitHelp') %></small>
                    </div>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="usageLimitPerCustomer"><%= t('promotion:promotions.usageLimitPerCustomer') %></label>
                      <input type="number" class="form-control" id="usageLimitPerCustomer" name="usageLimitPerCustomer"
                             value="<%= formData?.usageLimitPerCustomer || '' %>" min="1">
                      <small class="form-text text-muted"><%= t('promotion:promotions.usageLimitPerCustomerHelp') %></small>
                    </div>
                  </div>
                </div>

                <!-- Validity Period -->
                <h5 class="mt-4 mb-3"><%= t('promotion:promotions.validityPeriod') %></h5>
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="startsAt"><%= t('shared:common.startDate') %></label>
                      <input type="datetime-local" class="form-control" id="startsAt" name="startsAt"
                             value="<%= formData?.startsAt ? new Date(formData.startsAt).toISOString().slice(0,16) : '' %>">
                      <small class="form-text text-muted"><%= t('promotion:promotions.startDateHelp') %></small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="endsAt"><%= t('shared:common.endDate') %></label>
                      <input type="datetime-local" class="form-control" id="endsAt" name="endsAt"
                             value="<%= formData?.endsAt ? new Date(formData.endsAt).toISOString().slice(0,16) : '' %>">
                      <small class="form-text text-muted"><%= t('promotion:promotions.endDateHelp') %></small>
                    </div>
                  </div>
                </div>

                <!-- Condition Builder (Epic F) -->
                <h5 class="mt-4 mb-3">Rule Conditions</h5>
                <p class="text-muted small">Define conditions that must match for this promotion to apply.</p>
                <%- include('../partials/condition-builder', {
                  fieldName: 'conditions',
                  conditions: formData?.conditions || [],
                  attributes: [
                    { value: 'cartTotal', label: 'Cart Total' },
                    { value: 'itemQuantity', label: 'Item Quantity' },
                    { value: 'productCategory', label: 'Product Category' },
                    { value: 'customerGroup', label: 'Customer Group' },
                    { value: 'shippingMethod', label: 'Shipping Method' },
                    { value: 'paymentMethod', label: 'Payment Method' }
                  ]
                }) %>

                <!-- Stackability (Epic C) -->
                <h5 class="mt-4 mb-3">Stacking</h5>
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="stackability">Stackability</label>
                      <select class="form-control" id="stackability" name="stackability">
                        <option value="none" <%= (!formData?.stackability || formData?.stackability === 'none') ? 'selected' : '' %>>None (exclusive by default)</option>
                        <option value="stackable" <%= formData?.stackability === 'stackable' ? 'selected' : '' %>>Stackable (can combine with other stackable promos)</option>
                        <option value="exclusive" <%= formData?.stackability === 'exclusive' ? 'selected' : '' %>>Exclusive (blocks all other promos)</option>
                      </select>
                      <small class="form-text text-muted">Controls how this promotion interacts with others.</small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="priority">Priority</label>
                      <input type="number" class="form-control" id="priority" name="priority"
                             value="<%= formData?.priority || 0 %>" min="0">
                      <small class="form-text text-muted">Higher priority promotions are evaluated first.</small>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Promotion Preview Panel (Epic F) -->
              <div class="mt-4 p-3 bg-light rounded">
                <h5 class="mb-3"><i class="fas fa-eye me-2"></i>Promotion Preview</h5>
                <p class="text-muted small">Simulate this promotion against a sample cart to verify the discount.</p>
                <div class="row g-2 mb-2">
                  <div class="col-md-3">
                    <label class="form-label small">Sample Cart Total</label>
                    <input type="number" class="form-control form-control-sm" id="previewCartTotal" value="100" step="0.01">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Item Quantity</label>
                    <input type="number" class="form-control form-control-sm" id="previewItemQty" value="1" min="1">
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Customer Group</label>
                    <input type="text" class="form-control form-control-sm" id="previewCustomerGroup" placeholder="e.g. VIP">
                  </div>
                  <div class="col-md-3 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-primary btn-sm w-100" id="previewBtn">
                      <i class="fas fa-play me-1"></i>Preview Discount
                    </button>
                  </div>
                </div>
                <div id="previewResult" class="mt-2" style="display:none;"></div>
              </div>

              <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save"></i> <%= t('promotion:create') %>
                </button>
                <a href="/admin/promotions" class="btn btn-secondary">
                  <i class="fas fa-times"></i> <%= t('common.cancel') %>
                </a>
              </div>
            </form>

<script>
  document.getElementById('previewBtn').addEventListener('click', async function() {
    const cartTotal = parseFloat(document.getElementById('previewCartTotal').value) || 0;
    const itemQty = parseInt(document.getElementById('previewItemQty').value) || 1;
    const customerGroup = document.getElementById('previewCustomerGroup').value;
    const resultEl = document.getElementById('previewResult');
    resultEl.style.display = 'block';
    resultEl.innerHTML = '<div class="alert alert-info mb-0"><i class="fas fa-spinner fa-spin me-2"></i>Evaluating against active promotions...</div>';

    try {
      const resp = await fetch('/hub/promotions/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            productId: 'preview-product',
            name: 'Preview Item',
            quantity: itemQty,
            unitPriceCents: Math.round((cartTotal / itemQty) * 100),
          }],
          shippingAmount: 0,
          customerGroup: customerGroup || undefined,
          currency: 'USD',
        })
      });
      const result = await resp.json();

      if (result.success) {
        const discount = (result.totalDiscountAmountCents || 0) / 100;
        const freeShipping = result.freeShipping;
        const applied = result.appliedPromotions || [];
        let html = '<div class="alert ' + (discount > 0 || freeShipping ? 'alert-success' : 'alert-secondary') + ' mb-0">';
        html += '<strong>Discount: $' + discount.toFixed(2) + '</strong>';
        if (freeShipping) html += ' <span class="badge bg-info">Free Shipping</span>';
        html += '<br>Original Total: $' + cartTotal.toFixed(2) + ' → Final Total: $' + ((result.finalTotalCents !== undefined ? result.finalTotalCents / 100 : cartTotal - discount)).toFixed(2);
        if (applied.length > 0) {
          html += '<br><small class="text-muted">Applied promotions:</small><ul class="small mb-0">';
          applied.forEach(function(p) {
            html += '<li>' + p.name + ' (' + p.type + ') — $' + ((p.discountAmountCents || 0) / 100).toFixed(2) + '</li>';
          });
          html += '</ul>';
        } else {
          html += '<br><small class="text-muted">No promotions matched this cart.</small>';
        }
        if (result.message) html += '<br><small class="text-warning">' + result.message + '</small>';
        html += '</div>';
        resultEl.innerHTML = html;
      } else {
        resultEl.innerHTML = '<div class="alert alert-danger mb-0">' + (result.error || 'Preview failed') + '</div>';
      }
    } catch (err) {
      resultEl.innerHTML = '<div class="alert alert-danger mb-0">Error: ' + err.message + '</div>';
    }
  });
</script>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
function updateDiscountLabel() {
  const type = document.getElementById('type').value;
  const label = document.getElementById('discountLabel');
  const help = document.getElementById('discountHelp');

  switch(type) {
    case 'percentage':
      label.textContent = '<%= t("promotion:promotions.discountPercentage") %>';
      help.textContent = '<%= t("promotion:promotions.discountPercentageHelp") %>';
      document.getElementById('discountValue').placeholder = '10';
      break;
    case 'fixed_amount':
      label.textContent = '<%= t("promotion:promotions.discountAmount") %>';
      help.textContent = '<%= t("promotion:promotions.discountAmountHelp") %>';
      document.getElementById('discountValue').placeholder = '5.00';
      break;
    case 'free_shipping':
      label.textContent = '<%= t("promotion:promotions.discountValue") %>';
      help.textContent = '<%= t("promotion:promotions.discountValueNotUsed") %>';
      document.getElementById('discountValue').value = '0';
      document.getElementById('discountValue').disabled = true;
      break;
    default:
      label.textContent = '<%= t("promotion:promotions.discountValue") %>';
      help.textContent = '<%= t("promotion:promotions.discountHelp") %>';
      document.getElementById('discountValue').disabled = false;
  }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  updateDiscountLabel();
});
</script>
