<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= promotion.name %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('dashboard.title') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/promotions"><%= t('shared:common.promotions') %></a></li>
            <li class="breadcrumb-item active"><%= promotion.code %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Action Bar -->
      <div class="row mb-3">
        <div class="col-12">
          <a href="<%= `/admin/promotions/${promotion.promotionId}/edit` %>" class="btn btn-primary">
            <i class="fas fa-edit"></i> <%= t('promotion:edit') %>
          </a>
          <button class="btn btn-danger ml-2" onclick="deletePromotion('<%= promotion.promotionId %>', '<%= promotion.name %>')">
            <i class="fas fa-trash"></i> <%= t('promotion:promotions.deletePromotion') %>
          </button>
          <a href="/admin/promotions" class="btn btn-secondary ml-2">
            <i class="fas fa-arrow-left"></i> <%= t('promotion:promotions.backToPromotions') %>
          </a>
        </div>
      </div>

      <div class="row">
        <!-- Promotion Details -->
        <div class="col-md-8">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('promotion:promotions.promotionDetails') %></h3>
            </div>
            <div class="card-body">
              <dl class="row">
                <dt class="col-sm-3"><%= t('shared:common.code') %>:</dt>
                <dd class="col-sm-9"><code><%= promotion.code %></code></dd>

                <dt class="col-sm-3"><%= t('shared:common.name') %>:</dt>
                <dd class="col-sm-9"><%= promotion.name %></dd>

                <% if (promotion.description) { %>
                  <dt class="col-sm-3"><%= t('shared:common.description') %>:</dt>
                  <dd class="col-sm-9"><%= promotion.description %></dd>
                <% } %>

                <dt class="col-sm-3"><%= t('shared:common.type') %>:</dt>
                <dd class="col-sm-9">
                  <span class="badge badge-secondary"><%= promotion.type.replace('_', ' ') %></span>
                </dd>

                <dt class="col-sm-3"><%= t('shared:common.discount') %>:</dt>
                <dd class="col-sm-9">
                  <% if (promotion.type === 'percentage') { %>
                    <%= promotion.value %>% <%= t('promotion:promotions.off') %>
                  <% } else if (promotion.type === 'fixed_amount') { %>
                    $<%= promotion.value.toFixed(2) %>
                  <% } else { %>
                    <%= t('shared:common.freeShipping') %>
                  <% } %>
                </dd>

                <% if (promotion.minOrderAmount) { %>
                  <dt class="col-sm-3"><%= t('promotion:minOrder') %>:</dt>
                  <dd class="col-sm-9">$<%= promotion.minOrderAmount.toFixed(2) %></dd>
                <% } %>

                <% if (promotion.maxDiscountAmount) { %>
                  <dt class="col-sm-3"><%= t('promotion:promotions.maxDiscount') %>:</dt>
                  <dd class="col-sm-9">$<%= promotion.maxDiscountAmount.toFixed(2) %></dd>
                <% } %>

                <dt class="col-sm-3"><%= t('promotion:giftCard.usage') %>:</dt>
                <dd class="col-sm-9">
                  <%= promotion.usageCount || 0 %>
                  <% if (promotion.maxUsage) { %>
                    / <%= promotion.maxUsage %>
                  <% } %>
                </dd>

                <% if (promotion.maxUsagePerCustomer) { %>
                  <dt class="col-sm-3"><%= t('promotion:promotions.perCustomer') %>:</dt>
                  <dd class="col-sm-9"><%= promotion.maxUsagePerCustomer %> <%= t('promotion:giftCard.uses') %></dd>
                <% } %>

                <% if (promotion.startDate) { %>
                  <dt class="col-sm-3"><%= t('promotion:promotions.starts') %>:</dt>
                  <dd class="col-sm-9"><%= new Date(promotion.startDate).toLocaleString() %></dd>
                <% } %>

                <% if (promotion.endDate) { %>
                  <dt class="col-sm-3"><%= t('promotion:promotions.ends') %>:</dt>
                  <dd class="col-sm-9"><%= new Date(promotion.endDate).toLocaleString() %></dd>
                <% } %>

                <dt class="col-sm-3"><%= t('common.status') %>:</dt>
                <dd class="col-sm-9">
                  <span class="badge badge-<%= promotion.status === 'active' ? 'success' : promotion.status === 'expired' ? 'warning' : 'secondary' %>">
                    <%= promotion.status %>
                  </span>
                  <% if (!promotion.isActive) { %>
                    <small class="text-muted">(<%= t('shared:common.inactive') %>)</small>
                  <% } %>
                </dd>

                <dt class="col-sm-3"><%= t('shared:common.dateCreated') %>:</dt>
                <dd class="col-sm-9"><%= new Date(promotion.createdAt).toLocaleString() %></dd>

                <% if (promotion.updatedAt !== promotion.createdAt) { %>
                  <dt class="col-sm-3"><%= t('shared:common.dateUpdated') %>:</dt>
                  <dd class="col-sm-9"><%= new Date(promotion.updatedAt).toLocaleString() %></dd>
                <% } %>
              </dl>
            </div>
          </div>
        </div>

        <!-- Statistics Sidebar -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><%= t('promotion:promotions.statistics') %></h3>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-6">
                  <div class="description-block">
                    <h5 class="description-header"><%= promotion.usageCount || 0 %></h5>
                    <span class="description-text"><%= t('promotion:promotions.totalUses') %></span>
                  </div>
                </div>
                <div class="col-6">
                  <div class="description-block">
                    <h5 class="description-header">
                      <% if (promotion.usageLimit) { %>
                        <%= Math.round(((promotion.usageCount || 0) / promotion.usageLimit) * 100) %>%
                      <% } else { %>
                        N/A
                      <% } %>
                    </h5>
                    <span class="description-text"><%= t('promotion:promotions.usageRate') %></span>
                  </div>
                </div>
              </div>

              <% if (promotion.applicableProducts && promotion.applicableProducts.length > 0) { %>
                <hr>
                <h6><%= t('promotion:promotions.applicableProducts') %></h6>
                <small class="text-muted"><%= promotion.applicableProducts.length %> <%= t('promotion:promotions.products') %></small>
              <% } %>

              <% if (promotion.applicableCategories && promotion.applicableCategories.length > 0) { %>
                <hr>
                <h6><%= t('promotion:promotions.applicableCategories') %></h6>
                <small class="text-muted"><%= promotion.applicableCategories.length %> <%= t('promotion:promotions.categories') %></small>
              <% } %>

              <% if (promotion.applicableCustomerGroups && promotion.applicableCustomerGroups.length > 0) { %>
                <hr>
                <h6><%= t('shared:common.customerGroups') %></h6>
                <small class="text-muted"><%= promotion.applicableCustomerGroups.length %> <%= t('promotion:promotions.groups') %></small>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('promotion:promotions.deletePromotion') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('promotion:promotions.confirmDeleteShort') %> "<strong id="deletePromotionName"></strong>"?</p>
        <p class="text-danger"><small><%= t('promotion:promotions.deletePromotionWarning') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('promotion:promotions.deletePromotion') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function deletePromotion(promotionId, promotionName) {
  document.getElementById('deletePromotionName').textContent = promotionName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/promotions/${promotionId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        window.location.href = '/admin/promotions?success=' + encodeURIComponent('<%= t("promotion:promotions.deletedSuccess") %>');
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t("promotion:promotions.errorDeletingPromotion") %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}
</script>
