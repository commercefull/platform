<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('promotion:promotions.couponManagement') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('dashboard.title') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/promotions"><%= t('shared:common.promotions') %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.coupons') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Action Bar -->
      <div class="row mb-3">
        <div class="col-12">
          <a href="/admin/promotions/coupons/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> <%= t('promotion:coupon.create') %>
          </a>
          <div class="float-right">
            <span class="badge badge-info"><%= t('shared:common.total') %>: <%= coupons.length %></span>
            <span class="badge badge-success ml-2"><%= t('shared:common.active') %>: <%= activeCoupons %></span>
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="row mb-3">
        <div class="col-md-12">
          <div class="card">
            <div class="card-body">
              <form method="GET" class="form-inline">
                <div class="form-group mr-3">
                  <label for="isActive" class="mr-2"><%= t('common.status') %>:</label>
                  <select name="isActive" id="isActive" class="form-control">
                    <option value=""><%= t('promotion:promotions.allCoupons') %></option>
                    <option value="true" <%= filters.isActive === true ? 'selected' : '' %>><%= t('shared:common.active') %></option>
                    <option value="false" <%= filters.isActive === false ? 'selected' : '' %>><%= t('shared:common.inactive') %></option>
                  </select>
                </div>
                <button type="submit" class="btn btn-secondary mr-2">
                  <i class="fas fa-filter"></i> <%= t('common.filter') %>
                </button>
                <a href="/admin/promotions/coupons" class="btn btn-outline-secondary">
                  <i class="fas fa-times"></i> <%= t('common.clear') %>
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Coupons Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('shared:common.coupons') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('shared:common.code') %></th>
                <th><%= t('shared:common.name') %></th>
                <th><%= t('shared:common.type') %></th>
                <th><%= t('shared:common.discount') %></th>
                <th><%= t('promotion:giftCard.usage') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('shared:common.expires') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (coupons.length === 0) { %>
                <tr>
                  <td colspan="8" class="text-center py-4">
                    <em><%= t('promotion:coupon.noCoupons') %> <a href="/admin/promotions/coupons/create"><%= t('promotion:promotions.createFirstCoupon') %></a>.</em>
                  </td>
                </tr>
              <% } else { %>
                <% coupons.forEach(coupon => { %>
                  <tr>
                    <td>
                      <strong><code><%= coupon.code %></code></strong>
                    </td>
                    <td>
                      <%= coupon.name %>
                      <% if (coupon.description) { %>
                        <br><small class="text-muted"><%= coupon.description %></small>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-secondary"><%= coupon.type %></span>
                    </td>
                    <td>
                      <% if (coupon.discountAmount) { %>
                        <% if (coupon.type === 'percentage') { %>
                          <%= coupon.discountAmount %>%
                        <% } else { %>
                          <%= coupon.currencyCode %> <%= coupon.discountAmount %>
                        <% } %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <%= coupon.usageCount %>
                      <% if (coupon.maxUsage) { %>
                        / <%= coupon.maxUsage %>
                      <% } %>
                    </td>
                    <td>
                      <% if (coupon.isActive) { %>
                        <span class="badge badge-success"><%= t('shared:common.active') %></span>
                      <% } else { %>
                        <span class="badge badge-secondary"><%= t('shared:common.inactive') %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (coupon.endDate) { %>
                        <%= new Date(coupon.endDate).toLocaleDateString() %>
                      <% } else { %>
                        <span class="text-muted"><%= t('promotion:promotions.noExpiry') %></span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/promotions/coupons/<%= coupon.promotionCouponId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/promotions/coupons/<%= coupon.promotionCouponId %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                      </a>
                      <button class="btn btn-sm btn-danger" onclick="deleteCoupon('<%= coupon.promotionCouponId %>', '<%= coupon.name %>')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('promotion:promotions.deleteCoupon') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('promotion:promotions.confirmDeleteCoupon') %> "<strong id="deleteCouponName"></strong>"?</p>
        <p class="text-danger"><small><%= t('promotion:promotions.deleteWarning') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('promotion:promotions.deleteCoupon') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function deleteCoupon(couponId, couponName) {
  document.getElementById('deleteCouponName').textContent = couponName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/promotions/coupons/${couponId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t("promotion:coupon.errorDeletingCoupon") %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}
</script>
<% endcontent %>
