<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-shield-alt me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/hub"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item">Payment</li>
            <li class="breadcrumb-item active">Fraud Rules</li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-check-circle me-2"></i><%= success %>
      </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
      </div>
      <% } %>

      <!-- Pending Reviews -->
      <% if (pendingReviews && pendingReviews.length > 0) { %>
      <div class="card card-warning card-outline mb-3">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-clock me-2"></i>Pending Reviews (<%= pendingReviews.length %>)</h3>
        </div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <thead>
              <tr><th>Order ID</th><th>Customer</th><th>Risk Score</th><th>Status</th><th>Checked At</th></tr>
            </thead>
            <tbody>
              <% pendingReviews.forEach(function(rv) { %>
              <tr>
                <td><%= rv.orderId || '—' %></td>
                <td><%= rv.customerId || '—' %></td>
                <td><span class="badge bg-warning"><%= rv.riskScore %></span></td>
                <td><span class="badge bg-info"><%= rv.status %></span></td>
                <td><small><%= rv.checkedAt ? new Date(rv.checkedAt).toLocaleString() : '—' %></small></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <!-- Risk Score Simulator -->
      <div class="card card-primary card-outline mb-3">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-flask me-2"></i>Risk Score Simulator</h3>
        </div>
        <div class="card-body">
          <form id="simulator-form" class="row g-2">
            <div class="col-md-2">
              <label class="form-label">Email</label>
              <input type="email" class="form-control form-control-sm" name="email" placeholder="test@test.com">
            </div>
            <div class="col-md-2">
              <label class="form-label">IP Address</label>
              <input type="text" class="form-control form-control-sm" name="ipAddress" placeholder="1.2.3.4">
            </div>
            <div class="col-md-2">
              <label class="form-label">Billing Country</label>
              <input type="text" class="form-control form-control-sm" name="billingCountry" placeholder="US">
            </div>
            <div class="col-md-2">
              <label class="form-label">Order Amount</label>
              <input type="number" class="form-control form-control-sm" name="orderAmount" placeholder="100" step="0.01">
            </div>
            <div class="col-md-2">
              <label class="form-label">First Order?</label>
              <select class="form-select form-select-sm" name="isFirstOrder">
                <option value="false">No</option>
                <option value="true">Yes</option>
              </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="fas fa-play me-1"></i>Simulate
              </button>
            </div>
          </form>
          <div id="simulator-result" class="mt-2" style="display:none;">
            <div class="alert" id="simulator-alert"></div>
          </div>
        </div>
      </div>

      <!-- Create New Rule -->
      <div class="card card-primary">
        <div class="card-header">
          <h3 class="card-title"><i class="fas fa-plus me-2"></i>Create Fraud Rule</h3>
        </div>
        <form method="POST" action="/hub/payment/fraud/rules">
          <div class="card-body">
            <div class="row">
              <div class="col-md-4 mb-3">
                <label class="form-label">Rule Name</label>
                <input type="text" class="form-control" name="name" required>
              </div>
              <div class="col-md-3 mb-3">
                <label class="form-label">Rule Type</label>
                <select class="form-select" name="ruleType">
                  <option value="amount">Amount</option>
                  <option value="velocity">Velocity</option>
                  <option value="location">Location</option>
                  <option value="pattern">Pattern</option>
                  <option value="device">Device</option>
                  <option value="blacklist">Blacklist</option>
                  <option value="custom" selected>Custom</option>
                </select>
              </div>
              <div class="col-md-2 mb-3">
                <label class="form-label">Action</label>
                <select class="form-select" name="action">
                  <option value="review">Review</option>
                  <option value="block">Block</option>
                  <option value="allow">Allow</option>
                </select>
              </div>
              <div class="col-md-2 mb-3">
                <label class="form-label">Risk Score</label>
                <input type="number" class="form-control" name="riskScore" value="10" min="0" max="100">
              </div>
              <div class="col-md-1 mb-3">
                <label class="form-label">Active</label>
                <select class="form-select" name="isActive">
                  <option value="true" selected>Yes</option>
                  <option value="false">No</option>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea class="form-control" name="description" rows="2"></textarea>
            </div>

            <h5 class="mt-3 mb-2">Conditions</h5>
            <p class="text-muted small">Define conditions that trigger this fraud rule.</p>
            <%- include('../../partials/condition-builder', {
              fieldName: 'conditions',
              conditions: [],
              attributes: [
                { value: 'orderAmount', label: 'Order Amount' },
                { value: 'email', label: 'Customer Email' },
                { value: 'ipAddress', label: 'IP Address' },
                { value: 'billingCountry', label: 'Billing Country' },
                { value: 'shippingCountry', label: 'Shipping Country' },
                { value: 'isFirstOrder', label: 'Is First Order' },
                { value: 'isGuestCheckout', label: 'Is Guest Checkout' },
                { value: 'orderCountLast10Min', label: 'Order Count (10 min)' },
                { value: 'cardBin', label: 'Card BIN' },
                { value: 'avsResult', label: 'AVS Result' },
                { value: 'cvvResult', label: 'CVV Result' }
              ]
            }) %>
          </div>
          <div class="card-footer">
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save me-1"></i>Create Rule
            </button>
          </div>
        </form>
      </div>

      <!-- Existing Rules -->
      <div class="card mt-3">
        <div class="card-header">
          <h3 class="card-title">Existing Fraud Rules</h3>
        </div>
        <div class="card-body p-0">
          <table class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Action</th>
                <th>Risk Score</th>
                <th>Active</th>
                <th>Triggered</th>
                <th width="80">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!rules || rules.length === 0) { %>
              <tr><td colspan="7" class="text-center text-muted py-4">No fraud rules configured.</td></tr>
              <% } else { %>
                <% rules.forEach(function(rule) { %>
                <tr>
                  <td><%= rule.name %></td>
                  <td><span class="badge bg-info"><%= rule.ruleType %></span></td>
                  <td>
                    <% if (rule.action === 'block') { %>
                      <span class="badge bg-danger">Block</span>
                    <% } else if (rule.action === 'review') { %>
                      <span class="badge bg-warning">Review</span>
                    <% } else { %>
                      <span class="badge bg-success">Allow</span>
                    <% } %>
                  </td>
                  <td><%= rule.riskScore %></td>
                  <td>
                    <% if (rule.isActive) { %>
                      <i class="fas fa-check text-success"></i>
                    <% } else { %>
                      <i class="fas fa-times text-danger"></i>
                    <% } %>
                  </td>
                  <td><%= rule.triggerCount || 0 %></td>
                  <td>
                    <button class="btn btn-outline-danger btn-sm" onclick="deleteRule('<%= rule.fraudRuleId %>')">
                      <i class="fas fa-trash"></i>
                    </button>
                  </td>
                </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  // Risk Score Simulator
  document.getElementById('simulator-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = {};
    formData.forEach((val, key) => { data[key] = val; });
    data.orderAmount = parseFloat(data.orderAmount) || 0;
    data.currency = 'USD';

    try {
      const resp = await fetch('/hub/payment/fraud/simulate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await resp.json();
      const alertEl = document.getElementById('simulator-alert');
      const resultEl = document.getElementById('simulator-result');
      resultEl.style.display = 'block';

      if (result.success) {
        const cls = result.decision === 'blocked' ? 'alert-danger' :
                     result.decision === 'review' ? 'alert-warning' : 'alert-success';
        alertEl.className = 'alert ' + cls;
        let html = '<strong>Decision: ' + result.decision.toUpperCase() + '</strong><br>';
        html += 'Risk Score: ' + result.riskScore + ' (' + result.riskLevel + ')<br>';
        if (result.triggeredRules && result.triggeredRules.length > 0) {
          html += 'Triggered Rules:<ul>';
          result.triggeredRules.forEach(function(r) {
            html += '<li>' + r.name + ' (' + r.action + ')</li>';
          });
          html += '</ul>';
        }
        alertEl.innerHTML = html;
      } else {
        alertEl.className = 'alert alert-danger';
        alertEl.textContent = result.error || 'Simulation failed';
      }
    } catch (err) {
      const alertEl = document.getElementById('simulator-alert');
      const resultEl = document.getElementById('simulator-result');
      resultEl.style.display = 'block';
      alertEl.className = 'alert alert-danger';
      alertEl.textContent = 'Error: ' + err.message;
    }
  });

  // Delete rule
  async function deleteRule(ruleId) {
    if (!confirm('Delete this fraud rule?')) return;
    try {
      const resp = await fetch('/hub/payment/fraud/rules/' + ruleId, { method: 'DELETE' });
      const result = await resp.json();
      if (result.success) {
        location.reload();
      } else {
        alert(result.error || 'Failed to delete rule');
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  }
</script>

<%- include('../../partials/footer') %>
