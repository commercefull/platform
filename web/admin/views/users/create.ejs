<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-user-plus me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/users"><%= t('users:adminUsers') %></a></li>
            <li class="breadcrumb-item active"><%= t('common.create') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-8">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title"><%= t('users:newAdminUser') %></h3>
            </div>
            <form id="createUserForm">
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.firstName') %></label>
                      <input type="text" class="form-control" name="firstName" placeholder="John">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.lastName') %></label>
                      <input type="text" class="form-control" name="lastName" placeholder="Doe">
                    </div>
                  </div>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.email') %> <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" name="email" required placeholder="admin@example.com">
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.password') %> <span class="text-danger">*</span></label>
                  <input type="password" class="form-control" name="password" required minlength="8" placeholder="<%= t('common.minEightChars') %>">
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.confirmPassword') %> <span class="text-danger">*</span></label>
                  <input type="password" class="form-control" name="confirmPassword" required placeholder="<%= t('common.confirmPasswordPlaceholder') %>">
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.role') %></label>
                  <select class="form-control" name="roleId">
                    <option value=""><%= t('users:noRole') %></option>
                    <% (roles || []).forEach(function(role) { %>
                    <option value="<%= role.roleId %>"><%= role.name %></option>
                    <% }); %>
                  </select>
                </div>
              </div>
              <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-2"></i><%= t('users:create') %>
                </button>
                <a href="/admin/users" class="btn btn-secondary ms-2"><%= t('common.cancel') %></a>
              </div>
            </form>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-info-circle me-2"></i><%= t('users:passwordRequirements') %></h3>
            </div>
            <div class="card-body">
              <ul class="list-unstyled mb-0">
                <li><i class="fas fa-check text-success me-2"></i><%= t('shared:common.minEightChars') %></li>
                <li><i class="fas fa-check text-success me-2"></i><%= t('users:oneUppercase') %></li>
                <li><i class="fas fa-check text-success me-2"></i><%= t('users:oneLowercase') %></li>
                <li><i class="fas fa-check text-success me-2"></i><%= t('users:oneNumber') %></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.getElementById('createUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);

    if (data.password !== data.confirmPassword) {
      alert('<%= t("users:passwordsDoNotMatch") %>');
      return;
    }

    delete data.confirmPassword;

    try {
      const response = await fetch('/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        window.location.href = '/admin/users/' + result.userId;
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("common.error") %>: ' + error.message);
    }
  });
</script>

<%- include('../partials/footer') %>
