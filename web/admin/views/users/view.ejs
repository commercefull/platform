<%- include('../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-user me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/users"><%= t('users:adminUsers') %></a></li>
            <li class="breadcrumb-item active"><%= t('shared:common.details') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <div class="row">
        <div class="col-lg-6">
          <!-- User Info -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-info-circle me-2"></i><%= t('users:userInformation') %></h3>
            </div>
            <div class="card-body">
              <form id="updateUserForm">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.firstName') %></label>
                      <input type="text" class="form-control" name="firstName" value="<%= adminUser.firstName || '' %>">
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group mb-3">
                      <label class="form-label"><%= t('shared:common.lastName') %></label>
                      <input type="text" class="form-control" name="lastName" value="<%= adminUser.lastName || '' %>">
                    </div>
                  </div>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.email') %></label>
                  <input type="email" class="form-control" value="<%= adminUser.email %>" readonly>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('common.status') %></label>
                  <select class="form-control" name="status">
                    <option value="active" <%= adminUser.status === 'active' ? 'selected' : '' %>><%= t('common.active') %></option>
                    <option value="inactive" <%= adminUser.status === 'inactive' ? 'selected' : '' %>><%= t('common.inactive') %></option>
                    <option value="suspended" <%= adminUser.status === 'suspended' ? 'selected' : '' %>><%= t('shared:common.suspended') %></option>
                  </select>
                </div>
                <div class="form-group mb-3">
                  <label class="form-label"><%= t('shared:common.role') %></label>
                  <select class="form-control" name="roleId">
                    <option value=""><%= t('users:noRole') %></option>
                    <% (roles || []).forEach(function(role) { %>
                    <option value="<%= role.roleId %>" <%= adminUser.roleId === role.roleId ? 'selected' : '' %>>
                      <%= role.name %>
                    </option>
                    <% }); %>
                  </select>
                </div>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-2"></i><%= t('shared:common.saveChanges') %>
                </button>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <!-- Account Stats -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-chart-bar me-2"></i><%= t('users:accountStatistics') %></h3>
            </div>
            <div class="card-body">
              <table class="table table-borderless">
                <tr>
                  <th><%= t('users:userId') %></th>
                  <td><code><%= adminUser.userId %></code></td>
                </tr>
                <tr>
                  <th><%= t('shared:common.dateCreated') %></th>
                  <td><%= new Date(adminUser.createdAt).toLocaleString() %></td>
                </tr>
                <tr>
                  <th><%= t('shared:common.lastLogin') %></th>
                  <td><%= adminUser.lastLoginAt ? new Date(adminUser.lastLoginAt).toLocaleString() : t('shared:common.never') %></td>
                </tr>
                <tr>
                  <th><%= t('users:loginCount') %></th>
                  <td><%= adminUser.loginCount || 0 %></td>
                </tr>
                <tr>
                  <th><%= t('users:emailVerified') %></th>
                  <td>
                    <span class="badge bg-<%= adminUser.emailVerified ? 'success' : 'warning' %>">
                      <%= adminUser.emailVerified ? t('common.yes') : t('common.no') %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <th><%= t('users:mfaEnabled') %></th>
                  <td>
                    <span class="badge bg-<%= adminUser.mfaEnabled ? 'success' : 'secondary' %>">
                      <%= adminUser.mfaEnabled ? t('common.yes') : t('common.no') %>
                    </span>
                  </td>
                </tr>
              </table>
            </div>
          </div>

          <!-- Permissions -->
          <div class="card">
            <div class="card-header">
              <h3 class="card-title"><i class="fas fa-shield-alt me-2"></i><%= t('common.permissions') %></h3>
            </div>
            <div class="card-body">
              <% if ((permissions || []).length > 0) { %>
                <% permissions.forEach(function(perm) { %>
                  <span class="badge bg-info me-1 mb-1"><%= perm %></span>
                <% }); %>
              <% } else { %>
                <p class="text-muted mb-0"><%= t('users:noPermissionsAssigned') %></p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="row">
        <div class="col-12">
          <a href="/admin/users" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i><%= t('users:backToUsers') %>
          </a>
          <button class="btn btn-danger float-end" onclick="deleteUser()">
            <i class="fas fa-trash me-2"></i><%= t('users:deleteUser') %>
          </button>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  document.getElementById('updateUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);

    try {
      const response = await fetch('/admin/users/<%= adminUser.userId %>', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (result.success) {
        alert('<%= t("users:userUpdatedSuccess") %>');
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("common.error") %>: ' + error.message);
    }
  });

  async function deleteUser() {
    if (!confirm('<%= t("users:confirmDelete") %>')) return;

    try {
      const response = await fetch('/admin/users/<%= adminUser.userId %>', { method: 'DELETE' });
      const result = await response.json();
      if (result.success) {
        window.location.href = '/admin/users';
      } else {
        alert('<%= t("common.error") %>: ' + result.message);
      }
    } catch (error) {
      alert('<%= t("common.error") %>: ' + error.message);
    }
  }
</script>

<%- include('../partials/footer') %>
