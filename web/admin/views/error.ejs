<div class="error-page">
  <h2 class="headline text-warning"> 500</h2>

  <div class="error-content">
    <h3><i class="fas fa-exclamation-triangle text-warning"></i> <%= t('common.internalError') %></h3>

    <p>
      <%= t('common.errorDescription') %>
      <%= t('common.meanwhile') %> <a href="/admin"><%= t('common.returnToDashboard') %></a> <%= t('common.orTrySearch') %>.
    </p>

    <form class="search-form">
      <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="<%= t('common.searchPlaceholder') %>">

        <div class="input-group-append">
          <button type="submit" name="submit" class="btn btn-warning"><i class="fas fa-search"></i>
          </button>
        </div>
      </div>
      <!-- /.input-group -->
    </form>
  </div>
</div>
