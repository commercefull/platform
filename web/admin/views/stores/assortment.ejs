<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto">
      <% if (store) { %>
      <a href="/admin/stores/<%= store.storeId %>" class="btn btn-outline-secondary"><%= t('common.back') %></a>
      <% } else { %>
      <a href="/admin/stores" class="btn btn-outline-secondary"><%= t('common.back') %></a>
      <% } %>
    </div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include('../partials/alerts') %>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible" role="alert">
      <div class="d-flex"><div><%= error %></div></div>
      <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
    <% } %>
    <% if (store) { %>
    <div class="row">
      <div class="col-md-8">
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Assortment mode</h3></div>
          <div class="card-body">
            <p class="text-muted small">
              <strong>All</strong> sells every product unless an entry excludes it.
              <strong>Include</strong> sells only listed targets.
              <strong>Exclude</strong> sells everything except listed targets.
            </p>
            <form method="POST" action="/admin/stores/<%= store.storeId %>/assortment/mode" class="row g-2 align-items-end">
              <div class="col-md-6">
                <label class="form-label">Mode</label>
                <select class="form-select" name="mode" required>
                  <option value="all" <%= mode === 'all' ? 'selected' : '' %>>All products</option>
                  <option value="include" <%= mode === 'include' ? 'selected' : '' %>>Include list only</option>
                  <option value="exclude" <%= mode === 'exclude' ? 'selected' : '' %>>All except exclusions</option>
                </select>
              </div>
              <div class="col-md-3">
                <button type="submit" class="btn btn-primary">Save mode</button>
              </div>
            </form>
          </div>
        </div>

        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">Assortment entries (<%= (entries || []).length %>)</h3></div>
          <div class="card-body">
            <% if ((entries || []).length === 0) { %>
              <p class="text-muted">No ranging entries — the mode above applies store-wide.</p>
            <% } else { %>
              <div class="table-responsive mb-4">
                <table class="table table-vcenter">
                  <thead>
                    <tr>
                      <th>Target</th>
                      <th>Effect</th>
                      <th>Channel</th>
                      <th>Position</th>
                      <th>Hidden</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% entries.forEach(function(entry) { %>
                      <tr>
                        <td><span class="badge bg-azure-lt me-1"><%= entry.targetType %></span><code><%= entry.targetId %></code></td>
                        <td><span class="badge <%= entry.effect === 'include' ? 'bg-green-lt' : 'bg-red-lt' %>"><%= entry.effect %></span></td>
                        <td>
                          <% if (entry.channelId) { %>
                            <% const ch = (channelAssignments || []).find(function(a) { return a.salesChannelId === entry.channelId; }); %>
                            <%= ch && ch.channel ? ch.channel.name : entry.channelId %>
                          <% } else { %>
                            All channels
                          <% } %>
                        </td>
                        <td><%= entry.position ?? '—' %></td>
                        <td><%= entry.isHidden ? 'Yes' : 'No' %></td>
                        <td class="text-end">
                          <form method="POST" action="/admin/stores/<%= store.storeId %>/assortment/entries/<%= entry.assortmentStoreEntryId %>/remove" style="display:inline">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
            <h4>Add entry</h4>
            <form method="POST" action="/admin/stores/<%= store.storeId %>/assortment/entries" class="row g-2 align-items-end">
              <div class="col-md-3">
                <label class="form-label">Target type</label>
                <select class="form-select" name="targetType" required>
                  <option value="product">Product</option>
                  <option value="collection">Collection</option>
                  <option value="category">Category</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Target ID</label>
                <input class="form-control" name="targetId" placeholder="productId / collectionId / categoryId" required>
              </div>
              <div class="col-md-2">
                <label class="form-label">Effect</label>
                <select class="form-select" name="effect" required>
                  <option value="include">Include</option>
                  <option value="exclude">Exclude</option>
                </select>
              </div>
              <div class="col-md-2">
                <label class="form-label">Channel <span class="text-muted">(optional)</span></label>
                <select class="form-select" name="channelId">
                  <option value="">All channels</option>
                  <% (channelAssignments || []).forEach(function(assignment) { %>
                    <% if (assignment.channel) { %>
                    <option value="<%= assignment.salesChannelId %>"><%= assignment.channel.name %> (<%= assignment.channel.code %>)</option>
                    <% } %>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-1">
                <label class="form-label">Position</label>
                <input type="number" class="form-control" name="position" min="0">
              </div>
              <div class="col-md-1">
                <label class="form-check">
                  <input class="form-check-input" type="checkbox" name="isHidden">
                  <span class="form-check-label">Hidden</span>
                </label>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary">Add entry</button>
              </div>
            </form>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-header"><h3 class="card-title">About channel-scoped entries</h3></div>
          <div class="card-body text-muted small">
            Entries scoped to a channel only apply for requests attributed to that
            sales channel — store-wide entries (no channel) apply everywhere.
            The storefront, basket sellability checks, and agentic feeds all
            evaluate these entries.
          </div>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="card"><div class="card-body text-center text-muted">Store not found.</div></div>
    <% } %>
  </div>
</section>
