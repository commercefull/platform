<div class="page-header d-print-none"><div class="row g-2 align-items-center"><div class="col"><h2 class="page-title"><%= pageName %></h2></div><div class="col-auto ms-auto"><a href="/admin/stores/<%= store?.storeId %>" class="btn btn-outline-secondary"><%= t('common.back') %></a></div></div></div>
<section class="content"><div class="container-fluid"><%- include('../partials/alerts') %><div class="row"><div class="col-md-5"><div class="card"><div class="card-header"><h3 class="card-title"><%= t('store.assignUser') %></h3></div><div class="card-body"><form method="POST" action="/admin/stores/<%= store?.storeId %>/users"><div class="mb-3"><label class="form-label"><%= t('shared:common.usersRoles') %> <%= t('common.id') %></label><input class="form-control" name="userId" required></div><div class="mb-3"><label class="form-label"><%= t('common.role') %></label><select class="form-select" name="role"><option value="cashier">Cashier</option><option value="manager">Manager</option><option value="admin">Admin</option></select></div><div class="mb-3"><label class="form-label"><%= t('common.permissions') %></label><input class="form-control" name="permissions" placeholder="comma,separated,permissions"></div><button class="btn btn-primary" type="submit"><%= t('store.assignUser') %></button></form></div></div></div><div class="col-md-7"><div class="card"><div class="card-header"><h3 class="card-title"><%= t('store.assignedUsers') %></h3></div><div class="card-body table-responsive p-0"><table class="table table-hover"><thead><tr><th><%= t('shared:common.usersRoles') %></th><th><%= t('common.role') %></th><th><%= t('store.primary') %></th><th><%= t('common.active') %></th><th></th></tr></thead><tbody><% (users || []).forEach(function(user) { %><tr><td><code><%= user.userId %></code></td><td><%= user.role %></td><td><%= user.isPrimary ? t('common.yes') : t('common.no') %></td><td><%= user.isActive ? t('common.yes') : t('common.no') %></td><td><form method="POST" action="/admin/stores/<%= store?.storeId %>/users/<%= user.userId %>?_method=DELETE"><button class="btn btn-sm btn-outline-danger" type="submit"><%= t('common.remove') %></button></form></td></tr><% }) %><% if (!users || users.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4"><%= t('store.noUsers') %></td></tr><% } %></tbody></table></div></div></div></div></div></section>
