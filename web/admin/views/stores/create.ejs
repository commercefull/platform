<div class="page-header d-print-none"><div class="row g-2 align-items-center"><div class="col"><h2 class="page-title"><%= pageName %></h2></div><div class="col-auto ms-auto"><a href="/admin/stores" class="btn btn-outline-secondary"><%= t('common.back') %></a></div></div></div>
<section class="content"><div class="container-fluid"><%- include('../partials/alerts') %><div class="card"><div class="card-body"><form method="POST" action="/admin/stores"><div class="row"><div class="col-md-6 mb-3"><label class="form-label"><%= t('common.name') %></label><input class="form-control" name="name" value="<%= formData.name || '' %>" required></div><div class="col-md-6 mb-3"><label class="form-label"><%= t('store.storeType') %></label><select class="form-select" name="storeType"><option value="business_store"><%= t('store.businessStore') %></option><option value="merchant_store"><%= t('store.merchantStore') %></option></select></div><div class="col-md-6 mb-3"><label class="form-label"><%= t('shared:common.organizations') %></label><select class="form-select" name="businessId"><option value=""><%= t('store.selectOrganization') %></option><% (organizations || []).forEach(function(organization) { %><option value="<%= organization.organizationId %>"><%= organization.name %></option><% }) %></select></div><div class="col-md-6 mb-3"><label class="form-label"><%= t('store.parentStore') %></label><select class="form-select" name="parentStoreId"><option value=""><%= t('common.none') %></option><% (stores || []).forEach(function(store) { %><option value="<%= store.storeId %>"><%= store.name %></option><% }) %></select></div><div class="col-12 mb-3"><label class="form-label"><%= t('common.description') %></label><textarea class="form-control" name="description" rows="3"><%= formData.description || '' %></textarea></div><div class="col-md-6 mb-3"><label class="form-label"><%= t('layout.email') %></label><input class="form-control" name="storeEmail" value="<%= formData.storeEmail || '' %>"></div><div class="col-md-6 mb-3"><label class="form-label"><%= t('common.phone') %></label><input class="form-control" name="storePhone" value="<%= formData.storePhone || '' %>"></div><div class="col-md-3 mb-3"><label class="form-label"><%= t('store.addressLine1') %></label><input class="form-control" name="addressLine1" value="<%= formData.addressLine1 || '' %>"></div><div class="col-md-3 mb-3"><label class="form-label"><%= t('localization.city') %></label><input class="form-control" name="city" value="<%= formData.city || '' %>"></div><div class="col-md-3 mb-3"><label class="form-label"><%= t('localization.state') %></label><input class="form-control" name="state" value="<%= formData.state || '' %>"></div><div class="col-md-3 mb-3"><label class="form-label"><%= t('store.postalCode') %></label><input class="form-control" name="postalCode" value="<%= formData.postalCode || '' %>"></div><div class="col-md-3 mb-3"><label class="form-label"><%= t('form.labels.country') %></label><input class="form-control" name="country" value="<%= formData.country || '' %>"></div><div class="col-md-3 form-check ms-2"><input class="form-check-input" type="checkbox" name="isHeadquarters" id="isHeadquarters"><label class="form-check-label" for="isHeadquarters"><%= t('store.isHeadquarters') %></label></div></div><button class="btn btn-primary" type="submit"><%= t('store.create') %></button></form></div></div></div></section>
