<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col"><h2 class="page-title"><%= pageName %></h2></div>
    <div class="col-auto ms-auto"><a href="/admin/stores/create" class="btn btn-primary"><%= t('store.create') %></a></div>
  </div>
</div>
<section class="content">
  <div class="container-fluid">
    <%- include('../partials/alerts') %>
    <div class="card mb-3">
      <div class="card-body">
        <form method="GET" class="row g-3">
          <div class="col-md-3">
            <label class="form-label"><%= t('common.status') %></label>
            <select class="form-select" name="status">
              <option value=""><%= t('common.all') %></option>
              <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>><%= t('common.active') %></option>
              <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>><%= t('common.inactive') %></option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label"><%= t('common.type') %></label>
            <select class="form-select" name="type">
              <option value=""><%= t('common.all') %></option>
              <option value="hq" <%= filters.type === 'hq' ? 'selected' : '' %>>HQ</option>
              <option value="outlet" <%= filters.type === 'outlet' ? 'selected' : '' %>><%= t('store.outlet') %></option>
            </select>
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary me-2" type="submit"><%= t('common.filter') %></button>
            <a href="/admin/stores" class="btn btn-outline-secondary"><%= t('common.clear') %></a>
          </div>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th><%= t('common.name') %></th>
              <th><%= t('common.type') %></th>
              <th><%= t('common.status') %></th>
              <th><%= t('shared:common.products') %></th>
              <th><%= t('common.dateCreated') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% (stores || []).forEach(function(store) { %>
              <tr>
                <td><strong><%= store.name %></strong><br><small class="text-muted"><%= store.slug %></small></td>
                <td><span class="badge bg-<%= store.isHeadquarters ? 'primary' : 'secondary' %>"><%= store.isHeadquarters ? 'HQ' : t('store.outlet') %></span></td>
                <td><span class="badge bg-<%= store.isActive ? 'success' : 'secondary' %>"><%= store.isActive ? t('common.active') : t('common.inactive') %></span></td>
                <td><%= store.productCount || 0 %></td>
                <td><%= new Date(store.createdAt).toLocaleDateString() %></td>
                <td>
                  <a class="btn btn-sm btn-outline-primary" href="/admin/stores/<%= store.storeId %>"><%= t('common.view') %></a>
                  <a class="btn btn-sm btn-outline-secondary" href="/admin/stores/<%= store.storeId %>/edit"><%= t('common.edit') %></a>
                </td>
              </tr>
            <% }) %>
            <% if (!stores || stores.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted py-4"><%= t('store.notFound') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
