<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= t('payment:reports') %></h2>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../partials/alerts') %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('payment:reports') %></h3>
        <span class="float-end text-muted"><%= (reports || []).length %> <%= t('common.records') %></span>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th><%= t('payment:reports') %> <%= t('common.id') %></th>
              <th><%= t('shared:common.merchants') %></th>
              <th><%= t('common.type') %></th>
              <th><%= t('shared:common.currency') %></th>
              <th><%= t('common.amount') %></th>
              <th><%= t('shared:common.transactions') %></th>
              <th><%= t('shared:common.period') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% (reports || []).forEach(function(r) { %>
            <tr>
              <td><code><%= r.paymentReportId.substring(0, 8) %>...</code></td>
              <td><code><%= r.merchantId %></code></td>
              <td><span class="badge bg-info"><%= r.type %></span></td>
              <td><%= r.currency %></td>
              <td><strong><%= r.currency %> <%= (r.totalAmount || 0).toFixed(2) %></strong></td>
              <td><%= r.transactionCount || 0 %></td>
              <td>
                <%= new Date(r.periodStart).toLocaleDateString() %> &ndash;
                <%= new Date(r.periodEnd).toLocaleDateString() %>
              </td>
              <td>
                <a href="/admin/payments/reports/<%= r.paymentReportId %>" class="btn btn-sm btn-outline-info"><%= t('common.view') %></a>
              </td>
            </tr>
            <% }); %>
            <% if ((reports || []).length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4"><%= t('payment:noReports') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
