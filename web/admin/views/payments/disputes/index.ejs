<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= t('payment:disputes') %></h2>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../partials/alerts') %>

    <!-- Filters -->
    <div class="card mb-3">
      <div class="card-body">
        <form method="GET" class="row g-3">
          <div class="col-md-3">
            <select class="form-select" name="status">
              <option value=""><%= t('common.allStatus') %></option>
              <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>><%= t('shared:common.open') %></option>
              <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>><%= t('payment:disputeStatus') %></option>
              <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>><%= t('shared:common.resolved') %></option>
              <option value="lost" <%= filters.status === 'lost' ? 'selected' : '' %>><%= t('payment:lost') %></option>
              <option value="won" <%= filters.status === 'won' ? 'selected' : '' %>><%= t('payment:won') %></option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100"><%= t('common.filter') %></button>
          </div>
        </form>
      </div>
    </div>

    <!-- Disputes Table -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('payment:disputes') %></h3>
        <span class="float-end text-muted"><%= (disputes || []).length %> <%= t('common.records') %></span>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th><%= t('payment:disputeId') %></th>
              <th><%= t('shared:common.transactionId') %></th>
              <th><%= t('shared:common.merchants') %></th>
              <th><%= t('common.amount') %></th>
              <th><%= t('shared:common.reason') %></th>
              <th><%= t('common.status') %></th>
              <th><%= t('common.dueDate') %></th>
              <th><%= t('common.dateCreated') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% (disputes || []).forEach(function(d) { %>
            <tr>
              <td><code><%= d.paymentDisputeId.substring(0, 8) %>...</code></td>
              <td><code><%= d.paymentId.substring(0, 8) %>...</code></td>
              <td><%= d.merchantId %></td>
              <td><strong><%= d.currency %> <%= (d.amount || 0).toFixed(2) %></strong></td>
              <td><%= d.reason || '-' %></td>
              <td>
                <span class="badge bg-<%= d.status === 'resolved' || d.status === 'won' ? 'success' : d.status === 'lost' ? 'danger' : d.status === 'open' ? 'warning' : 'info' %>">
                  <%= d.status %>
                </span>
              </td>
              <td><%= d.dueBy ? new Date(d.dueBy).toLocaleDateString() : '-' %></td>
              <td><%= new Date(d.createdAt).toLocaleDateString() %></td>
              <td>
                <a href="/admin/payments/disputes/<%= d.paymentDisputeId %>" class="btn btn-sm btn-outline-info"><%= t('common.view') %></a>
              </td>
            </tr>
            <% }); %>
            <% if ((disputes || []).length === 0) { %>
            <tr><td colspan="9" class="text-center text-muted py-4"><%= t('payment:noDisputes') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
