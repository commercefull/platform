<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('payment:gateways') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/payments"><%= t('shared:common.payments') %></a></li>
            <li class="breadcrumb-item active"><%= t('payment:gateways') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Success/Error Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-check"></i> <%= success %>
        </div>
      <% } %>

      <!-- Action Bar -->
      <div class="row mb-3">
        <div class="col-12">
          <a href="/admin/payments/gateways/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> <%= t('payment:createGateway') %>
          </a>
          <div class="float-right">
            <span class="badge badge-info"><%= t('common.total') %>: <%= gateways.length %></span>
          </div>
        </div>
      </div>

      <!-- Gateways Table -->
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('payment:gateways') %></h3>
        </div>
        <div class="card-body table-responsive p-0">
          <table class="table table-hover text-nowrap">
            <thead>
              <tr>
                <th><%= t('common.name') %></th>
                <th><%= t('payment:provider') %></th>
                <th><%= t('common.status') %></th>
                <th><%= t('payment:testMode') %></th>
                <th><%= t('shared:common.default') %></th>
                <th><%= t('shared:common.paymentMethods') %></th>
                <th><%= t('shared:common.currency') %></th>
                <th><%= t('common.actions') %></th>
              </tr>
            </thead>
            <tbody>
              <% if (gateways.length === 0) { %>
                <tr>
                  <td colspan="8" class="text-center py-4">
                    <em><%= t('payment:noGateways') %> <a href="/admin/payments/gateways/create"><%= t('payment:createGateway') %></a>.</em>
                  </td>
                </tr>
              <% } else { %>
                <% gateways.forEach(gateway => { %>
                  <tr>
                    <td>
                      <strong><%= gateway.name %></strong>
                      <% if (gateway.description) { %>
                        <br><small class="text-muted"><%= gateway.description %></small>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge badge-secondary"><%= gateway.provider %></span>
                    </td>
                    <td>
                      <span class="badge badge-<%= gateway.isActive ? 'success' : 'danger' %>">
                        <%= gateway.isActive ? t('common.active') : t('common.inactive') %>
                      </span>
                    </td>
                    <td>
                      <% if (gateway.isTestMode) { %>
                        <span class="badge badge-warning"><%= t('payment:testMode') %></span>
                      <% } else { %>
                        <span class="badge badge-success"><%= t('payment:liveMode') %></span>
                      <% } %>
                    </td>
                    <td>
                      <% if (gateway.isDefault) { %>
                        <i class="fas fa-star text-warning"></i> <%= t('shared:common.default') %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (gateway.supportedPaymentMethods) { %>
                        <%= gateway.supportedPaymentMethods.length %> methods
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (gateway.supportedCurrencies) { %>
                        <%= gateway.supportedCurrencies.join(', ') %>
                      <% } else { %>
                        <span class="text-muted">-</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="/admin/payments/gateways/<%= gateway.paymentGatewayId %>" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/payments/gateways/<%= gateway.paymentGatewayId %>/edit" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i>
                      </a>
                      <button class="btn btn-sm btn-danger" onclick="deleteGateway('<%= gateway.paymentGatewayId %>', '<%= gateway.name %>')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('common.delete') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('common.deleteGatewayConfirm') %> "<strong id="deleteGatewayName"></strong>"?</p>
        <p class="text-danger"><small><%= t('common.deleteGatewayWarning') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('common.delete') %></button>
      </div>
    </div>
  </div>
</div>

<script>
function deleteGateway(gatewayId, gatewayName) {
  document.getElementById('deleteGatewayName').textContent = gatewayName;
  document.getElementById('confirmDeleteBtn').onclick = function() {
    fetch(`/admin/payments/gateways/${gatewayId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('<%= t("common.error") %>: ' + data.message);
      }
    })
    .catch(error => {
      alert('<%= t("payment:errorDeletingGateway") %>');
      console.error('Error:', error);
    });
  };
  $('#deleteModal').modal('show');
}
</script>
<% endcontent %>
