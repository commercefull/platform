<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= t('payment:fees') %></h2>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../partials/alerts') %>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('payment:fees') %></h3>
        <span class="float-end text-muted"><%= (fees || []).length %> <%= t('common.records') %></span>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th><%= t('payment:feeType') %> <%= t('common.id') %></th>
              <th><%= t('shared:common.transactionId') %></th>
              <th><%= t('shared:common.merchants') %></th>
              <th><%= t('common.type') %></th>
              <th><%= t('common.amount') %></th>
              <th><%= t('common.description') %></th>
              <th><%= t('common.dateCreated') %></th>
            </tr>
          </thead>
          <tbody>
            <% (fees || []).forEach(function(f) { %>
            <tr>
              <td><code><%= f.paymentFeeId.substring(0, 8) %>...</code></td>
              <td><code><%= f.transactionId.substring(0, 8) %>...</code></td>
              <td><%= f.merchantId %></td>
              <td><span class="badge bg-secondary"><%= f.type %></span></td>
              <td><strong><%= f.currency %> <%= (f.amount || 0).toFixed(2) %></strong></td>
              <td><%= f.description || '-' %></td>
              <td><%= new Date(f.createdAt).toLocaleDateString() %></td>
            </tr>
            <% }); %>
            <% if ((fees || []).length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-4"><%= t('payment:noFees') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
