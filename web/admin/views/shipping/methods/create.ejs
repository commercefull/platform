<%- include('../../layout') %>

<% content %>
<div class="content-wrapper">
  <!-- Content Header (Page header) -->
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><%= t('distribution:shipping.createMethod') %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a href="/admin"><%= t('common.breadcrumbHome') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/shipping"><%= t('shared:common.shipping') %></a></li>
            <li class="breadcrumb-item"><a href="/admin/shipping/methods"><%= t('shared:common.methods') %></a></li>
            <li class="breadcrumb-item active"><%= t('common.create') %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <div class="container-fluid">
      <!-- Error Messages -->
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible">
          <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
          <i class="icon fas fa-ban"></i> <%= error %>
        </div>
      <% } %>

      <div class="row">
        <div class="col-md-12">
          <div class="card card-primary">
            <div class="card-header">
              <h3 class="card-title"><%= t('distribution:shipping.methodDetails') %></h3>
            </div>

            <form action="/admin/shipping/methods" method="POST">
              <div class="card-body">
                <!-- Basic Information -->
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="name"><%= t('shared:common.methodName') %> *</label>
                      <input type="text" class="form-control" id="name" name="name"
                             value="<%= formData?.name || '' %>" required>
                      <small class="form-text text-muted"><%= t('support:displayNameHint') %></small>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-group">
                      <label for="code"><%= t('distribution:shipping.methodCode') %> *</label>
                      <input type="text" class="form-control" id="code" name="code"
                             value="<%= formData?.code || '' %>" required>
                      <small class="form-text text-muted"><%= t('support:uniqueCodeHint') %></small>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label for="description"><%= t('common.description') %></label>
                  <textarea class="form-control" id="description" name="description" rows="3"><%= formData?.description || '' %></textarea>
                  <small class="form-text text-muted"><%= t('support:shippingDescHint') %></small>
                </div>

                <!-- Configuration -->
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="domesticInternational"><%= t('common.type') %></label>
                      <select class="form-control" id="domesticInternational" name="domesticInternational">
                        <option value="domestic" <%= (formData?.domesticInternational || 'both') === 'domestic' ? 'selected' : '' %>><%= t('distribution:shipping.domestic') %></option>
                        <option value="international" <%= (formData?.domesticInternational || 'both') === 'international' ? 'selected' : '' %>><%= t('distribution:shipping.international') %></option>
                        <option value="both" <%= (formData?.domesticInternational || 'both') === 'both' ? 'selected' : '' %>><%= t('distribution:shipping.both') %></option>
                      </select>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="priority"><%= t('shared:common.priority') %></label>
                      <input type="number" class="form-control" id="priority" name="priority"
                             value="<%= formData?.priority || 0 %>" min="0">
                      <small class="form-text text-muted"><%= t('support:priorityHint') %></small>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="handlingDays"><%= t('distribution:shipping.handlingDays') %></label>
                      <input type="number" class="form-control" id="handlingDays" name="handlingDays"
                             value="<%= formData?.handlingDays || 1 %>" min="0">
                      <small class="form-text text-muted"><%= t('support:handlingDaysHint') %></small>
                    </div>
                  </div>
                </div>

                <!-- Status and Display -->
                <div class="row">
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="isActive"><%= t('common.status') %></label>
                      <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="isActive" name="isActive" value="true"
                               <%= (formData?.isActive !== false) ? 'checked' : '' %>>
                        <label class="custom-control-label" for="isActive"><%= t('common.active') %></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="isDefault"><%= t('distribution:shipping.defaultMethod') %></label>
                      <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="isDefault" name="isDefault" value="true"
                               <%= (formData?.isDefault === true) ? 'checked' : '' %>>
                        <label class="custom-control-label" for="isDefault"><%= t('shared:common.setAsDefault') %></label>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-group">
                      <label for="displayOnFrontend"><%= t('distribution:shipping.displayOnFrontend') %></label>
                      <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="displayOnFrontend" name="displayOnFrontend" value="true"
                               <%= (formData?.displayOnFrontend !== false) ? 'checked' : '' %>>
                        <label class="custom-control-label" for="displayOnFrontend"><%= t('distribution:shipping.showToCustomers') %></label>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Order Value and Weight Restrictions -->
                <h5 class="mt-4 mb-3"><%= t('distribution:shipping.restrictions') %></h5>
                <div class="row">
                  <div class="col-md-3">
                    <div class="form-group">
                      <label for="minOrderValue"><%= t('distribution:shipping.minOrderValue') %></label>
                      <input type="number" class="form-control" id="minOrderValue" name="minOrderValue"
                             value="<%= formData?.minOrderValue || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label for="maxOrderValue"><%= t('distribution:shipping.maxOrderValue') %></label>
                      <input type="number" class="form-control" id="maxOrderValue" name="maxOrderValue"
                             value="<%= formData?.maxOrderValue || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label for="minWeight"><%= t('distribution:shipping.minWeight') %> (kg)</label>
                      <input type="number" class="form-control" id="minWeight" name="minWeight"
                             value="<%= formData?.minWeight || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-group">
                      <label for="maxWeight"><%= t('distribution:shipping.maxWeight') %> (kg)</label>
                      <input type="number" class="form-control" id="maxWeight" name="maxWeight"
                             value="<%= formData?.maxWeight || '' %>" step="0.01" min="0">
                    </div>
                  </div>
                </div>

                <div class="alert alert-info">
                  <i class="icon fas fa-info"></i>
                  <strong><%= t('common.note') %>:</strong> <%= t('common.deliveryTimeNote') %>
                </div>
              </div>

              <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save"></i> <%= t('distribution:shipping.createMethod') %>
                </button>
                <a href="/admin/shipping/methods" class="btn btn-secondary">
                  <i class="fas fa-times"></i> <%= t('common.cancel') %>
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<% endcontent %>
