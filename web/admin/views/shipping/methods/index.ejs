<div class="content-wrapper">
  <!-- Page Header -->
  <div class="page-header d-print-none pb-3">
    <div class="row g-2 align-items-center">
      <div class="col">
        <h2 class="page-title">
          <%= t('shared:common.methods') %>
        </h2>
      </div>
      <div class="col-auto">
        <a href="/admin/shipping/methods/create" class="btn btn-primary">
          <i class="fas fa-plus"></i> <%= t('distribution:shipping.addMethod') %>
        </a>
      </div>
    </div>
  </div>

  <!-- Main content -->
  <section class="content">
    <% if (success) { %>
    <div class="alert alert-success alert-dismissible">
      <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
      <i class="icon fas fa-check"></i> <%= success %>
    </div>
    <% } %>

    <!-- Methods Table -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('shared:common.methods') %></h3>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
          <thead>
            <tr>
              <th><%= t('common.name') %></th>
              <th><%= t('common.code') %></th>
              <th><%= t('common.type') %></th>
              <th><%= t('common.status') %></th>
              <th><%= t('common.default') %></th>
              <th><%= t('distribution:shipping.display') %></th>
              <th><%= t('shared:common.priority') %></th>
              <th><%= t('distribution:shipping.delivery') %></th>
              <th><%= t('common.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (methods.length === 0) { %>
            <tr>
              <td colspan="9" class="text-center py-4">
                <em><%= t('distribution:shipping.noMethods') %> <a href="/admin/shipping/methods/create"><%= t('distribution:shipping.addFirstMethod') %></a>.</em>
              </td>
            </tr>
            <% } else { %>
            <% methods.forEach(method => { %>
            <tr>
              <td>
                <strong><%= method.name %></strong>
                <% if (method.description) { %>
                <br><small class="text-muted"><%= method.description %></small>
                <% } %>
              </td>
              <td>
                <code><%= method.code %></code>
              </td>
              <td>
                <span class="badge badge-secondary"><%= method.domesticInternational %></span>
              </td>
              <td>
                <span class="badge badge-<%= method.isActive ? 'success' : 'danger' %>">
                  <%= method.isActive ? t('common.active') : t('common.inactive') %>
                </span>
              </td>
              <td>
                <% if (method.isDefault) { %>
                <i class="fas fa-star text-warning"></i> <%= t('common.default') %>
                <% } else { %>
                <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (method.displayOnFrontend) { %>
                <i class="fas fa-eye text-success"></i> Yes
                <% } else { %>
                <i class="fas fa-eye-slash text-muted"></i> No
                <% } %>
              </td>
              <td><%= method.priority %></td>
              <td>
                <% if (method.estimatedDeliveryDays) { %>
                <%= method.estimatedDeliveryDays.min %>-<%= method.estimatedDeliveryDays.max %> days
                <% } else { %>
                <span class="text-muted">-</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/shipping/methods/<%= method.shippingMethodId %>" class="btn btn-sm btn-info">
                  <i class="fas fa-eye"></i>
                </a>
                <a href="/admin/shipping/methods/<%= method.shippingMethodId %>/edit" class="btn btn-sm btn-primary">
                  <i class="fas fa-edit"></i>
                </a>
                <% if (method.isActive) { %>
                <button class="btn btn-sm btn-warning" onclick="deactivateMethod('<%= method.shippingMethodId %>', '<%= method.name %>')">
                  <i class="fas fa-pause"></i>
                </button>
                <% } else { %>
                <button class="btn btn-sm btn-success" onclick="activateMethod('<%= method.shippingMethodId %>', '<%= method.name %>')">
                  <i class="fas fa-play"></i>
                </button>
                <% } %>
                <button class="btn btn-sm btn-danger" onclick="deleteMethod('<%= method.shippingMethodId %>', '<%= method.name %>')">
                  <i class="fas fa-trash"></i>
                </button>
              </td>
            </tr>
            <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= t('distribution:shipping.deleteMethod') %></h4>
        <button type="button" class="close" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p><%= t('common.deleteMethodConfirm') %> "<strong id="deleteMethodName"></strong>"?</p>
        <p class="text-danger"><small><%= t('common.deleteMethodWarning') %></small></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn"><%= t('distribution:shipping.deleteMethod') %></button>
      </div>
    </div>
  </div>
</div>

<script>
  function deleteMethod(methodId, methodName) {
    document.getElementById('deleteMethodName').textContent = methodName;
    document.getElementById('confirmDeleteBtn').onclick = function() {
      fetch(`/admin/shipping/methods/${methodId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            location.reload();
          } else {
            alert('<%= t("common.error") %>: ' + data.message);
          }
        })
        .catch(error => {
          alert('<%= t("distribution:shipping.errorDeletingMethod") %>');
          console.error('Error:', error);
        });
    };
    $('#deleteModal').modal('show');
  }

  function activateMethod(methodId, methodName) {
    fetch(`/admin/shipping/methods/${methodId}/activate`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert('<%= t("common.error") %>: ' + data.message);
        }
      })
      .catch(error => {
        alert('<%= t("distribution:shipping.errorActivatingMethod") %>');
        console.error('Error:', error);
      });
  }

  function deactivateMethod(methodId, methodName) {
    fetch(`/admin/shipping/methods/${methodId}/deactivate`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert('<%= t("common.error") %>: ' + data.message);
        }
      })
      .catch(error => {
        alert('<%= t("distribution:shipping.errorDeactivatingMethod") %>');
        console.error('Error:', error);
      });
  }
</script>