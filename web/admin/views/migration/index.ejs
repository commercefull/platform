<%- include('../partials/header', { pageName, title: pageName }) %>
<%- include('../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <a href="/admin/migration/create" class="btn btn-primary btn-sm">Create Import Job</a>
</div>

<form method="GET" action="/admin/migration" class="row g-2 mb-3">
  <div class="col-md-3">
    <select name="status" class="form-select form-select-sm">
      <option value="">All Statuses</option>
      <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="running" <%= filters.status === 'running' ? 'selected' : '' %>>Running</option>
      <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
      <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
      <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
      <option value="paused" <%= filters.status === 'paused' ? 'selected' : '' %>>Paused</option>
    </select>
  </div>
  <div class="col-md-3">
    <select name="jobType" class="form-select form-select-sm">
      <option value="">All Types</option>
      <option value="full" <%= filters.jobType === 'full' ? 'selected' : '' %>>Full</option>
      <option value="products" <%= filters.jobType === 'products' ? 'selected' : '' %>>Products</option>
      <option value="customers" <%= filters.jobType === 'customers' ? 'selected' : '' %>>Customers</option>
      <option value="orders" <%= filters.jobType === 'orders' ? 'selected' : '' %>>Orders</option>
      <option value="categories" <%= filters.jobType === 'categories' ? 'selected' : '' %>>Categories</option>
      <option value="inventory" <%= filters.jobType === 'inventory' ? 'selected' : '' %>>Inventory</option>
    </select>
  </div>
  <div class="col-md-2"><button type="submit" class="btn btn-primary btn-sm">Filter</button><a href="/admin/migration" class="btn btn-secondary btn-sm">Clear</a></div>
</form>

<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-striped table-sm">
      <thead><tr><th>Job Type</th><th>Source</th><th>Status</th><th>Progress</th><th>Dry Run</th><th>Created</th><th>Actions</th></tr></thead>
      <tbody>
        <% jobs.forEach(function(j) { %>
        <tr>
          <td><a href="/admin/migration/<%= j.importJobId %>"><%= j.jobType %></a></td>
          <td><%= j.source %></td>
          <td>
            <% if (j.status === 'completed') { %><span class="badge bg-success"><%= j.status %></span>
            <% } else if (j.status === 'running') { %><span class="badge bg-primary"><%= j.status %></span>
            <% } else if (j.status === 'failed') { %><span class="badge bg-danger"><%= j.status %></span>
            <% } else if (j.status === 'paused' || j.status === 'cancelled') { %><span class="badge bg-warning"><%= j.status %></span>
            <% } else { %><span class="badge bg-secondary"><%= j.status %></span><% } %>
          </td>
          <td>
            <% const pct = j.stats && j.stats.totalRecords > 0 ? Math.round((j.stats.processedRecords / j.stats.totalRecords) * 100) : 0; %>
            <div class="progress" style="height: 18px;">
              <div class="progress-bar" role="progressbar" style="width: <%= pct %>%;"><%= pct %>%</div>
            </div>
            <small><%= j.stats ? j.stats.processedRecords : 0 %> / <%= j.stats ? j.stats.totalRecords : 0 %></small>
          </td>
          <td><%= j.dryRun ? '<span class="badge bg-warning">Yes</span>' : 'No' %></td>
          <td><%= new Date(j.createdAt).toLocaleString() %></td>
          <td>
            <a href="/admin/migration/<%= j.importJobId %>" class="btn btn-info btn-sm">View</a>
            <% if (j.status === 'pending') { %>
            <form method="POST" action="/admin/migration/<%= j.importJobId %>/start" class="d-inline"><button type="submit" class="btn btn-success btn-sm">Start</button></form>
            <% } %>
            <% if (j.status === 'running') { %>
            <form method="POST" action="/admin/migration/<%= j.importJobId %>/pause" class="d-inline"><button type="submit" class="btn btn-warning btn-sm">Pause</button></form>
            <% } %>
            <% if (j.status === 'paused') { %>
            <form method="POST" action="/admin/migration/<%= j.importJobId %>/start" class="d-inline"><button type="submit" class="btn btn-success btn-sm">Resume</button></form>
            <% } %>
          </td>
        </tr>
        <% }); %>
        <% if (!jobs || jobs.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted">No import jobs found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
