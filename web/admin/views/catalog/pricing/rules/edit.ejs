<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col-auto">
        <a href="/admin/catalog/pricing/rules" class="btn btn-outline-secondary btn-sm mb-2"><%= t('product:pricing.back') %></a>
        <h2 class="page-title"><%= pageName %></h2>
      </div>
    </div>
  </div>

  <div class="card">
    <form method="POST" action="/admin/catalog/pricing/rules/<%= priceRule?.priceRuleId || priceRule?.id || '' %>">
      <div class="card-body">
        <% if (!priceRule) { %>
          <p class="text-muted">Price rule not found.</p>
        <% } else { %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Rule Name</label>
              <input type="text" class="form-control" name="name" value="<%= priceRule.name || '' %>" required>
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Rule Type</label>
              <select class="form-select" name="ruleType">
                <option value="fixed" <%= priceRule.ruleType === 'fixed' ? 'selected' : '' %>>Fixed Price</option>
                <option value="percentage" <%= priceRule.ruleType === 'percentage' ? 'selected' : '' %>>Percentage Off</option>
                <option value="tiered" <%= priceRule.ruleType === 'tiered' ? 'selected' : '' %>>Tiered Discount</option>
                <option value="volume" <%= priceRule.ruleType === 'volume' ? 'selected' : '' %>>Volume Discount</option>
                <option value="time_based" <%= priceRule.ruleType === 'time_based' ? 'selected' : '' %>>Time-Based</option>
              </select>
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="active" <%= !priceRule.status || priceRule.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= priceRule.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 mb-3">
              <label class="form-label">Value</label>
              <input type="number" class="form-control" name="value" value="<%= priceRule.value || '' %>" step="0.01">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Priority</label>
              <input type="number" class="form-control" name="priority" value="<%= priceRule.priority || 0 %>" min="0">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="description" rows="2"><%= priceRule.description || '' %></textarea>
          </div>

          <h5 class="mt-4 mb-3">Pricing Conditions</h5>
          <%- include('../../../partials/condition-builder', {
            fieldName: 'conditions',
            conditions: priceRule.conditions || [],
            attributes: [
              { value: 'cartTotal', label: 'Cart Total' },
              { value: 'itemQuantity', label: 'Item Quantity' },
              { value: 'productCategory', label: 'Product Category' },
              { value: 'customerGroup', label: 'Customer Group' },
              { value: 'customerTier', label: 'Customer Tier' },
              { value: 'channel', label: 'Sales Channel' }
            ]
          }) %>
        <% } %>
      </div>
      <div class="card-footer">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save me-1"></i>Save Changes
        </button>
        <a href="/admin/catalog/pricing/rules" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
