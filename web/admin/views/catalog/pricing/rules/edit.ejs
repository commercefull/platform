<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col-auto">
        <a href="/admin/catalog/pricing/rules" class="btn btn-outline-secondary btn-sm mb-2"><%= t('product:pricing.back') %></a>
        <h2 class="page-title"><%= pageName %></h2>
      </div>
    </div>
  </div>

  <div class="card">
    <form method="POST" action="/admin/catalog/pricing/rules/<%= priceRule?.priceRuleId || priceRule?.id || '' %>">
      <div class="card-body">
        <% if (!priceRule) { %>
          <p class="text-muted">Price rule not found.</p>
        <% } else { %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Rule Name</label>
              <input type="text" class="form-control" name="name" value="<%= priceRule.name || '' %>" required>
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Rule Type</label>
              <select class="form-select" name="ruleType">
                <option value="fixed" <%= priceRule.ruleType === 'fixed' ? 'selected' : '' %>>Fixed Price</option>
                <option value="percentage" <%= priceRule.ruleType === 'percentage' ? 'selected' : '' %>>Percentage Off</option>
                <option value="tiered" <%= priceRule.ruleType === 'tiered' ? 'selected' : '' %>>Tiered Discount</option>
                <option value="volume" <%= priceRule.ruleType === 'volume' ? 'selected' : '' %>>Volume Discount</option>
                <option value="time_based" <%= priceRule.ruleType === 'time_based' ? 'selected' : '' %>>Time-Based</option>
              </select>
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Status</label>
              <select class="form-select" name="status">
                <option value="active" <%= !priceRule.status || priceRule.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= priceRule.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 mb-3">
              <label class="form-label">Value</label>
              <input type="number" class="form-control" name="value" value="<%= priceRule.value || '' %>" step="0.01">
            </div>
            <div class="col-md-3 mb-3">
              <label class="form-label">Priority</label>
              <input type="number" class="form-control" name="priority" value="<%= priceRule.priority || 0 %>" min="0">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="description" rows="2"><%= priceRule.description || '' %></textarea>
          </div>

          <%
            const targetingConds = (priceRule.conditions || []);
            const storeCond = targetingConds.find(function(c) { return c.type === 'store'; });
            const channelCond = targetingConds.find(function(c) { return c.type === 'channel'; });
            const selectedStoreIds = (storeCond && storeCond.parameters && storeCond.parameters.storeIds) || [];
            const selectedChannelIds = (channelCond && channelCond.parameters && channelCond.parameters.channelIds) || [];
            const builderAttrMap = { cart_total: 'cartTotal', item_quantity: 'itemQuantity', category: 'productCategory', customer_group: 'customerGroup' };
            const builderConditions = targetingConds
              .filter(function(c) { return c.type !== 'store' && c.type !== 'channel'; })
              .map(function(c) {
                return {
                  attribute: builderAttrMap[c.type] || c.type,
                  operator: (c.parameters && c.parameters.operator) || 'eq',
                  value: Array.isArray(c.parameters && c.parameters.value) ? c.parameters.value.join(',') : (c.parameters && c.parameters.value),
                };
              });
          %>

          <h5 class="mt-4 mb-3">Store &amp; Channel Targeting</h5>
          <p class="text-muted small">Restrict this rule to specific stores and/or sales channels. Leave empty to apply everywhere.</p>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Stores</label>
              <select class="form-select" name="storeIds" multiple size="4">
                <% (stores || []).forEach(function(store) { %>
                  <option value="<%= store.storeId %>" <%= selectedStoreIds.includes(store.storeId) ? 'selected' : '' %>><%= store.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Sales Channels</label>
              <select class="form-select" name="channelIds" multiple size="4">
                <% (salesChannels || []).forEach(function(channel) { %>
                  <option value="<%= channel.salesChannelId %>" <%= selectedChannelIds.includes(channel.salesChannelId) ? 'selected' : '' %>><%= channel.name %> (<%= channel.code %>)</option>
                <% }); %>
              </select>
            </div>
          </div>

          <h5 class="mt-4 mb-3">Pricing Conditions</h5>
          <%- include('../../../partials/condition-builder', {
            fieldName: 'conditions',
            conditions: builderConditions,
            attributes: [
              { value: 'cartTotal', label: 'Cart Total' },
              { value: 'itemQuantity', label: 'Item Quantity' },
              { value: 'productCategory', label: 'Product Category' },
              { value: 'customerGroup', label: 'Customer Group' }
            ]
          }) %>
        <% } %>
      </div>
      <div class="card-footer">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save me-1"></i>Save Changes
        </button>
        <a href="/admin/catalog/pricing/rules" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
