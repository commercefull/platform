<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col">
        <h2 class="page-title"><%= pageName %></h2>
      </div>
      <div class="col-auto">
        <a href="/admin/catalog/pricing/rules/create" class="btn btn-primary">
          <i class="fas fa-plus me-1"></i>Create Price Rule
        </a>
      </div>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success">
    <i class="fas fa-check-circle me-2"></i><%= success %>
  </div>
  <% } %>

  <div class="card">
    <div class="card-body p-0">
      <table class="table table-striped table-hover mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Target</th>
            <th>Value</th>
            <th>Priority</th>
            <th>Status</th>
            <th width="80">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!priceRules || priceRules.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-4">
              No price rules configured.
              <a href="/admin/catalog/pricing/rules/create">Create one now.</a>
            </td>
          </tr>
          <% } else { %>
            <% priceRules.forEach(function(rule) { %>
            <tr>
              <td><%= rule.name || '—' %></td>
              <td><span class="badge bg-info"><%= rule.ruleType || '—' %></span></td>
              <td><%= rule.target || 'all' %></td>
              <td><%= rule.value || '—' %></td>
              <td><%= rule.priority || 0 %></td>
              <td>
                <% if (rule.status === 'active') { %>
                  <span class="badge bg-success">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactive</span>
                <% } %>
              </td>
              <td>
                <a href="/admin/catalog/pricing/rules/<%= rule.priceRuleId || rule.id %>" class="btn btn-outline-secondary btn-sm">
                  <i class="fas fa-eye"></i>
                </a>
              </td>
            </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
