<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col-auto">
        <a href="/admin/catalog/pricing/rules" class="btn btn-outline-secondary btn-sm mb-2"><%= t('product:pricing.back') %></a>
        <h2 class="page-title"><%= pageName %></h2>
      </div>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success">
    <i class="fas fa-check-circle me-2"></i><%= success %>
  </div>
  <% } %>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Price Rule Details</h3>
    </div>
    <div class="card-body">
      <% if (!priceRule) { %>
        <p class="text-muted">Price rule not found.</p>
      <% } else { %>
        <dl class="row">
          <dt class="col-sm-3">Name</dt>
          <dd class="col-sm-9"><%= priceRule.name || '—' %></dd>
          <dt class="col-sm-3">Type</dt>
          <dd class="col-sm-9"><span class="badge bg-info"><%= priceRule.ruleType || '—' %></span></dd>
          <dt class="col-sm-3">Target</dt>
          <dd class="col-sm-9"><%= priceRule.target || 'all' %></dd>
          <dt class="col-sm-3">Value</dt>
          <dd class="col-sm-9"><%= priceRule.value || '—' %></dd>
          <dt class="col-sm-3">Priority</dt>
          <dd class="col-sm-9"><%= priceRule.priority || 0 %></dd>
          <dt class="col-sm-3">Status</dt>
          <dd class="col-sm-9">
            <% if (priceRule.status === 'active') { %>
              <span class="badge bg-success">Active</span>
            <% } else { %>
              <span class="badge bg-secondary">Inactive</span>
            <% } %>
          </dd>
          <% if (priceRule.description) { %>
          <dt class="col-sm-3">Description</dt>
          <dd class="col-sm-9"><%= priceRule.description %></dd>
          <% } %>
        </dl>
      <% } %>
    </div>
    <div class="card-footer">
      <a href="/admin/catalog/pricing/rules" class="btn btn-secondary">Back to Rules</a>
    </div>
  </div>
</div>
