<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col-auto">
        <h2 class="page-title"><%= pageName %></h2>
      </div>
    </div>
  </div>
  <% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
  <% } %>
  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('shared:common.priceLists') %></h3>
          <div class="card-actions">
            <a href="/admin/catalog/pricing/lists/create" class="btn btn-primary btn-sm"><%= t('common.create') %></a>
          </div>
        </div>
        <div class="card-body">
          <p class="text-muted"><%= t('product:pricing.managePriceLists') %></p>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h3 class="card-title"><%= t('product:pricing.priceRules') %></h3>
          <div class="card-actions">
            <a href="/admin/catalog/pricing/rules/create" class="btn btn-primary btn-sm"><%= t('common.create') %></a>
          </div>
        </div>
        <div class="card-body">
          <p class="text-muted"><%= t('product:pricing.configureRules') %></p>
        </div>
      </div>
    </div>
  </div>
</div>
