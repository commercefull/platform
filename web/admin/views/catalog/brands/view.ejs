<%- include('../../partials/header', { title: pageName }) %>

<div class="content-wrapper">
  <div class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1 class="m-0"><i class="fas fa-tag me-2"></i><%= pageName %></h1>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a href="/admin">Home</a></li>
            <li class="breadcrumb-item"><a href="/admin/catalog/brands">Brands</a></li>
            <li class="breadcrumb-item active"><%= brand.name %></li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <section class="content">
    <div class="container-fluid">
      <% if (successMsg) { %>
      <div class="alert alert-success alert-dismissible">
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        <i class="fas fa-check-circle me-2"></i><%= successMsg %>
      </div>
      <% } %>

      <div class="row">
        <div class="col-md-4">
          <div class="card">
            <div class="card-body text-center">
              <% if (brand.logoUrl) { %>
              <img src="<%= brand.logoUrl %>" alt="<%= brand.name %>" class="img-fluid rounded mb-3" style="max-height: 200px; object-fit: contain;">
              <% } else { %>
              <div class="bg-light rounded d-flex align-items-center justify-content-center mb-3" style="height: 200px;">
                <span class="display-4 text-muted fw-bold"><%= brand.name.charAt(0) %></span>
              </div>
              <% } %>
              <h3 class="card-title"><%= brand.name %></h3>
              <p class="text-muted"><code><%= brand.slug %></code></p>
              <div class="mb-2">
                <% if (brand.status === 'active') { %>
                <span class="badge bg-success">Active</span>
                <% } else if (brand.status === 'inactive') { %>
                <span class="badge bg-warning">Inactive</span>
                <% } else { %>
                <span class="badge bg-secondary">Archived</span>
                <% } %>
              </div>
            </div>
            <div class="card-footer">
              <a href="/admin/catalog/brands/<%= brand.brandId %>/edit" class="btn btn-primary btn-sm"><i class="fas fa-edit me-1"></i>Edit</a>
              <a href="/admin/catalog/brands" class="btn btn-secondary btn-sm ms-2">Back to Brands</a>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Brand Information</h3>
            </div>
            <div class="card-body">
              <table class="table table-borderless">
                <tr>
                  <th style="width: 200px">Brand ID</th>
                  <td><code><%= brand.brandId %></code></td>
                </tr>
                <tr>
                  <th>Description</th>
                  <td><%= brand.description || '—' %></td>
                </tr>
                <tr>
                  <th>Website</th>
                  <td>
                    <% if (brand.website) { %>
                    <a href="<%= brand.website %>" target="_blank" rel="noopener"><%= brand.website %></a>
                    <% } else { %>—<% } %>
                  </td>
                </tr>
                <tr>
                  <th>Country of Origin</th>
                  <td><%= brand.countryOfOrigin || '—' %></td>
                </tr>
                <tr>
                  <th>External ID</th>
                  <td><%= brand.externalId || '—' %></td>
                </tr>
                <tr>
                  <th>Created</th>
                  <td><%= new Date(brand.createdAt).toLocaleString() %></td>
                </tr>
                <tr>
                  <th>Last Updated</th>
                  <td><%= new Date(brand.updatedAt).toLocaleString() %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../../partials/footer') %>
