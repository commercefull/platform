<div class="container-xl">
  <div class="page-header d-print-none">
    <div class="row align-items-center">
      <div class="col-auto">
        <a href="/admin/catalog/collections" class="btn btn-outline-secondary btn-sm mb-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="15 6 9 12 15 18" /></svg>
          <%= t('product:collection.back') %>
        </a>
        <h2 class="page-title"><%= pageName %></h2>
      </div>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible" role="alert">
    <div class="d-flex">
      <div><%= error %></div>
    </div>
    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
  </div>
  <% } %>

  <form action="/admin/catalog/collections" method="POST">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('product:collection.details') %></h3>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label required"><%= t('common.name') %></label>
              <input type="text" class="form-control" name="name" required value="<%= typeof formData !== 'undefined' ? formData.name || '' : '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label"><%= t('shared:common.slug') %></label>
              <input type="text" class="form-control" name="slug" value="<%= typeof formData !== 'undefined' ? formData.slug || '' : '' %>">
              <small class="form-hint"><%= t('common.autoGenerated') %></small>
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= t('shared:common.description') %></label>
          <textarea class="form-control" name="description" rows="3"><%= typeof formData !== 'undefined' ? formData.description || '' : '' %></textarea>
        </div>
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label"><%= t('shared:common.image') %> URL</label>
              <input type="text" class="form-control" name="imageUrl" value="<%= typeof formData !== 'undefined' ? formData.imageUrl || '' : '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label"><%= t('product:collection.banner') %></label>
              <input type="text" class="form-control" name="bannerUrl" value="<%= typeof formData !== 'undefined' ? formData.bannerUrl || '' : '' %>">
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-4">
            <div class="mb-3">
              <label class="form-label"><%= t('product:collection.sortOrder') %></label>
              <select class="form-select" name="sortOrder">
                <option value="manual"><%= t('product:collection.manual') %></option>
                <option value="newest"><%= t('product:collection.sortNewest') %></option>
                <option value="price_asc"><%= t('product:collection.sortPriceAsc') %></option>
                <option value="price_desc"><%= t('product:collection.sortPriceDesc') %></option>
                <option value="name_asc"><%= t('product:collection.sortNameAsc') %></option>
              </select>
            </div>
          </div>
          <div class="col-md-4">
            <div class="mb-3">
              <label class="form-label"><%= t('product:collection.publishAt') %></label>
              <input type="datetime-local" class="form-control" name="publishAt" value="<%= typeof formData !== 'undefined' ? formData.publishAt || '' : '' %>">
            </div>
          </div>
          <div class="col-md-4">
            <div class="mb-3">
              <label class="form-label"><%= t('product:collection.unpublishAt') %></label>
              <input type="datetime-local" class="form-control" name="unpublishAt" value="<%= typeof formData !== 'undefined' ? formData.unpublishAt || '' : '' %>">
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-check form-check-inline">
            <input type="checkbox" class="form-check-input" name="isActive" checked>
            <span class="form-check-label"><%= t('common.active') %></span>
          </label>
          <label class="form-check form-check-inline">
            <input type="checkbox" class="form-check-input" name="isFeatured">
            <span class="form-check-label"><%= t('product:collection.featured') %></span>
          </label>
          <label class="form-check form-check-inline">
            <input type="checkbox" class="form-check-input" name="isAutomated">
            <span class="form-check-label"><%= t('product:collection.automated') %></span>
          </label>
        </div>
        <div class="mb-3">
          <label class="form-label"><%= t('product:collection.conditionsJson') %></label>
          <textarea class="form-control font-monospace" name="conditionsJson" rows="4" placeholder='[{"field":"categoryId","operator":"equals","value":"..."}]'><%= typeof formData !== 'undefined' ? formData.conditionsJson || '' : '' %></textarea>
          <small class="form-hint"><%= t('product:collection.conditionsHint') %></small>
        </div>
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label"><%= t('product:collection.metaTitle') %></label>
              <input type="text" class="form-control" name="metaTitle" value="<%= typeof formData !== 'undefined' ? formData.metaTitle || '' : '' %>">
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label"><%= t('product:collection.metaDescription') %></label>
              <input type="text" class="form-control" name="metaDescription" value="<%= typeof formData !== 'undefined' ? formData.metaDescription || '' : '' %>">
            </div>
          </div>
        </div>
      </div>
      <div class="card-footer text-end">
        <a href="/admin/catalog/collections" class="btn btn-link"><%= t('common.cancel') %></a>
        <button type="submit" class="btn btn-primary"><%= t('product:collection.create') %></button>
      </div>
    </div>
  </form>
</div>
