<%- include('../../partials/header', { pageName, title: pageName }) %>
<%- include('../../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
</div>

<form method="GET" action="/admin/b2b/quotes" class="row g-2 mb-3">
  <div class="col-md-3">
    <input type="text" name="companyId" value="<%= filters.companyId %>" class="form-control form-control-sm" placeholder="Company ID">
  </div>
  <div class="col-md-3">
    <select name="status" class="form-select form-select-sm">
      <option value="">All Statuses</option>
      <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
      <option value="sent" <%= filters.status === 'sent' ? 'selected' : '' %>>Sent</option>
      <option value="viewed" <%= filters.status === 'viewed' ? 'selected' : '' %>>Viewed</option>
      <option value="accepted" <%= filters.status === 'accepted' ? 'selected' : '' %>>Accepted</option>
      <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
      <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired</option>
      <option value="converted" <%= filters.status === 'converted' ? 'selected' : '' %>>Converted</option>
    </select>
  </div>
  <div class="col-md-2">
    <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    <a href="/admin/b2b/quotes" class="btn btn-secondary btn-sm">Clear</a>
  </div>
</form>

<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-striped table-sm">
      <thead>
        <tr><th>Quote #</th><th>Company</th><th>Status</th><th>Total</th><th>Valid Until</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% quotes.forEach(function(q) { %>
        <tr>
          <td><a href="/admin/b2b/quotes/<%= q.quoteId %>"><%= q.quoteNumber %></a></td>
          <td><%= q.companyId %></td>
          <td><span class="badge bg-info"><%= q.status %></span></td>
          <td>$<%= ((q.totalCents || 0) / 100).toFixed(2) %></td>
          <td><%= new Date(q.validUntil).toLocaleDateString() %></td>
          <td><a href="/admin/b2b/quotes/<%= q.quoteId %>" class="btn btn-info btn-sm">View</a></td>
        </tr>
        <% }); %>
        <% if (!quotes || quotes.length === 0) { %>
        <tr><td colspan="6" class="text-center text-muted">No quotes found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
