<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= priceList ? t('b2b:editPriceList') : t('b2b:createPriceList') %></h2>
      <div class="text-muted mt-1">
        <a href="/admin/b2b/price-lists"><%= t('shared:common.priceLists') %></a> &rsaquo;
        <%= priceList ? priceList.name : t('shared:common.new') %>
      </div>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../partials/alerts') %>

    <div class="row">
      <div class="col-md-7">
        <div class="card">
          <div class="card-header">
            <h3 class="card-title"><%= priceList ? t('shared:common.edit') : t('shared:common.new') %> <%= t('shared:common.priceLists') %></h3>
          </div>
          <div class="card-body">
            <form method="POST" action="<%= priceList ? '/admin/b2b/price-lists/' + priceList.b2bPriceListId : '/admin/b2b/price-lists' %>">
              <div class="mb-3">
                <label class="form-label"><%= t('shared:common.name') %> <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="name"
                  value="<%= priceList ? priceList.name : '' %>" required>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('shared:common.currency') %></label>
                <input type="text" class="form-control" name="currency" maxlength="3"
                  value="<%= priceList ? priceList.currency : 'USD' %>">
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('b2b:companyIdOptional') %></label>
                <input type="text" class="form-control" name="b2bCompanyId"
                  value="<%= priceList && priceList.b2bCompanyId ? priceList.b2bCompanyId : '' %>"
                  placeholder="<%= t('b2b:companyIdPlaceholder') %>">
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('shared:common.status') %></label>
                <select class="form-select" name="isActive">
                  <option value="true" <%= !priceList || priceList.isActive ? 'selected' : '' %>><%= t('shared:common.active') %></option>
                  <option value="false" <%= priceList && !priceList.isActive ? 'selected' : '' %>><%= t('shared:common.inactive') %></option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label"><%= t('shared:common.notes') %></label>
                <textarea class="form-control" name="notes" rows="3"><%= priceList && priceList.notes ? priceList.notes : '' %></textarea>
              </div>
              <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><%= priceList ? t('b2b:updatePriceList') : t('b2b:createPriceList') %></button>
                <a href="/admin/b2b/price-lists" class="btn btn-outline-secondary"><%= t('shared:common.cancel') %></a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
