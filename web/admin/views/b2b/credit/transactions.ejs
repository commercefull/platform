<!-- Page Header -->
<div class="page-header d-print-none">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title"><%= t('b2b:creditTransactions') %></h2>
      <div class="text-muted mt-1">
        <a href="/admin/b2b/companies"><%= t('shared:common.companies') %></a> &rsaquo;
        <a href="/admin/b2b/companies/<%= company.b2bCompanyId %>"><%= company.name %></a> &rsaquo;
        <a href="/admin/b2b/companies/<%= company.b2bCompanyId %>/credit"><%= t('b2b:credit') %></a> &rsaquo; <%= t('shared:common.transactions') %>
      </div>
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">
    <%- include('../../partials/alerts') %>

    <!-- Balance Summary -->
    <div class="card mb-3">
      <div class="card-body">
        <div class="row">
          <div class="col-auto">
            <span class="text-muted"><%= t('b2b:currentBalanceUsedLabel') %></span>
            <strong class="ms-2"><%= (balance || 0).toFixed(2) %></strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Transactions Table -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= t('b2b:transactionHistory') %></h3>
        <span class="float-end text-muted"><%= (transactions || []).length %> <%= t('shared:common.records') %></span>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th><%= t('shared:common.type') %></th>
              <th><%= t('shared:common.amount') %></th>
              <th><%= t('shared:common.reference') %></th>
              <th><%= t('shared:common.notes') %></th>
              <th><%= t('shared:common.date') %></th>
            </tr>
          </thead>
          <tbody>
            <% (transactions || []).forEach(function(t) { %>
            <tr>
              <td><code><%= t.b2bCompanyCreditTransactionId.substring(0, 8) %>...</code></td>
              <td><span class="badge bg-info"><%= t.type %></span></td>
              <td>
                <span class="<%= t.amount > 0 ? 'text-danger' : 'text-success' %>">
                  <%= t.amount > 0 ? '+' : '' %><%= (t.amount || 0).toFixed(2) %>
                </span>
              </td>
              <td><%= t.referenceId || '-' %></td>
              <td><%= t.notes || '-' %></td>
              <td><%= new Date(t.createdAt).toLocaleString() %></td>
            </tr>
            <% }); %>
            <% if ((transactions || []).length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-4"><%= t('shared:common.noTransactionsFound') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
