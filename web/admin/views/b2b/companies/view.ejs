<%- include('../../partials/header', { pageName, title: pageName }) %>
<%- include('../../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <div>
    <a href="/admin/b2b/companies/<%= company.companyId %>/edit" class="btn btn-warning btn-sm">Edit</a>
    <a href="/admin/b2b/companies" class="btn btn-secondary btn-sm">Back</a>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm">
      <tr><th>Company ID</th><td><code><%= company.companyId %></code></td></tr>
      <tr><th>Name</th><td><%= company.name %></td></tr>
      <tr><th>Legal Name</th><td><%= company.legalName || '-' %></td></tr>
      <tr><th>Tax ID</th><td><%= company.taxId || '-' %></td></tr>
      <tr><th>Status</th><td>
        <% if (company.status === 'approved') { %><span class="badge bg-success"><%= company.status %></span>
        <% } else if (company.status === 'pending') { %><span class="badge bg-warning"><%= company.status %></span>
        <% } else { %><span class="badge bg-danger"><%= company.status %></span><% } %>
      </td></tr>
      <tr><th>Payment Terms</th><td><%= company.paymentTerms %></td></tr>
      <tr><th>Credit Limit</th><td><%= company.creditLimitCents != null ? '$' + (company.creditLimitCents/100).toFixed(2) : '-' %></td></tr>
      <tr><th>Outstanding Balance</th><td>$<%= (company.outstandingBalanceCents/100).toFixed(2) %></td></tr>
      <tr><th>Contact Email</th><td><%= company.contactEmail || '-' %></td></tr>
      <tr><th>Contact Phone</th><td><%= company.contactPhone || '-' %></td></tr>
      <tr><th>Website</th><td><%= company.website || '-' %></td></tr>
      <tr><th>Created</th><td><%= new Date(company.createdAt).toLocaleString() %></td></tr>
      <tr><th>Updated</th><td><%= new Date(company.updatedAt).toLocaleString() %></td></tr>
    </table>

    <div class="mt-3">
      <% if (company.status === 'pending') { %>
      <form method="POST" action="/admin/b2b/companies/<%= company.companyId %>/approve" class="d-inline">
        <button type="submit" class="btn btn-success btn-sm">Approve</button>
      </form>
      <% } %>
      <% if (company.status === 'approved') { %>
      <form method="POST" action="/admin/b2b/companies/<%= company.companyId %>/suspend" class="d-inline">
        <button type="submit" class="btn btn-danger btn-sm">Suspend</button>
      </form>
      <% } %>
      <% if (company.status === 'suspended') { %>
      <form method="POST" action="/admin/b2b/companies/<%= company.companyId %>/reactivate" class="d-inline">
        <button type="submit" class="btn btn-success btn-sm">Reactivate</button>
      </form>
      <% } %>
    </div>
  </div>
</div>

<% if (subsidiaries && subsidiaries.length > 0) { %>
<h5>Subsidiaries</h5>
<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-sm table-striped">
      <thead><tr><th>Name</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% subsidiaries.forEach(function(s) { %>
        <tr>
          <td><a href="/admin/b2b/companies/<%= s.companyId %>"><%= s.name %></a></td>
          <td><%= s.status %></td>
          <td><a href="/admin/b2b/companies/<%= s.companyId %>" class="btn btn-info btn-sm">View</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('../../partials/footer') %>
