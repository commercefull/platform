<%- include('../partials/header', { pageName, title: pageName }) %>
<%- include('../partials/alerts') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><%= pageName %></h2>
  <a href="/admin/b2b/companies/create" class="btn btn-primary btn-sm">Create Company</a>
</div>

<div class="card">
  <div class="card-body table-responsive">
    <table class="table table-striped table-sm">
      <thead>
        <tr>
          <th>Name</th>
          <th>Status</th>
          <th>Payment Terms</th>
          <th>Credit Limit</th>
          <th>Outstanding</th>
          <th>Contact</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% companies.forEach(function(c) { %>
        <tr>
          <td><a href="/admin/b2b/companies/<%= c.companyId %>"><%= c.name %></a></td>
          <td>
            <% if (c.status === 'approved') { %><span class="badge bg-success"><%= c.status %></span>
            <% } else if (c.status === 'pending') { %><span class="badge bg-warning"><%= c.status %></span>
            <% } else if (c.status === 'suspended') { %><span class="badge bg-danger"><%= c.status %></span>
            <% } else { %><span class="badge bg-secondary"><%= c.status %></span><% } %>
          </td>
          <td><%= c.paymentTerms %></td>
          <td><%= c.creditLimitCents != null ? '$' + (c.creditLimitCents/100).toFixed(2) : '-' %></td>
          <td>$<%= (c.outstandingBalanceCents/100).toFixed(2) %></td>
          <td><%= c.contactEmail || '-' %></td>
          <td>
            <a href="/admin/b2b/companies/<%= c.companyId %>" class="btn btn-info btn-sm">View</a>
            <a href="/admin/b2b/companies/<%= c.companyId %>/edit" class="btn btn-warning btn-sm">Edit</a>
          </td>
        </tr>
        <% }); %>
        <% if (!companies || companies.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted">No companies found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
