{
  "$schema": "./node_modules/knip/schema.json",
  "exclude": ["nsExports", "nsTypes"],
  "entry": [
    "boot/**/*.ts",
    "modules/*/interface/routers/**/*.ts",
    "modules/*/application/wired.ts",
    "modules/*/infrastructure/repositories/*DataRepository.ts",
    "modules/*/infrastructure/repositories/*Repository.ts",
    "web/**/*.ts"
  ],
  "project": ["modules/**/*.ts", "libs/**/*.ts", "boot/**/*.ts", "web/**/*.ts"],
  "ignore": [
    "typedoc.json",
    "modules/*/index.ts",
    "modules/*/application/useCases/index.ts",
    "modules/*/application/useCases/*/index.ts",
    "modules/*/infrastructure/index.ts",
    "modules/*/infrastructure/repositories/index.ts",
    "modules/*/infrastructure/services/**",
    "modules/*/domain/events/**",
    "modules/*/domain/repositories/**",
    "modules/*/domain/entities/**",
    "modules/*/domain/valueObjects/**",
    "modules/*/domain/*.ts",
    "modules/*/utils/**",
    "modules/analytics/**",
    "modules/audit/**",
    "modules/automation/**",
    "modules/b2b/**",
    "modules/fulfillment/**",
    "modules/gdpr/**",
    "libs/rules/index.ts",
    "libs/db/queryHelpers.ts"
  ],
  "ignoreDependencies": ["ejs", "stripe", "@types/ejs", "@types/nodemailer", "@types/sharp", "@typescript/native"],
  "ignoreBinaries": ["pm2", "audit", "k6"],
  "ignoreIssues": {
    "libs/db/types.ts": ["exports", "types", "enumMembers"],
    "infra/aws/**": ["unlisted"],
    "modules/product/infrastructure/repositories/productRepo.ts": ["enumMembers"],
    "libs/errors.ts": ["exports"],
    "libs/roles.ts": ["exports", "types"],
    "libs/search/types.ts": ["exports", "types"],
    "libs/session/SessionService.ts": ["exports", "types"],
    "libs/rules/rounding.ts": ["exports"],
    "libs/rules/index.ts": ["exports", "types"],
    "libs/db/index.ts": ["exports", "types"],
    "libs/events/eventBus.ts": ["exports", "types"],
    "libs/jobs/cronScheduler.ts": ["exports", "types"],
    "libs/logger.ts": ["exports", "types"],
    "libs/moduleRegistry/**": ["exports", "types"],
    "modules/*/domain/events/**": ["exports", "types"],
    "modules/*/domain/errors/**": ["exports", "types"],
    "modules/*/domain/services/**": ["exports", "types"],
    "modules/*/infrastructure/repositories/*Repo.ts": ["exports", "types"],
    "modules/*/infrastructure/repositories/*Repository.ts": ["exports", "types"],
    "modules/*/infrastructure/index.ts": ["exports", "types"],
    "modules/*/application/useCases/index.ts": ["exports", "types"],
    "modules/*/application/useCases/wired.ts": ["exports", "types"],
    "modules/*/application/useCases/*.ts": ["exports", "types"],
    "modules/*/application/useCases/**/*.ts": ["exports", "types"],
    "modules/*/application/services/index.ts": ["exports", "types"],
    "modules/*/application/services/**": ["exports", "types"],
    "modules/*/application/pricingService.ts": ["exports", "types"],
    "modules/*/application/ports/**": ["exports", "types"],
    "modules/*/interface/controllers/**": ["exports"],
    "modules/*/taxTypes.ts": ["exports", "types"],
    "modules/*/index.ts": ["exports", "types", "unlisted"]
  }
}
