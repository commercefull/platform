{
  "name": "commercefull",
  "version": "1.2.2",
  "main": "app.mjs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development nodemon app.ts",
    "prd": "yarn prd:build && yarn prd:run",
    "prd:run": "NODE_ENV=production node --env-file=.env --watch ./app.mjs",
    "prd:run:docker": "NODE_ENV=production node ./app.mjs",
    "prd:run:pm2": "NODE_ENV=production pm2 start -i max node --env-file=.env --name commercefull -- ./app.mjs",
    "prd:build": "yarn css:build && yarn storefront:build && npx esbuild app.ts --bundle --minify --platform=node --target=es2022 --format=esm --outfile=app.mjs --external:./node_modules/* --banner:js='import { createRequire as topLevelCreateRequire } from \"module\"; const require = topLevelCreateRequire(import.meta.url);'",
    "db": "docker run --rm -d -P -p 127.0.0.1:5433:5432 --env-file ./.env --name commerce-db postgres:18-alpine -c shared_preload_libraries=pg_stat_statements -c pg_stat_statements.track=all",
    "db:stop": "docker stop commerce-db",
    "db:migrate": "knex migrate:latest --env ${NODE_ENV:-development}",
    "db:migrate:new": "knex migrate:make",
    "db:rollback": "knex migrate:rollback --env ${NODE_ENV:-development}",
    "db:rollback:all": "knex migrate:rollback --all --env ${NODE_ENV:-development}",
    "db:seed": "knex seed:run --env ${NODE_ENV:-development}",
    "db:types": "tsx scripts/generate-knex-types.ts",
    "db:migrate:smoke": "node scripts/migration-smoke-test.js",
    "db:migrate:smoke:seeded": "node scripts/migration-smoke-test.js --seeded",
    "db:migrate:validate": "tsx scripts/validate-migrations.ts",
    "test": "jest --selectProjects unit --detectOpenHandles",
    "test:unit": "jest --selectProjects unit --detectOpenHandles",
    "test:storefront": "jest --selectProjects storefront --detectOpenHandles",
    "test:int": "jest --selectProjects integration --runInBand --detectOpenHandles --forceExit",
    "test:all": "yarn test:unit && yarn test:storefront && yarn test:int",
    "lint": "node_modules/@typescript/native/bin/tsc --noEmit && eslint . --ext .ts,.js && dependency-cruiser .",
    "lint:errors": "eslint . --ext .ts,.js --quiet",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,css,scss}\"",
    "package:upgrade": "yarn upgrade --latest",
    "code:lint": "knip",
    "deps:check": "dependency-cruiser .",
    "deps:graph": "dependency-cruiser . --output-type dot -f deps-graph.dot",
    "locale:clean:dry": "node scripts/clean-locales.js",
    "locale:clean": "node scripts/clean-locales.js --write",
    "sec:audit": "yarn audit --groups dependencies",
    "sec:check": "yarn audit --groups dependencies --level high",
    "css:build": "npx @tailwindcss/cli -i ./public/stylesheets/storefront/main.css -o ./public/stylesheets/storefront/compiled.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./public/stylesheets/storefront/main.css -o ./public/stylesheets/storefront/compiled.css --watch",
    "storefront:build": "npx esbuild public/javascripts/storefront/main.js --bundle --minify --format=esm --target=es2022 --outfile=public/javascripts/storefront/bundle.min.js --sourcemap",
    "storefront:watch": "npx esbuild public/javascripts/storefront/main.js --bundle --format=esm --target=es2022 --outfile=public/javascripts/storefront/bundle.min.js --watch",
    "job:new:organization": "NODE_ENV=development node --env-file=.env --import tsx ./modules/organization/interface/jobs/new-organization.ts",
    "job:new:admin": "NODE_ENV=development node --env-file=.env --import tsx ./modules/identity/interface/jobs/new-admin.ts",
    "docs:env": "tsx scripts/docs/generate-env-docs.ts",
    "docs:routes": "tsx scripts/docs/generate-route-docs.ts",
    "docs:openapi": "tsx scripts/docs/generate-openapi.ts",
    "docs:db": "tsx scripts/docs/generate-db-docs.ts",
    "docs:code": "typedoc",
    "docs:sidebar": "tsx scripts/docs/generate-sidebar.ts",
    "docs:generate": "yarn docs:env && yarn docs:routes && yarn docs:openapi && yarn docs:sidebar",
    "docs:generate:full": "yarn docs:env && yarn docs:routes && yarn docs:openapi && yarn docs:db && yarn docs:code && yarn docs:sidebar",
    "docs:check": "yarn docs:generate && git diff --exit-code -- docs/",
    "docs:serve": "npx docsify-cli serve docs --port 4000",
    "perf:smoke": "k6 run tests/performance/smoke.js",
    "perf:load:browse": "k6 run tests/performance/load-product-browse.js",
    "perf:load:basket": "k6 run tests/performance/load-basket.js",
    "perf:load:auth": "k6 run tests/performance/load-auth.js",
    "perf:load:checkout": "k6 run tests/performance/load-checkout.js",
    "perf:load:merchant": "k6 run tests/performance/load-merchant.js",
    "perf:load:order": "k6 run tests/performance/load-order-complete.js",
    "perf:load:coupon": "k6 run tests/performance/load-coupon.js",
    "perf:load:storefront": "k6 run tests/performance/load-storefront.js",
    "perf:load": "yarn perf:load:browse && yarn perf:load:basket && yarn perf:load:auth && yarn perf:load:checkout && yarn perf:load:merchant && yarn perf:load:order && yarn perf:load:coupon && yarn perf:load:storefront",
    "perf:stress": "k6 run tests/performance/stress.js",
    "perf:spike": "k6 run tests/performance/spike.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@graphql-tools/merge": "^9.2.4",
    "@graphql-tools/schema": "^10.1.1",
    "bcryptjs": "3.0.3",
    "body-parser": "2.3.0",
    "compression": "1.8.2",
    "connect-flash": "0.1.1",
    "connect-pg-simple": "10.0.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "express-validator": "7.3.2",
    "express-winston": "^4.2.0",
    "form-data": "^4.0.6",
    "graphql": "^17.0.2",
    "graphql-depth-limit": "^1.1.0",
    "helmet": "8.3.0",
    "hpp": "^0.2.3",
    "i18next": "26.4.2",
    "i18next-fs-backend": "2.6.8",
    "i18next-http-middleware": "3.9.9",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.3.0",
    "passport": "0.7.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "stripe": "22.6.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/cli": "^4.3.3",
    "@types/body-parser": "1.19.6",
    "@types/compression": "1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.17",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/hpp": "^0.2.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.1",
    "@types/passport": "1.0.17",
    "@types/pg": "8.23.1",
    "@types/sharp": "^0.32.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "autoprefixer": "^10.6.0",
    "axios": "1.20.0",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "30.5.1",
    "knex": "^3.3.0",
    "knex-types": "0.5.0",
    "knip": "6.35.1",
    "nodemon": "3.1.14",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "4.23.13",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "resolutions": {
    "qs": "^6.16.0"
  }
}
