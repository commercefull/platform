# Development Environment Configuration
# Copy this file to .env and configure with your local values

# ============================================================================
# Core Application
# ============================================================================
PORT=3000
SERVERLESS=0
NODE_ENV=development

# Default organization ID (used by admin controllers as fallback)
DEFAULT_ORGANIZATION_ID=01911000-0000-7000-8000-000000000001

# Default storefront store slug (multi-store: 'us' or 'uk')
DEFAULT_STORE_SLUG=us

# Logging level (error | warn | info | debug)
LOG_LEVEL=debug

# ============================================================================
# Required Secrets — ephemeral dev secrets are auto-generated if missing,
# but explicit values make sessions stable across restarts.
# ============================================================================
CUSTOMER_JWT_SECRET=generate-a-secure-random-string-at-least-32-chars-long
ORGANIZATION_JWT_SECRET=generate-a-secure-random-string-at-least-32-chars-long
ADMIN_JWT_SECRET=generate-a-secure-random-string-at-least-32-chars-long
B2B_JWT_SECRET=generate-a-secure-random-string-at-least-32-chars-long
SESSION_SECRET=bb90e8b58596c55070ee88b25ff01627ab0c227cd11d6f876af9e81a0cd12e9d8a1ebce3af5b0fd8098ac3946a590c55ebe890066db6403cb0ee324c6edf9f3d

# JWT token expiry
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Payment webhook signature verification
PAYMENT_WEBHOOK_SECRET=test-secret-key

# SCIM API bearer token (for SSO/identity provisioning)
SCIM_BEARER_TOKEN=generate-a-secure-random-string-for-scim-api

# Integration encryption key (for storing third-party API keys encrypted in DB)
INTEGRATION_ENCRYPTION_KEY=generate-32-byte-encryption-key

# ============================================================================
# Database (PostgreSQL 18)
# ============================================================================
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=ecomm-user
POSTGRES_PASSWORD=ecomm-password
POSTGRES_DB=ecomm-db

# Alternative: single connection URL
DATABASE_URL=postgres://ecomm-user:ecomm-password@127.0.0.1:5432/ecomm-db

# ============================================================================
# CORS and Cookies
# ============================================================================
ALLOWED_ORIGINS=https://yourdomain.com
COOKIE_SECRET=
COOKIE_DOMAIN=

# ============================================================================
# File Storage
# ============================================================================
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=uploads
STORAGE_LOCAL_URL=http://127.0.0.1:3000/uploads

# ============================================================================
# Redis (optional — if set, Redis is used for sessions instead of PostgreSQL)
# ============================================================================
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_SESSION_PREFIX=sess:

# ============================================================================
# Optional: GraphQL Configuration
# ============================================================================
# GRAPHQL_MAX_DEPTH=10
# GRAPHQL_MAX_COMPLEXITY=1000
# GRAPHQL_PERSISTED_QUERIES=false

# ============================================================================
# Optional: Feature Flags
# ============================================================================
# MODULE_INDEPENDENT_ENABLED=true
# MODULE_MARKETPLACE_ENABLED=false

# ============================================================================
# Optional: Search Backend
# ============================================================================
# SEARCH_BACKEND=postgres
# SEARCH_STRATEGY=trigram

# ============================================================================
# Optional: SSO / OAuth Providers
# ============================================================================
# GOOGLE_CLIENT_ID=your_google_client_id
# GITHUB_CLIENT_ID=your_github_client_id
# MICROSOFT_CLIENT_ID=your_microsoft_client_id
# APPLE_CLIENT_ID=your_apple_client_id
# FACEBOOK_APP_ID=your_facebook_app_id
# TWITTER_CLIENT_ID=your_twitter_client_id
# LINKEDIN_CLIENT_ID=your_linkedin_client_id

# ============================================================================
# Optional: Background Jobs
# ============================================================================
# OUTBOX_DISABLED=0
# CRON_DISABLED=0
